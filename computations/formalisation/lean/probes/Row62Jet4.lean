/-! ### the Ricci entry as a sum of blocks -/

theorem Ric_split_0 (b c : Fin 3) :
    Ric F h 0 b c = (∑ a, (RDf F h 0 a b c + (RQ F h 0 0 a b c))) - RCf F h 0 b c := by
  simp only [Ric, Rm, RDf, RQ, RCf, Finset.sum_range_succ, Finset.sum_range_zero, Fin.sum_univ_three, Nat.reduceSub, Nat.reduceAdd] <;> ring

theorem Ric_split_1 (b c : Fin 3) :
    Ric F h 1 b c = (∑ a, (RDf F h 1 a b c + (RQ F h 0 1 a b c + RQ F h 1 0 a b c))) - RCf F h 1 b c := by
  simp only [Ric, Rm, RDf, RQ, RCf, Finset.sum_range_succ, Finset.sum_range_zero, Fin.sum_univ_three, Nat.reduceSub, Nat.reduceAdd] <;> ring

theorem Ric_split_2 (b c : Fin 3) :
    Ric F h 2 b c = (∑ a, (RDf F h 2 a b c + (RQ F h 0 2 a b c + RQ F h 1 1 a b c + RQ F h 2 0 a b c))) - RCf F h 2 b c := by
  simp only [Ric, Rm, RDf, RQ, RCf, Finset.sum_range_succ, Finset.sum_range_zero, Fin.sum_univ_three, Nat.reduceSub, Nat.reduceAdd] <;> ring

theorem Ric_split_3 (b c : Fin 3) :
    Ric F h 3 b c = (∑ a, (RDf F h 3 a b c + (RQ F h 0 3 a b c + RQ F h 1 2 a b c + RQ F h 2 1 a b c + RQ F h 3 0 a b c))) - RCf F h 3 b c := by
  simp only [Ric, Rm, RDf, RQ, RCf, Finset.sum_range_succ, Finset.sum_range_zero, Fin.sum_univ_three, Nat.reduceSub, Nat.reduceAdd] <;> ring

theorem Ric_split_4 (b c : Fin 3) :
    Ric F h 4 b c = (∑ a, (RDf F h 4 a b c + (RQ F h 0 4 a b c + RQ F h 1 3 a b c + RQ F h 2 2 a b c + RQ F h 3 1 a b c + RQ F h 4 0 a b c))) - RCf F h 4 b c := by
  simp only [Ric, Rm, RDf, RQ, RCf, Finset.sum_range_succ, Finset.sum_range_zero, Fin.sum_univ_three, Nat.reduceSub, Nat.reduceAdd] <;> ring

theorem RDf_diag (k : ℕ) (a c : Fin 3) : RDf F h k a a c = 0 := sub_self _
theorem RQ_diag (i j : ℕ) (a c : Fin 3) : RQ F h i j a a c = 0 := Finset.sum_eq_zero fun _ _ => sub_self _

