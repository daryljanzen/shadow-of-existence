open Real

namespace ShadowProbe.GroupoidProbe

/-! ## The construction -/

section GpAct

variable {A : Type*} [AddCommGroup A] {n : ℕ}

/-- The underlying map of the action. -/
def gp_fun (e : ZMod n →+ A) (d : A) : DihedralGroup n → Equiv.Perm A
  | .r i => Equiv.addRight (e i)
  | .sr i => (Equiv.neg A).trans (Equiv.addRight (d - e i))

/-- **The dihedral action** `r i ↦ (w ↦ w + e i)`, `sr i ↦ (w ↦ −w + (d − e i))`. -/
def gp_act (e : ZMod n →+ A) (d : A) : DihedralGroup n →* Equiv.Perm A where
  toFun := gp_fun e d
  map_one' := by
    show gp_fun e d (.r 0) = 1
    ext x; simp [gp_fun]
  map_mul' := by
    rintro (i | i) (j | j) <;> ext x <;>
      simp [gp_fun, DihedralGroup.r_mul_r, DihedralGroup.r_mul_sr, DihedralGroup.sr_mul_r,
        DihedralGroup.sr_mul_sr, map_add, map_sub] <;> abel

@[simp] lemma gp_act_r (e : ZMod n →+ A) (d : A) (i : ZMod n) (x : A) :
    gp_act e d (.r i) x = x + e i := rfl

@[simp] lemma gp_act_sr (e : ZMod n →+ A) (d : A) (i : ZMod n) (x : A) :
    gp_act e d (.sr i) x = -x + (d - e i) := rfl

/-- The action is faithful when `e` is injective at `0` and some `a` has `a + a ≠ 0`. -/
theorem gp_act_injective (e : ZMod n →+ A) (d : A) (he : ∀ i, e i = 0 → i = 0) {a : A} (ha : a + a ≠ 0) :
    Function.Injective (gp_act e d) := by
  rw [injective_iff_map_eq_one]
  rintro (i | i) h
  · have := congrArg (fun f : Equiv.Perm A => f 0) h
    simp at this
    rw [he i this]; rfl
  · have h0 := congrArg (fun f : Equiv.Perm A => f 0) h
    have h1 := congrArg (fun f : Equiv.Perm A => f a) h
    simp only [gp_act_sr, Equiv.Perm.coe_one, id_eq, neg_zero, zero_add] at h0 h1
    rw [h0, add_zero] at h1
    exact (ha (neg_eq_iff_add_eq_zero.1 h1)).elim

/-- `DihedralGroup n` is generated by `r 1` and `sr 0`. -/
lemma gp_closure_top [NeZero n] :
    Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} : Set (DihedralGroup n)) = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  have h1 : DihedralGroup.r (1 : ZMod n) ∈ Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} :
      Set (DihedralGroup n)) := Subgroup.subset_closure (by simp)
  have h0 : DihedralGroup.sr (0 : ZMod n) ∈ Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} :
      Set (DihedralGroup n)) := Subgroup.subset_closure (by simp)
  have hr : ∀ i : ZMod n, DihedralGroup.r i ∈ Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} :
      Set (DihedralGroup n)) := fun i => by
    have := Subgroup.pow_mem _ h1 i.val
    rwa [DihedralGroup.r_one_pow, ZMod.natCast_zmod_val] at this
  rcases x with i | i
  · exact hr i
  · have := Subgroup.mul_mem _ h0 (hr i)
    rwa [DihedralGroup.sr_mul_r, zero_add] at this

/-- The range of the action is the closure of the images of a generating set. -/
lemma gp_act_range (e : ZMod n →+ A) (d : A) {S : Set (DihedralGroup n)} (hS : Subgroup.closure S = ⊤) :
    (gp_act e d).range = Subgroup.closure (gp_act e d '' S) := by
  rw [MonoidHom.range_eq_map, ← hS, MonoidHom.map_closure]

end GpAct

/-! ## The sky-angle circle -/

instance gp_fact : Fact (0 < 2 * π) := ⟨by positivity⟩

/-- The sky-angle circle `ℝ/2πℤ`. -/
abbrev gp_T := AddCircle (2 * π)

lemma gp_coe_ne_zero {x : ℝ} (h0 : 0 < x) (h1 : x < 2 * π) : (x : gp_T) ≠ 0 := by
  intro h
  rw [AddCircle.coe_eq_zero_iff] at h
  obtain ⟨m, hm⟩ := h
  rw [zsmul_eq_mul] at hm
  have hπ := Real.pi_pos
  have a : (0 : ℤ) < m := by
    have : (0 : ℝ) < m := by nlinarith
    exact_mod_cast this
  have b : m < 1 := by
    have : (m : ℝ) < 1 := by nlinarith
    exact_mod_cast this
  omega

/-- The step map `ZMod n →+ ℝ/2πℤ`, `i ↦ i·c`, for `n c = 2π`. -/
noncomputable def gp_e (n : ℕ) (c : ℝ) (hc : (n : ℝ) * c = 2 * π) : ZMod n →+ gp_T :=
  ZMod.lift n ⟨zmultiplesHom gp_T (c : gp_T), by
    rw [zmultiplesHom_apply, ← AddCircle.coe_zsmul, zsmul_eq_mul]; push_cast; rw [hc]
    exact AddCircle.coe_period (p := 2 * π)⟩

lemma gp_e_one {n : ℕ} {c : ℝ} (hc : (n : ℝ) * c = 2 * π) : gp_e n c hc 1 = (c : gp_T) := by
  have := ZMod.lift_coe (n := n) ⟨zmultiplesHom gp_T (c : gp_T), by
    rw [zmultiplesHom_apply, ← AddCircle.coe_zsmul, zsmul_eq_mul]; push_cast; rw [hc]
    exact AddCircle.coe_period (p := 2 * π)⟩ 1
  unfold gp_e; simpa using this

lemma gp_e_apply {n : ℕ} [NeZero n] {c : ℝ} (hc : (n : ℝ) * c = 2 * π) (i : ZMod n) :
    gp_e n c hc i = (((i.val : ℝ) * c : ℝ) : gp_T) := by
  conv_lhs => rw [← ZMod.natCast_zmod_val i, ← nsmul_one, map_nsmul, gp_e_one]
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]

lemma gp_c3 : ((3 : ℕ) : ℝ) * (2 * π / 3) = 2 * π := by push_cast; ring
lemma gp_c6 : ((6 : ℕ) : ℝ) * (π / 3) = 2 * π := by push_cast; ring

/-- The `D₃` action on the sky angle: `e i = i·(2π/3)`, `d = π/3`. -/
noncomputable def gp_φ : DihedralGroup 3 →* Equiv.Perm gp_T := gp_act (gp_e 3 _ gp_c3) ((π / 3 : ℝ) : gp_T)

/-- **The involution** `σ : w ↦ π/3 − w`. -/
noncomputable def gp_σ : Equiv.Perm gp_T := (Equiv.neg gp_T).trans (Equiv.addRight ((π / 3 : ℝ) : gp_T))
/-- **The sky-angle periodicity** `τ : w ↦ w + 2π/3`. -/
noncomputable def gp_τ : Equiv.Perm gp_T := Equiv.addRight ((2 * π / 3 : ℝ) : gp_T)

@[simp] lemma gp_σ_apply (w : gp_T) : gp_σ w = -w + ((π / 3 : ℝ) : gp_T) := rfl
@[simp] lemma gp_τ_apply (w : gp_T) : gp_τ w = w + ((2 * π / 3 : ℝ) : gp_T) := rfl

lemma gp_φ_sr0 : gp_φ (.sr 0) = gp_σ := by
  ext w; simp [gp_φ, gp_e_apply]
lemma gp_φ_r1 : gp_φ (.r 1) = gp_τ := by
  ext w; simp [gp_φ, gp_e_one]

lemma gp_e3_ne (i : ZMod 3) (h : gp_e 3 _ gp_c3 i = 0) : i = 0 := by
  have hπ := Real.pi_pos
  fin_cases i
  · rfl
  · change gp_e 3 _ gp_c3 1 = 0 at h
    rw [gp_e_one] at h
    exact absurd h (gp_coe_ne_zero (by positivity) (by linarith))
  · change gp_e 3 _ gp_c3 (1 + 1) = 0 at h
    rw [map_add, gp_e_one, ← AddCircle.coe_add] at h
    exact absurd h (gp_coe_ne_zero (by positivity) (by linarith))

lemma gp_half_ne : ((π / 2 : ℝ) : gp_T) + ((π / 2 : ℝ) : gp_T) ≠ 0 := by
  rw [← AddCircle.coe_add]
  exact gp_coe_ne_zero (by positivity) (by nlinarith [Real.pi_pos])

lemma gp_φ_injective : Function.Injective gp_φ :=
  gp_act_injective _ _ gp_e3_ne gp_half_ne

/-- **Row 2a.** `σ² = 1` and `σ ≠ 1`. -/
theorem gp_σ_sq : gp_σ ^ 2 = 1 ∧ gp_σ ≠ 1 := by
  refine ⟨by ext w; simp [sq], fun h => ?_⟩
  rw [← gp_φ_sr0, ← map_one gp_φ] at h
  exact absurd (gp_φ_injective h) (by decide)

/-- **Row 3.** `τ` has order exactly 3 on `ℝ/2πℤ`. -/
theorem gp_τ_order : orderOf gp_τ = 3 := by
  rw [← gp_φ_r1, orderOf_injective gp_φ gp_φ_injective]
  exact (DihedralGroup.orderOf_r_one (n := 3))

/-- **Row 3, the caveat.** On `ℝ/(2π/3)ℤ` the same translation is the identity. -/
theorem gp_τ_short : Equiv.addRight (((2 * π / 3 : ℝ)) : AddCircle (2 * π / 3)) = 1 := by
  ext w; simp [AddCircle.coe_period]

/-- **Row 4, the relations.** `σ² = τ³ = (στ)² = 1`. -/
theorem gp_relations : gp_σ ^ 2 = 1 ∧ gp_τ ^ 3 = 1 ∧ (gp_σ * gp_τ) ^ 2 = 1 := by
  refine ⟨gp_σ_sq.1, ?_, ?_⟩
  · rw [← gp_τ_order]; exact pow_orderOf_eq_one _
  · rw [← gp_φ_sr0, ← gp_φ_r1, ← map_mul, ← map_pow]
    rw [show (DihedralGroup.sr 0 * DihedralGroup.r 1 : DihedralGroup 3) ^ 2 = 1 by decide, map_one]

lemma gp_φ_range : gp_φ.range = Subgroup.closure {gp_σ, gp_τ} := by
  unfold gp_φ
  rw [gp_act_range _ _ gp_closure_top]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rw [← gp_φ, gp_φ_r1, gp_φ_sr0, Set.pair_comm]

/-- **Row 4.** `⟨σ, τ⟩ ≃* D₃`. -/
noncomputable def gp_D3 : Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T)) ≃* DihedralGroup 3 :=
  (MulEquiv.subgroupCongr gp_φ_range.symm).trans (MonoidHom.ofInjective gp_φ_injective).symm

/-- **Row 4.** `⟨σ, τ⟩` has order 6. -/
theorem gp_D3_card : Nat.card (Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T))) = 6 := by
  rw [Nat.card_congr gp_D3.toEquiv, DihedralGroup.nat_card]

/-! ## The roots and their permutation -/

/-- The label action, a push-forward: `r i ↦ (k ↦ k − i)`, `sr i ↦ (k ↦ −k + 1 + i)`. -/
def gp_ψ : DihedralGroup 3 →* Equiv.Perm (ZMod 3) := gp_act (-AddMonoidHom.id (ZMod 3)) 1

lemma gp_ψ_injective : Function.Injective gp_ψ :=
  gp_act_injective _ _ (fun i h => by simpa using h) (a := 1) (by decide)

/-- **Row 4.** `D₃ ≃* S₃`, through the permutation of the three root labels. -/
noncomputable def gp_S3 : DihedralGroup 3 ≃* Equiv.Perm (ZMod 3) :=
  MulEquiv.ofBijective gp_ψ ((Fintype.bijective_iff_injective_and_card _).2
    ⟨gp_ψ_injective, by rw [Fintype.card_perm, DihedralGroup.card]; rfl⟩)

/-- The roots `rₖ(w) = (2/√3) sin(w + 2πk/3)`. -/
noncomputable def gp_root (w : ℝ) (k : ZMod 3) : ℝ := 2 / Real.sqrt 3 * Real.sin (w + k.val * (2 * π / 3))

/-- The lift of the action to `ℝ`. -/
noncomputable def gp_lift : DihedralGroup 3 → ℝ → ℝ
  | .r i, w => w + i.val * (2 * π / 3)
  | .sr i, w => -w + (π / 3 - i.val * (2 * π / 3))

lemma gp_lift_coe (g : DihedralGroup 3) (w : ℝ) : ((gp_lift g w : ℝ) : gp_T) = gp_φ g (w : gp_T) := by
  rcases g with i | i <;> simp [gp_lift, gp_φ, gp_e_apply]

lemma gp_s3 : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)

/-- **Row 2c.** Each `rₖ(w)` solves the horizon cubic `r³ − r + 2M = 0` with `2M = (2/3√3) sin 3w`. -/
theorem gp_root_cubic (w : ℝ) (k : ZMod 3) :
    gp_root w k ^ 3 - gp_root w k + 2 / (3 * Real.sqrt 3) * Real.sin (3 * w) = 0 := by
  have h3 : Real.sin (3 * w) = Real.sin (3 * (w + k.val * (2 * π / 3))) := by
    rw [show 3 * (w + k.val * (2 * π / 3)) = 3 * w + (k.val : ℕ) * (2 * π) by ring]
    exact (Real.sin_add_nat_mul_two_pi _ _).symm
  have hs : 0 < Real.sqrt 3 := by positivity
  rw [h3, Real.sin_three_mul, gp_root]
  field_simp
  ring_nf; simp only [gp_s3]; ring

lemma gp_sin_per {a b : ℝ} (m : ℤ) (h : a = b + m * (2 * π)) : Real.sin a = Real.sin b := by
  rw [h, Real.sin_add_int_mul_two_pi]

lemma gp_sin_refl {a b : ℝ} (m : ℤ) (h : a = π - b + m * (2 * π)) : Real.sin a = Real.sin b := by
  rw [h, Real.sin_add_int_mul_two_pi, Real.sin_pi_sub]

/-- A label identity in `ZMod 3` lifts to its values up to a multiple of 3. -/
lemma gp_val_lift {x : ZMod 3} {y : ℤ} (h : (x : ZMod 3) = (y : ZMod 3)) :
    ∃ m : ℤ, (x.val : ℝ) = y + 3 * m := by
  have h0 : (((x.val : ℤ) - y : ℤ) : ZMod 3) = 0 := by
    push_cast; rw [ZMod.natCast_zmod_val, h, sub_self]
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h0
  obtain ⟨m, hm⟩ := h0
  refine ⟨m, ?_⟩
  have := congrArg (fun z : ℤ => (z : ℝ)) hm
  push_cast at this; linarith

lemma gp_ψ_r (i k : ZMod 3) : gp_ψ (.r i) k = k - i := by
  simp [gp_ψ, sub_eq_add_neg]

lemma gp_ψ_sr (i k : ZMod 3) : gp_ψ (.sr i) k = -k + (1 + i) := by
  simp [gp_ψ]

/-- **Row 2c.** The action permutes the roots: `r_{ψ(g)k}(g w) = rₖ(w)` for every `g ∈ D₃`. -/
theorem gp_root_perm (g : DihedralGroup 3) (w : ℝ) (k : ZMod 3) :
    gp_root (gp_lift g w) (gp_ψ g k) = gp_root w k := by
  unfold gp_root
  congr 1
  rcases g with i | i
  · obtain ⟨m, hm⟩ := gp_val_lift (x := k - i) (y := (k.val : ℤ) - i.val) (by
      push_cast; rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val])
    rw [gp_ψ_r]
    refine gp_sin_per m ?_
    simp only [gp_lift]; push_cast at hm; rw [hm]; ring
  · obtain ⟨m, hm⟩ := gp_val_lift (x := -k + (1 + i)) (y := -(k.val : ℤ) + (1 + i.val)) (by
      push_cast; rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val])
    rw [gp_ψ_sr]
    refine gp_sin_refl m ?_
    simp only [gp_lift]; push_cast at hm; rw [hm]; ring

/-- **Row 2c.** `σ` swaps labels 0 and 1 and fixes 2. -/
theorem gp_σ_roots : gp_ψ (.sr 0) 0 = 1 ∧ gp_ψ (.sr 0) 1 = 0 ∧ gp_ψ (.sr 0) 2 = 2 := by decide

/-- **Row 2c.** On `w ∈ (0, π/3)` the two roots `σ` swaps are positive. -/
theorem gp_roots_pos {w : ℝ} (h0 : 0 < w) (h1 : w < π / 3) : 0 < gp_root w 0 ∧ 0 < gp_root w 1 := by
  have hs : 0 < 2 / Real.sqrt 3 := by positivity
  have hπ := Real.pi_pos
  simp only [gp_root, show (0 : ZMod 3).val = 0 from rfl, show (1 : ZMod 3).val = 1 from rfl]
  push_cast
  refine ⟨mul_pos hs (Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)),
    mul_pos hs (Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith))⟩

/-! ## The fixed points of σ, and the Nariai mass -/

lemma gp_coe_add_int (y : ℝ) (j : ℤ) : ((y + j * (2 * π) : ℝ) : gp_T) = (y : gp_T) := by
  rw [AddCircle.coe_add, (AddCircle.coe_eq_zero_iff (p := 2 * π) (x := j * (2 * π))).2 ⟨j, by rw [zsmul_eq_mul]⟩, add_zero]

/-- **Row 7b.** On the full circle, `σ w = w` exactly at `π/6` and `7π/6`; there `r₀ = (2/√3) sin w` is
`1/√3` and `−1/√3`. -/
theorem gp_σ_fixed (w : gp_T) :
    (gp_σ w = w ↔ w = ((π / 6 : ℝ) : gp_T) ∨ w = ((7 * π / 6 : ℝ) : gp_T)) ∧
      2 / Real.sqrt 3 * Real.sin (π / 6) = 1 / Real.sqrt 3 ∧
      2 / Real.sqrt 3 * Real.sin (7 * π / 6) = -(1 / Real.sqrt 3) := by
  refine ⟨?_, ?_, ?_⟩
  · induction w using QuotientAddGroup.induction_on with | H x => ?_
    change -(x : gp_T) + ((π / 3 : ℝ) : gp_T) = x ↔ _
    constructor
    · intro h
      have h' : ((π / 3 - 2 * x : ℝ) : gp_T) = 0 := by
        rw [show π / 3 - 2 * x = (π / 3 - x) - x by ring, AddCircle.coe_sub, AddCircle.coe_sub]
        calc ((π / 3 : ℝ) : gp_T) - x - x = (-(x : gp_T) + ((π / 3 : ℝ) : gp_T)) - x := by abel
          _ = 0 := by rw [h, sub_self]
      rw [AddCircle.coe_eq_zero_iff] at h'
      obtain ⟨m, hm⟩ := h'
      rw [zsmul_eq_mul] at hm
      obtain ⟨j, rfl | rfl⟩ := Int.even_or_odd' m
      · left
        rw [show x = π / 6 + ((-j : ℤ) : ℝ) * (2 * π) by push_cast at hm ⊢; linarith, gp_coe_add_int]
      · right
        rw [show x = 7 * π / 6 + ((-j - 1 : ℤ) : ℝ) * (2 * π) by push_cast at hm ⊢; linarith, gp_coe_add_int]
    · rintro (h | h) <;> rw [h, ← AddCircle.coe_neg, ← AddCircle.coe_add]
      · congr 1; ring
      · rw [show -(7 * π / 6) + π / 3 = 7 * π / 6 + ((-1 : ℤ) : ℝ) * (2 * π) by push_cast; ring, gp_coe_add_int]
  · rw [Real.sin_pi_div_six]; ring
  · rw [show 7 * π / 6 = π / 6 + π by ring, Real.sin_add_pi, Real.sin_pi_div_six]; ring

/-- **Row 8.** At the Nariai vantage `w = π/6`: `2M = 2/(3√3)`; with the throat `α` restored, `M = α/(3√3)` and
`Λ = 3/α²` give `ΛM² = 1/9`. -/
theorem gp_nariai_mass {α : ℝ} (hα : α ≠ 0) :
    2 / (3 * Real.sqrt 3) * Real.sin (3 * (π / 6)) = 2 / (3 * Real.sqrt 3) ∧
      3 / α ^ 2 * (α / (3 * Real.sqrt 3)) ^ 2 = 1 / 9 := by
  refine ⟨by rw [show 3 * (π / 6) = π / 2 by ring, Real.sin_pi_div_two, mul_one], ?_⟩
  field_simp; rw [gp_s3]; ring

/-! ## `Aut(A₂)`: the reflection `R` and the order-12 group -/

/-- **The reflection** `R : w ↦ −w`. -/
noncomputable def gp_R : Equiv.Perm gp_T := Equiv.neg gp_T

@[simp] lemma gp_R_apply (w : gp_T) : gp_R w = -w := rfl

/-- **Row 13.** `R` sends `sin 3w ↦ −sin 3w`, so `2M ↦ −2M`; it swaps the Nariai vantages `±π/6`
(`2M = ±2/(3√3)`) and fixes `w = 0` (`2M = 0`). -/
theorem gp_R_mass (w : ℝ) :
    Real.sin (3 * -w) = -Real.sin (3 * w) ∧ gp_R ((π / 6 : ℝ) : gp_T) = ((-(π / 6) : ℝ) : gp_T) ∧
      gp_R ((-(π / 6) : ℝ) : gp_T) = ((π / 6 : ℝ) : gp_T) ∧ gp_R 0 = 0 ∧
      2 / (3 * Real.sqrt 3) * Real.sin (3 * -(π / 6)) = -(2 / (3 * Real.sqrt 3)) := by
  refine ⟨by rw [mul_neg, Real.sin_neg], by simp, by simp, by simp, ?_⟩
  rw [mul_neg, Real.sin_neg, show 3 * (π / 6) = π / 2 by ring, Real.sin_pi_div_two]; ring

/-- The `D₆` action on the sky angle: `e i = i·(π/3)`, `d = 0`. -/
noncomputable def gp_φ6 : DihedralGroup 6 →* Equiv.Perm gp_T := gp_act (gp_e 6 _ gp_c6) 0

lemma gp_φ6_r2 : gp_φ6 (.r 2) = gp_τ := by
  ext w
  change w + gp_e 6 _ gp_c6 (1 + 1) = _
  rw [map_add, gp_e_one, gp_τ_apply, ← AddCircle.coe_add]; congr 2; ring

lemma gp_φ6_sr0 : gp_φ6 (.sr 0) = gp_R := by
  ext w; simp [gp_φ6]

lemma gp_φ6_sr5 : gp_φ6 (.sr 5) = gp_σ := by
  ext w
  have h5 : gp_e 6 _ gp_c6 5 = ((5 * (π / 3) : ℝ) : gp_T) := by
    rw [gp_e_apply, show (5 : ZMod 6).val = 5 from rfl]; push_cast; ring_nf
  change -w + (0 - gp_e 6 _ gp_c6 5) = _
  rw [h5, gp_σ_apply, zero_sub, ← AddCircle.coe_neg,
    show -(5 * (π / 3)) = π / 3 + ((-1 : ℤ) : ℝ) * (2 * π) by push_cast; ring, gp_coe_add_int]

lemma gp_e6_ne (i : ZMod 6) (h : gp_e 6 _ gp_c6 i = 0) : i = 0 := by
  rw [gp_e_apply] at h
  have hπ := Real.pi_pos
  have hv := ZMod.val_lt i
  by_contra hi
  have h1 : 1 ≤ i.val := Nat.one_le_iff_ne_zero.2 ((ZMod.val_eq_zero i).not.2 hi)
  have h1' : (1 : ℝ) ≤ i.val := by exact_mod_cast h1
  have h5 : (i.val : ℝ) ≤ 5 := by exact_mod_cast (by omega : i.val ≤ 5)
  exact gp_coe_ne_zero (by positivity) (by nlinarith) h

lemma gp_φ6_injective : Function.Injective gp_φ6 :=
  gp_act_injective _ _ gp_e6_ne gp_half_ne

lemma gp_D6_closure_top :
    Subgroup.closure ({DihedralGroup.sr 5, DihedralGroup.r 2, DihedralGroup.sr 0} : Set (DihedralGroup 6)) = ⊤ := by
  refine eq_top_iff.2 (le_of_eq_of_le gp_closure_top.symm (Subgroup.closure_le _ |>.2 ?_))
  rintro x (rfl | rfl)
  · have := Subgroup.mul_mem _ (Subgroup.subset_closure (by simp) :
        DihedralGroup.sr 5 ∈ Subgroup.closure ({DihedralGroup.sr 5, DihedralGroup.r 2, DihedralGroup.sr 0} :
          Set (DihedralGroup 6)))
      (Subgroup.subset_closure (by simp) :
        DihedralGroup.sr 0 ∈ Subgroup.closure ({DihedralGroup.sr 5, DihedralGroup.r 2, DihedralGroup.sr 0} :
          Set (DihedralGroup 6)))
    rwa [DihedralGroup.sr_mul_sr] at this
  · exact Subgroup.subset_closure (by simp)

lemma gp_φ6_range : gp_φ6.range = Subgroup.closure {gp_σ, gp_τ, gp_R} := by
  unfold gp_φ6
  rw [gp_act_range _ _ gp_D6_closure_top]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rw [← gp_φ6, gp_φ6_sr5, gp_φ6_r2, gp_φ6_sr0]

/-- **Row 13.** `⟨σ, τ, R⟩ ≃* D₆`. -/
noncomputable def gp_D6 : Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T)) ≃* DihedralGroup 6 :=
  (MulEquiv.subgroupCongr gp_φ6_range.symm).trans (MonoidHom.ofInjective gp_φ6_injective).symm

/-- **Row 13.** `⟨σ, τ, R⟩` has order 12. -/
theorem gp_D6_card : Nat.card (Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T))) = 12 := by
  rw [Nat.card_congr gp_D6.toEquiv, DihedralGroup.nat_card]

/-- **Row 13.** `⟨σ, τ⟩ ≤ ⟨σ, τ, R⟩`, with index 2. -/
theorem gp_D3_le_D6 :
    Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T)) ≤ Subgroup.closure {gp_σ, gp_τ, gp_R} ∧
      Nat.card (Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T))) =
        2 * Nat.card (Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T))) := by
  refine ⟨Subgroup.closure_mono (by intro x hx; rcases hx with rfl | rfl <;> simp), ?_⟩
  rw [gp_D6_card, gp_D3_card]

/-- The half-turn `w ↦ w + π`. -/
noncomputable def gp_h : Equiv.Perm gp_T := Equiv.addRight ((π : ℝ) : gp_T)

lemma gp_pi_two : ((π : ℝ) : gp_T) + ((π : ℝ) : gp_T) = 0 := by
  rw [← AddCircle.coe_add, show π + π = 2 * π by ring]; exact AddCircle.coe_period (p := 2 * π)

/-- **Row 13, the `ℤ₂`.** The half-turn has order 2, lies in `⟨σ, τ, R⟩`, commutes with all of it, and is not
in `⟨σ, τ⟩`. With the index 2 above, this is `Aut(A₂) = S₃ × ℤ₂`. -/
theorem gp_half_turn :
    orderOf gp_h = 2 ∧ gp_h ∈ Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T)) ∧
      (∀ g ∈ Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T)), g * gp_h = gp_h * g) ∧
      gp_h ∉ Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T)) := by
  have hπ := Real.pi_pos
  have hφ : gp_φ6 (.r 3) = gp_h := by
    ext w
    change w + gp_e 6 _ gp_c6 3 = w + ((π : ℝ) : gp_T)
    rw [gp_e_apply, show (3 : ZMod 6).val = 3 from rfl]; congr 2; push_cast; ring
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← hφ, orderOf_injective gp_φ6 gp_φ6_injective]
    exact DihedralGroup.orderOf_r (n := 6) 3 |>.trans (by decide)
  · rw [← gp_φ6_range, ← hφ]; exact ⟨_, rfl⟩
  · intro g hg
    rw [← gp_φ6_range] at hg
    obtain ⟨x, rfl⟩ := hg
    rw [← hφ, ← map_mul, ← map_mul]
    congr 1
    rcases x with i | i
    · simp [DihedralGroup.r_mul_r, add_comm]
    · simp only [DihedralGroup.sr_mul_r, DihedralGroup.r_mul_sr]; congr 1; decide +revert
  · rw [← gp_φ_range]
    rintro ⟨x, hx⟩
    have h0 := congrArg (fun f : Equiv.Perm gp_T => f 0) hx
    have h1 := congrArg (fun f : Equiv.Perm gp_T => f ((π / 2 : ℝ) : gp_T)) hx
    rcases x with i | i
    · simp only [gp_φ, gp_act_r, zero_add, gp_h, Equiv.coe_addRight] at h0
      rw [gp_e_apply] at h0
      have hv := ZMod.val_lt i
      interval_cases hi : i.val <;> simp only [Nat.cast_zero, Nat.cast_one, Nat.cast_ofNat] at h0
      · simp at h0; exact gp_coe_ne_zero hπ (by linarith) h0.symm
      · have : ((π / 3 : ℝ) : gp_T) = 0 := by
          rw [show π / 3 = π - 1 * (2 * π / 3) by ring, AddCircle.coe_sub, ← h0, sub_self]
        exact gp_coe_ne_zero (by positivity) (by linarith) this
      · have : ((π / 3 : ℝ) : gp_T) = 0 := by
          rw [show π / 3 = 2 * (2 * π / 3) - π by ring, AddCircle.coe_sub, h0, sub_self]
        exact gp_coe_ne_zero (by positivity) (by linarith) this
    · simp only [gp_φ, gp_act_sr, neg_zero, zero_add, gp_h, Equiv.coe_addRight] at h0 h1
      rw [h0] at h1
      have : ((π / 2 : ℝ) : gp_T) + ((π / 2 : ℝ) : gp_T) = 0 := by
        have h2 : -((π / 2 : ℝ) : gp_T) + ((π : ℝ) : gp_T) = ((π / 2 : ℝ) : gp_T) + ((π : ℝ) : gp_T) := h1
        have h3 : -((π / 2 : ℝ) : gp_T) = ((π / 2 : ℝ) : gp_T) := add_right_cancel h2
        exact neg_eq_iff_add_eq_zero.1 h3
      exact gp_half_ne this

/-! ## The morphism group and its completeness (rows 1 and 5) -/

lemma gp_s3_periodic : Function.Periodic (fun x : ℝ => Real.sin (3 * x)) (2 * π) := by
  intro x
  show Real.sin (3 * (x + 2 * π)) = Real.sin (3 * x)
  rw [show 3 * (x + 2 * π) = 3 * x + ((3 : ℕ) : ℝ) * (2 * π) by push_cast; ring, Real.sin_add_nat_mul_two_pi]

/-- `w ↦ sin 3w` on the circle, which reads `2M = (2/3√3) sin 3w`. -/
noncomputable def gp_sin3 : gp_T → ℝ := gp_s3_periodic.lift

@[simp] lemma gp_s3_coe (x : ℝ) : gp_sin3 (x : gp_T) = Real.sin (3 * x) := gp_s3_periodic.lift_coe x

/-- **Row 1.** The within-single-geometry morphisms: continuous bijections `g` of `ℝ/2πℤ` with
`sin 3g(w) = sin 3w`. They form a group; inverses are continuous because the circle is compact. -/
def gp_Mor : Subgroup (Equiv.Perm gp_T) where
  carrier := {g | Continuous g ∧ ∀ w, gp_sin3 (g w) = gp_sin3 w}
  one_mem' := ⟨continuous_id, fun _ => rfl⟩
  mul_mem' := fun {f g} hf hg => ⟨hf.1.comp hg.1, fun w => by
    rw [Equiv.Perm.mul_apply, hf.2, hg.2]⟩
  inv_mem' := fun {g} hg => ⟨(hg.1.homeoOfEquivCompactToT2 (f := g)).symm.continuous, fun w => by
    rw [← hg.2 (g⁻¹ w)]; exact congrArg gp_sin3 (Equiv.apply_symm_apply g w)⟩

lemma gp_σ_mem : gp_σ ∈ gp_Mor := by
  refine ⟨continuous_neg.add continuous_const, fun w => ?_⟩
  induction w using QuotientAddGroup.induction_on with | H x => ?_
  rw [gp_σ_apply, ← AddCircle.coe_neg, ← AddCircle.coe_add, gp_s3_coe, gp_s3_coe,
    show 3 * (-x + π / 3) = π - 3 * x by ring, Real.sin_pi_sub]

lemma gp_τ_mem : gp_τ ∈ gp_Mor := by
  refine ⟨continuous_id.add continuous_const, fun w => ?_⟩
  induction w using QuotientAddGroup.induction_on with | H x => ?_
  rw [gp_τ_apply, ← AddCircle.coe_add, gp_s3_coe, gp_s3_coe,
    show 3 * (x + 2 * π / 3) = 3 * x + ((1 : ℕ) : ℝ) * (2 * π) by push_cast; ring, Real.sin_add_nat_mul_two_pi]

/-- The two branches of `sin 3v = sin 3w`: `3(v − w) = 0` or `3(v + w) = π` on the circle. -/
lemma gp_branch (v w : gp_T) (h : gp_sin3 v = gp_sin3 w) :
    3 • (v - w) = 0 ∨ 3 • (v + w) = ((π : ℝ) : gp_T) := by
  induction v using QuotientAddGroup.induction_on with | H x => ?_
  induction w using QuotientAddGroup.induction_on with | H y => ?_
  change gp_sin3 (x : gp_T) = gp_sin3 (y : gp_T) at h
  rw [gp_s3_coe, gp_s3_coe] at h
  obtain ⟨k, hk | hk⟩ := Real.sin_eq_sin_iff.1 h.symm
  · left
    change 3 • ((x : gp_T) - (y : gp_T)) = 0
    rw [← AddCircle.coe_sub, ← AddCircle.coe_nsmul, nsmul_eq_mul]
    exact (AddCircle.coe_eq_zero_iff (p := 2 * π)).2 ⟨k, by rw [zsmul_eq_mul]; push_cast; linarith⟩
  · right
    change 3 • ((x : gp_T) + (y : gp_T)) = _
    rw [← AddCircle.coe_add, ← AddCircle.coe_nsmul, nsmul_eq_mul,
      show ((3 : ℕ) : ℝ) * (x + y) = π + (k : ℝ) * (2 * π) by push_cast; linarith, gp_coe_add_int]

/-- The 3-torsion of the circle is `{e i}`. -/
lemma gp_tors0 (v : gp_T) (h : 3 • v = 0) : ∃ i : ZMod 3, v = gp_e 3 _ gp_c3 i := by
  induction v using QuotientAddGroup.induction_on with | H x => ?_
  change 3 • (x : gp_T) = 0 at h
  rw [← AddCircle.coe_nsmul, AddCircle.coe_eq_zero_iff] at h
  obtain ⟨m, hm⟩ := h
  rw [zsmul_eq_mul, nsmul_eq_mul] at hm
  obtain ⟨j, hj⟩ := gp_val_lift (x := (m : ZMod 3)) (y := m) rfl
  refine ⟨m, ?_⟩
  rw [gp_e_apply, hj]
  change (x : gp_T) = (((m + 3 * j : ℝ) * (2 * π / 3) : ℝ) : gp_T)
  rw [show ((m : ℝ) + 3 * j) * (2 * π / 3) = x + (j : ℝ) * (2 * π) by push_cast at hm ⊢; linarith,
    gp_coe_add_int]

/-- The solutions of `3v = π` are `{π/3 − e i}`. -/
lemma gp_torsπ (v : gp_T) (h : 3 • v = ((π : ℝ) : gp_T)) :
    ∃ i : ZMod 3, v = ((π / 3 : ℝ) : gp_T) - gp_e 3 _ gp_c3 i := by
  have h3 : 3 • ((π / 3 : ℝ) : gp_T) = ((π : ℝ) : gp_T) := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]; congr 1; push_cast; ring
  obtain ⟨j, hj⟩ := gp_tors0 (v - ((π / 3 : ℝ) : gp_T)) (by rw [nsmul_sub, h, h3, sub_self])
  exact ⟨-j, by rw [map_neg, sub_neg_eq_add, ← hj]; abel⟩

/-- A continuous map with values in a finite set is constant on a preconnected set. -/
lemma gp_const {S : Set ℝ} (hS : IsPreconnected S) {F : ℝ → gp_T} (hF : Continuous F) {T : Set gp_T}
    (hT : T.Finite) (hm : ∀ t ∈ S, F t ∈ T) {s t : ℝ} (hs : s ∈ S) (ht : t ∈ S) : F s = F t := by
  exact hS.constant_of_mapsTo hT.isDiscrete hF.continuousOn hm hs ht

/-- Crossing points are `π/3` apart: if `6s = 6t = π` on the circle and `|s − t| < π/3` then `s = t`. -/
lemma gp_cross_sep {s t : ℝ} (hs : 6 • (s : gp_T) = ((π : ℝ) : gp_T)) (ht : 6 • (t : gp_T) = ((π : ℝ) : gp_T))
    (hst : |s - t| < π / 3) : s = t := by
  have h : ((6 * (s - t) : ℝ) : gp_T) = 0 := by
    rw [show 6 * (s - t) = ((6 : ℕ) : ℝ) * s - ((6 : ℕ) : ℝ) * t by push_cast; ring, AddCircle.coe_sub,
      ← nsmul_eq_mul, ← nsmul_eq_mul, AddCircle.coe_nsmul, AddCircle.coe_nsmul, hs, ht, sub_self]
  obtain ⟨m, hm⟩ := (AddCircle.coe_eq_zero_iff (p := 2 * π)).1 h
  rw [zsmul_eq_mul] at hm
  have hπ := Real.pi_pos
  rw [abs_lt] at hst
  have a : (m : ℝ) < 1 := by nlinarith
  have b : (-1 : ℝ) < m := by nlinarith
  have hm0 : m = 0 := by
    have : m < 1 := by exact_mod_cast a
    have : -1 < m := by exact_mod_cast b
    omega
  subst hm0; simp at hm; linarith

lemma gp_six (G w : gp_T) (ha : 3 • (G - w) = 0) (hb : 3 • (G + w) = ((π : ℝ) : gp_T)) :
    6 • w = ((π : ℝ) : gp_T) := by
  rw [← hb, show (6 : ℕ) = 3 + 3 from rfl, add_nsmul]
  have : 3 • (G + w) = 3 • (G - w) + 3 • w + 3 • w := by rw [nsmul_sub, nsmul_add]; abel
  rw [this, ha, zero_add]

/-- **Row 5, `prop:completeness`.** Every continuous bijection `g` of `ℝ/2πℤ` with `sin 3g(w) = sin 3w` lies in
`⟨σ, τ⟩`: the morphism group is exactly `⟨σ, τ⟩ ≃* D₃ ≃* S₃`. -/
theorem gp_completeness : gp_Mor = Subgroup.closure {gp_σ, gp_τ} := by
  refine le_antisymm ?_ ((Subgroup.closure_le _).2 (by
    rintro x (rfl | rfl); exacts [gp_σ_mem, gp_τ_mem]))
  intro g hg
  rw [← gp_φ_range]
  have hπ := Real.pi_pos
  set G : ℝ → gp_T := fun t => g (t : gp_T) with hGdef
  have hc : Continuous (fun t : ℝ => (t : gp_T)) := continuous_quotient_mk'
  have hG : Continuous G := hg.1.comp hc
  set Sa : Set ℝ := {t | 3 • (G t - t) = 0}
  set Sb : Set ℝ := {t | 3 • (G t + t) = ((π : ℝ) : gp_T)}
  have cA : Continuous fun t => G t - (t : gp_T) := hG.sub hc
  have cB : Continuous fun t => G t + (t : gp_T) := hG.add hc
  have hSa : IsClosed Sa := isClosed_eq ((continuous_nsmul 3).comp cA) continuous_const
  have hSb : IsClosed Sb := isClosed_eq ((continuous_nsmul 3).comp cB) continuous_const
  have hcov : ∀ t, t ∈ Sa ∨ t ∈ Sb := fun t => gp_branch (G t) t (hg.2 t)
  have hTa : (Set.range (gp_e 3 _ gp_c3)).Finite := Set.finite_range _
  have hTb : (Set.range fun i => ((π / 3 : ℝ) : gp_T) - gp_e 3 _ gp_c3 i).Finite := Set.finite_range _
  have constA : ∀ {S : Set ℝ}, IsPreconnected S → S ⊆ Sa → ∀ {s t}, s ∈ S → t ∈ S →
      G s - (s : gp_T) = G t - t := fun {_} hS hSS {_ _} hs ht =>
    gp_const hS cA hTa (fun t ht => by obtain ⟨i, hi⟩ := gp_tors0 _ (hSS ht); exact ⟨i, hi.symm⟩) hs ht
  have constB : ∀ {S : Set ℝ}, IsPreconnected S → S ⊆ Sb → ∀ {s t}, s ∈ S → t ∈ S →
      G s + (s : gp_T) = G t + t := fun {_} hS hSS {_ _} hs ht =>
    gp_const hS cB hTb (fun t ht => by obtain ⟨i, hi⟩ := gp_torsπ _ (hSS ht); exact ⟨i, hi.symm⟩) hs ht
  -- the side intervals lie in one branch
  have side : ∀ {I : Set ℝ}, IsPreconnected I → (∀ s ∈ I, s ∉ Sa ∩ Sb) → I ⊆ Sa ∨ I ⊆ Sb := by
    intro I hI hI'
    exact isPreconnected_iff_subset_of_disjoint_closed.1 hI Sa Sb hSa hSb (fun t _ => hcov t)
      (Set.eq_empty_iff_forall_notMem.2 fun t ⟨htI, ht⟩ => hI' t htI ht)
  have sep : ∀ t₀ ∈ Sa ∩ Sb, ∀ s, |s - t₀| < π / 3 → s ∈ Sa ∩ Sb → s = t₀ := by
    intro t₀ ht₀ s hs hs'
    exact gp_cross_sep (gp_six _ _ hs'.1 hs'.2) (gp_six _ _ ht₀.1 ht₀.2) hs
  -- injectivity forbids a switch at a crossing point
  have inj : ∀ t₀ : ℝ, G (t₀ + π / 12) ≠ G (t₀ - π / 12) := by
    intro t₀ h
    have h' := g.injective h
    have : ((π / 6 : ℝ) : gp_T) = 0 := by
      rw [show π / 6 = (t₀ + π / 12) - (t₀ - π / 12) by ring, AddCircle.coe_sub, h', sub_self]
    exact gp_coe_ne_zero (by positivity) (by linarith) this
  have hcover : ∀ t₀, t₀ ∈ interior Sa ∨ t₀ ∈ interior Sb := by
    intro t₀
    by_cases hb : t₀ ∈ Sb
    · by_cases ha : t₀ ∈ Sa
      · have hR := side (I := Set.Ioo t₀ (t₀ + π / 6)) isPreconnected_Ioo (fun s hs hs' =>
          (ne_of_gt hs.1) (sep t₀ ⟨ha, hb⟩ s (by rw [abs_lt]; constructor <;> linarith [hs.1, hs.2]) hs'))
        have hL := side (I := Set.Ioo (t₀ - π / 6) t₀) isPreconnected_Ioo (fun s hs hs' =>
          (ne_of_lt hs.2) (sep t₀ ⟨ha, hb⟩ s (by rw [abs_lt]; constructor <;> linarith [hs.1, hs.2]) hs'))
        have fullset : ∀ {X : Set ℝ}, t₀ ∈ X → Set.Ioo t₀ (t₀ + π / 6) ⊆ X → Set.Ioo (t₀ - π / 6) t₀ ⊆ X →
            t₀ ∈ interior X := by
          intro X h0 hR hL
          refine mem_interior.2 ⟨Set.Ioo (t₀ - π / 6) (t₀ + π / 6), fun s hs => ?_, isOpen_Ioo,
            ⟨by linarith, by linarith⟩⟩
          rcases lt_trichotomy s t₀ with h | rfl | h
          exacts [hL ⟨hs.1, h⟩, h0, hR ⟨h, hs.2⟩]
        have hp : t₀ + π / 12 ∈ Set.Ioo t₀ (t₀ + π / 6) := ⟨by linarith, by linarith⟩
        have hm : t₀ - π / 12 ∈ Set.Ioo (t₀ - π / 6) t₀ := ⟨by linarith, by linarith⟩
        rcases hR with hR | hR <;> rcases hL with hL | hL
        · exact Or.inl (fullset ha hR hL)
        · -- right in `Sa`, left in `Sb`: the map folds at `t₀`
          exfalso
          have e1 := constA (S := Set.Ico t₀ (t₀ + π / 6)) isPreconnected_Ico
            (fun s hs => by rcases eq_or_lt_of_le hs.1 with rfl | h; exacts [ha, hR ⟨h, hs.2⟩])
            (s := t₀ + π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨le_refl _, by linarith⟩
          have e2 := constB (S := Set.Ioc (t₀ - π / 6) t₀) isPreconnected_Ioc
            (fun s hs => by rcases eq_or_lt_of_le hs.2 with rfl | h; exacts [hb, hL ⟨hs.1, h⟩])
            (s := t₀ - π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨by linarith, le_refl _⟩
          apply inj t₀
          have q1 : G (t₀ + π / 12) = G t₀ + ((π / 12 : ℝ) : gp_T) := by
            rw [sub_eq_iff_eq_add] at e1; rw [e1, AddCircle.coe_add]; abel
          have q2 : G (t₀ - π / 12) = G t₀ + ((π / 12 : ℝ) : gp_T) := by
            rw [← eq_sub_iff_add_eq] at e2; rw [e2, AddCircle.coe_sub]; abel
          rw [q1, q2]
        · -- right in `Sb`, left in `Sa`: the map folds at `t₀`
          exfalso
          have e1 := constB (S := Set.Ico t₀ (t₀ + π / 6)) isPreconnected_Ico
            (fun s hs => by rcases eq_or_lt_of_le hs.1 with rfl | h; exacts [hb, hR ⟨h, hs.2⟩])
            (s := t₀ + π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨le_refl _, by linarith⟩
          have e2 := constA (S := Set.Ioc (t₀ - π / 6) t₀) isPreconnected_Ioc
            (fun s hs => by rcases eq_or_lt_of_le hs.2 with rfl | h; exacts [ha, hL ⟨hs.1, h⟩])
            (s := t₀ - π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨by linarith, le_refl _⟩
          apply inj t₀
          have q1 : G (t₀ + π / 12) = G t₀ - ((π / 12 : ℝ) : gp_T) := by
            rw [← eq_sub_iff_add_eq] at e1; rw [e1, AddCircle.coe_add]; abel
          have q2 : G (t₀ - π / 12) = G t₀ - ((π / 12 : ℝ) : gp_T) := by
            rw [sub_eq_iff_eq_add] at e2; rw [e2, AddCircle.coe_sub]; abel
          rw [q1, q2]
        · exact Or.inr (fullset hb hR hL)
      · exact Or.inr (mem_interior.2 ⟨Saᶜ, fun s hs => (hcov s).resolve_left hs, hSa.isOpen_compl, ha⟩)
    · exact Or.inl (mem_interior.2 ⟨Sbᶜ, fun s hs => (hcov s).resolve_right hs, hSb.isOpen_compl, hb⟩)
  have hdisj : ∀ t, t ∈ interior Sa → t ∉ interior Sb := by
    intro t ha hb
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 ((isOpen_interior.inter isOpen_interior).mem_nhds ⟨ha, hb⟩)
    set δ := min (ε / 2) (π / 6)
    have hδ : 0 < δ := lt_min (by linarith) (by positivity)
    have hδ1 : δ ≤ ε / 2 := min_le_left _ _
    have hδ2 : δ ≤ π / 6 := min_le_right _ _
    have hm : t + δ ∈ interior Sa ∩ interior Sb :=
      hball (by rw [Metric.mem_ball, Real.dist_eq, show t + δ - t = δ by ring, abs_of_pos hδ]; linarith)
    have := sep t ⟨interior_subset ha, interior_subset hb⟩ (t + δ)
      (by rw [show t + δ - t = δ by ring, abs_of_pos hδ]; linarith)
      ⟨interior_subset hm.1, interior_subset hm.2⟩
    linarith
  have hclopen : IsClopen (interior Sa) := by
    refine ⟨?_, isOpen_interior⟩
    have : (interior Sa)ᶜ = interior Sb := Set.ext fun t =>
      ⟨fun h => (hcover t).resolve_left h, fun h h' => hdisj t h' h⟩
    rw [← isOpen_compl_iff, this]; exact isOpen_interior
  have hsurj : ∀ w : gp_T, ∃ t : ℝ, (t : gp_T) = w := fun w => QuotientAddGroup.mk_surjective w
  rcases isClopen_iff.1 hclopen with h | h
  · -- every point on the reflection branch
    have hB : ∀ t, t ∈ Sb := fun t => interior_subset ((hcover t).resolve_left (by rw [h]; exact id))
    obtain ⟨i, hi⟩ := gp_torsπ _ (hB 0)
    refine ⟨.sr i, Equiv.ext fun w => ?_⟩
    obtain ⟨t, rfl⟩ := hsurj w
    have e := constB isPreconnected_univ (fun t _ => hB t) (s := t) (t := 0) trivial trivial
    rw [hi, eq_sub_iff_add_eq] at e
    change -(t : gp_T) + (((π / 3 : ℝ) : gp_T) - gp_e 3 _ gp_c3 i) = G t
    rw [← e]; abel
  · -- every point on the rotation branch
    have hA : ∀ t, t ∈ Sa := fun t => interior_subset (by rw [h]; trivial)
    obtain ⟨i, hi⟩ := gp_tors0 _ (hA 0)
    refine ⟨.r i, Equiv.ext fun w => ?_⟩
    obtain ⟨t, rfl⟩ := hsurj w
    have e := constA isPreconnected_univ (fun t _ => hA t) (s := t) (t := 0) trivial trivial
    rw [hi, sub_eq_iff_eq_add] at e
    change (t : gp_T) + gp_e 3 _ gp_c3 i = G t
    rw [e]; abel

/-- **Rows 1 and 5.** The morphism group is `D₃`: `gp_Mor ≃* DihedralGroup 3`, of order 6, and it is non-trivial
(`σ ∈ gp_Mor`, `σ ≠ 1`). -/
noncomputable def gp_Mor_D3 : gp_Mor ≃* DihedralGroup 3 :=
  (MulEquiv.subgroupCongr gp_completeness).trans gp_D3

theorem gp_Mor_card : Nat.card gp_Mor = 6 ∧ gp_σ ∈ gp_Mor ∧ gp_σ ≠ 1 :=
  ⟨by rw [Nat.card_congr gp_Mor_D3.toEquiv, DihedralGroup.nat_card], gp_σ_mem, gp_σ_sq.2⟩

