open Real

namespace ShadowProbe.GroupoidProbe

/-! ## The construction -/

section GpAct

variable {A : Type*} [AddCommGroup A] {n : ℕ}

/-- The underlying map of the action. -/
def gp_fun (e : ZMod n →+ A) (d : A) : DihedralGroup n → Equiv.Perm A
  | .r i => Equiv.addRight (e i)
  | .sr i => (Equiv.neg A).trans (Equiv.addRight (d - e i))

/-- **The dihedral action** `r i ↦ (w ↦ w + e i)`, `sr i ↦ (w ↦ −w + (d − e i))`. -/
def gp_act (e : ZMod n →+ A) (d : A) : DihedralGroup n →* Equiv.Perm A where
  toFun := gp_fun e d
  map_one' := by
    show gp_fun e d (.r 0) = 1
    ext x; simp [gp_fun]
  map_mul' := by
    rintro (i | i) (j | j) <;> ext x <;>
      simp [gp_fun, DihedralGroup.r_mul_r, DihedralGroup.r_mul_sr, DihedralGroup.sr_mul_r,
        DihedralGroup.sr_mul_sr, map_add, map_sub] <;> abel

@[simp] lemma gp_act_r (e : ZMod n →+ A) (d : A) (i : ZMod n) (x : A) :
    gp_act e d (.r i) x = x + e i := rfl

@[simp] lemma gp_act_sr (e : ZMod n →+ A) (d : A) (i : ZMod n) (x : A) :
    gp_act e d (.sr i) x = -x + (d - e i) := rfl

/-- The action is faithful when `e` is injective at `0` and some `a` has `a + a ≠ 0`. -/
theorem gp_act_injective (e : ZMod n →+ A) (d : A) (he : ∀ i, e i = 0 → i = 0) {a : A} (ha : a + a ≠ 0) :
    Function.Injective (gp_act e d) := by
  rw [injective_iff_map_eq_one]
  rintro (i | i) h
  · have := congrArg (fun f : Equiv.Perm A => f 0) h
    simp at this
    rw [he i this]; rfl
  · have h0 := congrArg (fun f : Equiv.Perm A => f 0) h
    have h1 := congrArg (fun f : Equiv.Perm A => f a) h
    simp only [gp_act_sr, Equiv.Perm.coe_one, id_eq, neg_zero, zero_add] at h0 h1
    rw [h0, add_zero] at h1
    exact (ha (neg_eq_iff_add_eq_zero.1 h1)).elim

/-- `DihedralGroup n` is generated by `r 1` and `sr 0`. -/
lemma gp_closure_top [NeZero n] :
    Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} : Set (DihedralGroup n)) = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  have h1 : DihedralGroup.r (1 : ZMod n) ∈ Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} :
      Set (DihedralGroup n)) := Subgroup.subset_closure (by simp)
  have h0 : DihedralGroup.sr (0 : ZMod n) ∈ Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} :
      Set (DihedralGroup n)) := Subgroup.subset_closure (by simp)
  have hr : ∀ i : ZMod n, DihedralGroup.r i ∈ Subgroup.closure ({DihedralGroup.r 1, DihedralGroup.sr 0} :
      Set (DihedralGroup n)) := fun i => by
    have := Subgroup.pow_mem _ h1 i.val
    rwa [DihedralGroup.r_one_pow, ZMod.natCast_zmod_val] at this
  rcases x with i | i
  · exact hr i
  · have := Subgroup.mul_mem _ h0 (hr i)
    rwa [DihedralGroup.sr_mul_r, zero_add] at this

/-- The range of the action is the closure of the images of a generating set. -/
lemma gp_act_range (e : ZMod n →+ A) (d : A) {S : Set (DihedralGroup n)} (hS : Subgroup.closure S = ⊤) :
    (gp_act e d).range = Subgroup.closure (gp_act e d '' S) := by
  rw [MonoidHom.range_eq_map, ← hS, MonoidHom.map_closure]

end GpAct

/-! ## The sky-angle circle -/

instance gp_fact : Fact (0 < 2 * π) := ⟨by positivity⟩

/-- The sky-angle circle `ℝ/2πℤ`. -/
abbrev gp_T := AddCircle (2 * π)

lemma gp_coe_ne_zero {x : ℝ} (h0 : 0 < x) (h1 : x < 2 * π) : (x : gp_T) ≠ 0 := by
  intro h
  rw [AddCircle.coe_eq_zero_iff] at h
  obtain ⟨m, hm⟩ := h
  rw [zsmul_eq_mul] at hm
  have hπ := Real.pi_pos
  have a : (0 : ℤ) < m := by
    have : (0 : ℝ) < m := by nlinarith
    exact_mod_cast this
  have b : m < 1 := by
    have : (m : ℝ) < 1 := by nlinarith
    exact_mod_cast this
  omega

/-- The step map `ZMod n →+ ℝ/2πℤ`, `i ↦ i·c`, for `n c = 2π`. -/
noncomputable def gp_e (n : ℕ) (c : ℝ) (hc : (n : ℝ) * c = 2 * π) : ZMod n →+ gp_T :=
  ZMod.lift n ⟨zmultiplesHom gp_T (c : gp_T), by
    rw [zmultiplesHom_apply, ← AddCircle.coe_zsmul, zsmul_eq_mul]; push_cast; rw [hc]
    exact AddCircle.coe_period (p := 2 * π)⟩

lemma gp_e_one {n : ℕ} {c : ℝ} (hc : (n : ℝ) * c = 2 * π) : gp_e n c hc 1 = (c : gp_T) := by
  have := ZMod.lift_coe (n := n) ⟨zmultiplesHom gp_T (c : gp_T), by
    rw [zmultiplesHom_apply, ← AddCircle.coe_zsmul, zsmul_eq_mul]; push_cast; rw [hc]
    exact AddCircle.coe_period (p := 2 * π)⟩ 1
  unfold gp_e; simpa using this

lemma gp_e_apply {n : ℕ} [NeZero n] {c : ℝ} (hc : (n : ℝ) * c = 2 * π) (i : ZMod n) :
    gp_e n c hc i = (((i.val : ℝ) * c : ℝ) : gp_T) := by
  conv_lhs => rw [← ZMod.natCast_zmod_val i, ← nsmul_one, map_nsmul, gp_e_one]
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]

lemma gp_c3 : ((3 : ℕ) : ℝ) * (2 * π / 3) = 2 * π := by push_cast; ring
lemma gp_c6 : ((6 : ℕ) : ℝ) * (π / 3) = 2 * π := by push_cast; ring

/-- The `D₃` action on the sky angle: `e i = i·(2π/3)`, `d = π/3`. -/
noncomputable def gp_φ : DihedralGroup 3 →* Equiv.Perm gp_T := gp_act (gp_e 3 _ gp_c3) ((π / 3 : ℝ) : gp_T)

/-- **The involution** `σ : w ↦ π/3 − w`. -/
noncomputable def gp_σ : Equiv.Perm gp_T := (Equiv.neg gp_T).trans (Equiv.addRight ((π / 3 : ℝ) : gp_T))
/-- **The sky-angle periodicity** `τ : w ↦ w + 2π/3`. -/
noncomputable def gp_τ : Equiv.Perm gp_T := Equiv.addRight ((2 * π / 3 : ℝ) : gp_T)

@[simp] lemma gp_σ_apply (w : gp_T) : gp_σ w = -w + ((π / 3 : ℝ) : gp_T) := rfl
@[simp] lemma gp_τ_apply (w : gp_T) : gp_τ w = w + ((2 * π / 3 : ℝ) : gp_T) := rfl

lemma gp_φ_sr0 : gp_φ (.sr 0) = gp_σ := by
  ext w; simp [gp_φ, gp_e_apply]
lemma gp_φ_r1 : gp_φ (.r 1) = gp_τ := by
  ext w; simp [gp_φ, gp_e_one]

lemma gp_e3_ne (i : ZMod 3) (h : gp_e 3 _ gp_c3 i = 0) : i = 0 := by
  have hπ := Real.pi_pos
  fin_cases i
  · rfl
  · change gp_e 3 _ gp_c3 1 = 0 at h
    rw [gp_e_one] at h
    exact absurd h (gp_coe_ne_zero (by positivity) (by linarith))
  · change gp_e 3 _ gp_c3 (1 + 1) = 0 at h
    rw [map_add, gp_e_one, ← AddCircle.coe_add] at h
    exact absurd h (gp_coe_ne_zero (by positivity) (by linarith))

lemma gp_half_ne : ((π / 2 : ℝ) : gp_T) + ((π / 2 : ℝ) : gp_T) ≠ 0 := by
  rw [← AddCircle.coe_add]
  exact gp_coe_ne_zero (by positivity) (by nlinarith [Real.pi_pos])

lemma gp_φ_injective : Function.Injective gp_φ :=
  gp_act_injective _ _ gp_e3_ne gp_half_ne

/-- **Row 2a.** `σ² = 1` and `σ ≠ 1`. -/
theorem gp_σ_sq : gp_σ ^ 2 = 1 ∧ gp_σ ≠ 1 := by
  refine ⟨by ext w; simp [sq], fun h => ?_⟩
  rw [← gp_φ_sr0, ← map_one gp_φ] at h
  exact absurd (gp_φ_injective h) (by decide)

/-- **Row 3.** `τ` has order exactly 3 on `ℝ/2πℤ`. -/
theorem gp_τ_order : orderOf gp_τ = 3 := by
  rw [← gp_φ_r1, orderOf_injective gp_φ gp_φ_injective]
  exact (DihedralGroup.orderOf_r_one (n := 3))

/-- **Row 3, the caveat.** On `ℝ/(2π/3)ℤ` the same translation is the identity. -/
theorem gp_τ_short : Equiv.addRight (((2 * π / 3 : ℝ)) : AddCircle (2 * π / 3)) = 1 := by
  ext w; simp [AddCircle.coe_period]

/-- **Row 4, the relations.** `σ² = τ³ = (στ)² = 1`. -/
theorem gp_relations : gp_σ ^ 2 = 1 ∧ gp_τ ^ 3 = 1 ∧ (gp_σ * gp_τ) ^ 2 = 1 := by
  refine ⟨gp_σ_sq.1, ?_, ?_⟩
  · rw [← gp_τ_order]; exact pow_orderOf_eq_one _
  · rw [← gp_φ_sr0, ← gp_φ_r1, ← map_mul, ← map_pow]
    rw [show (DihedralGroup.sr 0 * DihedralGroup.r 1 : DihedralGroup 3) ^ 2 = 1 by decide, map_one]

lemma gp_φ_range : gp_φ.range = Subgroup.closure {gp_σ, gp_τ} := by
  unfold gp_φ
  rw [gp_act_range _ _ gp_closure_top]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rw [← gp_φ, gp_φ_r1, gp_φ_sr0, Set.pair_comm]

/-- **Row 4.** `⟨σ, τ⟩ ≃* D₃`. -/
noncomputable def gp_D3 : Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T)) ≃* DihedralGroup 3 :=
  (MulEquiv.subgroupCongr gp_φ_range.symm).trans (MonoidHom.ofInjective gp_φ_injective).symm

/-- **Row 4.** `⟨σ, τ⟩` has order 6. -/
theorem gp_D3_card : Nat.card (Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T))) = 6 := by
  rw [Nat.card_congr gp_D3.toEquiv, DihedralGroup.nat_card]

/-! ## The roots and their permutation -/

/-- The label action, a push-forward: `r i ↦ (k ↦ k − i)`, `sr i ↦ (k ↦ −k + 1 + i)`. -/
def gp_ψ : DihedralGroup 3 →* Equiv.Perm (ZMod 3) := gp_act (-AddMonoidHom.id (ZMod 3)) 1

lemma gp_ψ_injective : Function.Injective gp_ψ :=
  gp_act_injective _ _ (fun i h => by simpa using h) (a := 1) (by decide)

/-- **Row 4.** `D₃ ≃* S₃`, through the permutation of the three root labels. -/
noncomputable def gp_S3 : DihedralGroup 3 ≃* Equiv.Perm (ZMod 3) :=
  MulEquiv.ofBijective gp_ψ ((Fintype.bijective_iff_injective_and_card _).2
    ⟨gp_ψ_injective, by rw [Fintype.card_perm, DihedralGroup.card]; rfl⟩)

/-- The roots `rₖ(w) = (2/√3) sin(w + 2πk/3)`. -/
noncomputable def gp_root (w : ℝ) (k : ZMod 3) : ℝ := 2 / Real.sqrt 3 * Real.sin (w + k.val * (2 * π / 3))

/-- The lift of the action to `ℝ`. -/
noncomputable def gp_lift : DihedralGroup 3 → ℝ → ℝ
  | .r i, w => w + i.val * (2 * π / 3)
  | .sr i, w => -w + (π / 3 - i.val * (2 * π / 3))

lemma gp_lift_coe (g : DihedralGroup 3) (w : ℝ) : ((gp_lift g w : ℝ) : gp_T) = gp_φ g (w : gp_T) := by
  rcases g with i | i <;> simp [gp_lift, gp_φ, gp_e_apply]

lemma gp_s3 : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)

/-- **Row 2c.** Each `rₖ(w)` solves the horizon cubic `r³ − r + 2M = 0` with `2M = (2/3√3) sin 3w`. -/
theorem gp_root_cubic (w : ℝ) (k : ZMod 3) :
    gp_root w k ^ 3 - gp_root w k + 2 / (3 * Real.sqrt 3) * Real.sin (3 * w) = 0 := by
  have h3 : Real.sin (3 * w) = Real.sin (3 * (w + k.val * (2 * π / 3))) := by
    rw [show 3 * (w + k.val * (2 * π / 3)) = 3 * w + (k.val : ℕ) * (2 * π) by ring]
    exact (Real.sin_add_nat_mul_two_pi _ _).symm
  have hs : 0 < Real.sqrt 3 := by positivity
  rw [h3, Real.sin_three_mul, gp_root]
  field_simp
  ring_nf; simp only [gp_s3]; ring

lemma gp_sin_per {a b : ℝ} (m : ℤ) (h : a = b + m * (2 * π)) : Real.sin a = Real.sin b := by
  rw [h, Real.sin_add_int_mul_two_pi]

lemma gp_sin_refl {a b : ℝ} (m : ℤ) (h : a = π - b + m * (2 * π)) : Real.sin a = Real.sin b := by
  rw [h, Real.sin_add_int_mul_two_pi, Real.sin_pi_sub]

/-- A label identity in `ZMod 3` lifts to its values up to a multiple of 3. -/
lemma gp_val_lift {x : ZMod 3} {y : ℤ} (h : (x : ZMod 3) = (y : ZMod 3)) :
    ∃ m : ℤ, (x.val : ℝ) = y + 3 * m := by
  have h0 : (((x.val : ℤ) - y : ℤ) : ZMod 3) = 0 := by
    push_cast; rw [ZMod.natCast_zmod_val, h, sub_self]
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h0
  obtain ⟨m, hm⟩ := h0
  refine ⟨m, ?_⟩
  have := congrArg (fun z : ℤ => (z : ℝ)) hm
  push_cast at this; linarith

lemma gp_ψ_r (i k : ZMod 3) : gp_ψ (.r i) k = k - i := by
  simp [gp_ψ, sub_eq_add_neg]

lemma gp_ψ_sr (i k : ZMod 3) : gp_ψ (.sr i) k = -k + (1 + i) := by
  simp [gp_ψ]

/-- **Row 2c.** The action permutes the roots: `r_{ψ(g)k}(g w) = rₖ(w)` for every `g ∈ D₃`. -/
theorem gp_root_perm (g : DihedralGroup 3) (w : ℝ) (k : ZMod 3) :
    gp_root (gp_lift g w) (gp_ψ g k) = gp_root w k := by
  unfold gp_root
  congr 1
  rcases g with i | i
  · obtain ⟨m, hm⟩ := gp_val_lift (x := k - i) (y := (k.val : ℤ) - i.val) (by
      push_cast; rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val])
    rw [gp_ψ_r]
    refine gp_sin_per m ?_
    simp only [gp_lift]; push_cast at hm; rw [hm]; ring
  · obtain ⟨m, hm⟩ := gp_val_lift (x := -k + (1 + i)) (y := -(k.val : ℤ) + (1 + i.val)) (by
      push_cast; rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val])
    rw [gp_ψ_sr]
    refine gp_sin_refl m ?_
    simp only [gp_lift]; push_cast at hm; rw [hm]; ring

/-- **Row 2c.** `σ` swaps labels 0 and 1 and fixes 2. -/
theorem gp_σ_roots : gp_ψ (.sr 0) 0 = 1 ∧ gp_ψ (.sr 0) 1 = 0 ∧ gp_ψ (.sr 0) 2 = 2 := by decide

/-- **Row 2c.** On `w ∈ (0, π/3)` the two roots `σ` swaps are positive. -/
theorem gp_roots_pos {w : ℝ} (h0 : 0 < w) (h1 : w < π / 3) : 0 < gp_root w 0 ∧ 0 < gp_root w 1 := by
  have hs : 0 < 2 / Real.sqrt 3 := by positivity
  have hπ := Real.pi_pos
  simp only [gp_root, show (0 : ZMod 3).val = 0 from rfl, show (1 : ZMod 3).val = 1 from rfl]
  push_cast
  refine ⟨mul_pos hs (Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)),
    mul_pos hs (Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith))⟩

/-! ## The fixed points of σ, and the Nariai mass -/

lemma gp_coe_add_int (y : ℝ) (j : ℤ) : ((y + j * (2 * π) : ℝ) : gp_T) = (y : gp_T) := by
  rw [AddCircle.coe_add, (AddCircle.coe_eq_zero_iff (p := 2 * π) (x := j * (2 * π))).2 ⟨j, by rw [zsmul_eq_mul]⟩, add_zero]

/-- **Row 7b.** On the full circle, `σ w = w` exactly at `π/6` and `7π/6`; there `r₀ = (2/√3) sin w` is
`1/√3` and `−1/√3`. -/
theorem gp_σ_fixed (w : gp_T) :
    (gp_σ w = w ↔ w = ((π / 6 : ℝ) : gp_T) ∨ w = ((7 * π / 6 : ℝ) : gp_T)) ∧
      2 / Real.sqrt 3 * Real.sin (π / 6) = 1 / Real.sqrt 3 ∧
      2 / Real.sqrt 3 * Real.sin (7 * π / 6) = -(1 / Real.sqrt 3) := by
  refine ⟨?_, ?_, ?_⟩
  · induction w using QuotientAddGroup.induction_on with | H x => ?_
    change -(x : gp_T) + ((π / 3 : ℝ) : gp_T) = x ↔ _
    constructor
    · intro h
      have h' : ((π / 3 - 2 * x : ℝ) : gp_T) = 0 := by
        rw [show π / 3 - 2 * x = (π / 3 - x) - x by ring, AddCircle.coe_sub, AddCircle.coe_sub]
        calc ((π / 3 : ℝ) : gp_T) - x - x = (-(x : gp_T) + ((π / 3 : ℝ) : gp_T)) - x := by abel
          _ = 0 := by rw [h, sub_self]
      rw [AddCircle.coe_eq_zero_iff] at h'
      obtain ⟨m, hm⟩ := h'
      rw [zsmul_eq_mul] at hm
      obtain ⟨j, rfl | rfl⟩ := Int.even_or_odd' m
      · left
        rw [show x = π / 6 + ((-j : ℤ) : ℝ) * (2 * π) by push_cast at hm ⊢; linarith, gp_coe_add_int]
      · right
        rw [show x = 7 * π / 6 + ((-j - 1 : ℤ) : ℝ) * (2 * π) by push_cast at hm ⊢; linarith, gp_coe_add_int]
    · rintro (h | h) <;> rw [h, ← AddCircle.coe_neg, ← AddCircle.coe_add]
      · congr 1; ring
      · rw [show -(7 * π / 6) + π / 3 = 7 * π / 6 + ((-1 : ℤ) : ℝ) * (2 * π) by push_cast; ring, gp_coe_add_int]
  · rw [Real.sin_pi_div_six]; ring
  · rw [show 7 * π / 6 = π / 6 + π by ring, Real.sin_add_pi, Real.sin_pi_div_six]; ring

/-- **Row 8.** At the Nariai vantage `w = π/6`: `2M = 2/(3√3)`; with the throat `α` restored, `M = α/(3√3)` and
`Λ = 3/α²` give `ΛM² = 1/9`. -/
theorem gp_nariai_mass {α : ℝ} (hα : α ≠ 0) :
    2 / (3 * Real.sqrt 3) * Real.sin (3 * (π / 6)) = 2 / (3 * Real.sqrt 3) ∧
      3 / α ^ 2 * (α / (3 * Real.sqrt 3)) ^ 2 = 1 / 9 := by
  refine ⟨by rw [show 3 * (π / 6) = π / 2 by ring, Real.sin_pi_div_two, mul_one], ?_⟩
  field_simp; rw [gp_s3]; ring

/-! ## `Aut(A₂)`: the reflection `R` and the order-12 group -/

/-- **The reflection** `R : w ↦ −w`. -/
noncomputable def gp_R : Equiv.Perm gp_T := Equiv.neg gp_T

@[simp] lemma gp_R_apply (w : gp_T) : gp_R w = -w := rfl

/-- **Row 13.** `R` sends `sin 3w ↦ −sin 3w`, so `2M ↦ −2M`; it swaps the Nariai vantages `±π/6`
(`2M = ±2/(3√3)`) and fixes `w = 0` (`2M = 0`). -/
theorem gp_R_mass (w : ℝ) :
    Real.sin (3 * -w) = -Real.sin (3 * w) ∧ gp_R ((π / 6 : ℝ) : gp_T) = ((-(π / 6) : ℝ) : gp_T) ∧
      gp_R ((-(π / 6) : ℝ) : gp_T) = ((π / 6 : ℝ) : gp_T) ∧ gp_R 0 = 0 ∧
      2 / (3 * Real.sqrt 3) * Real.sin (3 * -(π / 6)) = -(2 / (3 * Real.sqrt 3)) := by
  refine ⟨by rw [mul_neg, Real.sin_neg], by simp, by simp, by simp, ?_⟩
  rw [mul_neg, Real.sin_neg, show 3 * (π / 6) = π / 2 by ring, Real.sin_pi_div_two]; ring

/-- The `D₆` action on the sky angle: `e i = i·(π/3)`, `d = 0`. -/
noncomputable def gp_φ6 : DihedralGroup 6 →* Equiv.Perm gp_T := gp_act (gp_e 6 _ gp_c6) 0

lemma gp_φ6_r2 : gp_φ6 (.r 2) = gp_τ := by
  ext w
  change w + gp_e 6 _ gp_c6 (1 + 1) = _
  rw [map_add, gp_e_one, gp_τ_apply, ← AddCircle.coe_add]; congr 2; ring

lemma gp_φ6_sr0 : gp_φ6 (.sr 0) = gp_R := by
  ext w; simp [gp_φ6]

lemma gp_φ6_sr5 : gp_φ6 (.sr 5) = gp_σ := by
  ext w
  have h5 : gp_e 6 _ gp_c6 5 = ((5 * (π / 3) : ℝ) : gp_T) := by
    rw [gp_e_apply, show (5 : ZMod 6).val = 5 from rfl]; push_cast; ring_nf
  change -w + (0 - gp_e 6 _ gp_c6 5) = _
  rw [h5, gp_σ_apply, zero_sub, ← AddCircle.coe_neg,
    show -(5 * (π / 3)) = π / 3 + ((-1 : ℤ) : ℝ) * (2 * π) by push_cast; ring, gp_coe_add_int]

lemma gp_e6_ne (i : ZMod 6) (h : gp_e 6 _ gp_c6 i = 0) : i = 0 := by
  rw [gp_e_apply] at h
  have hπ := Real.pi_pos
  have hv := ZMod.val_lt i
  by_contra hi
  have h1 : 1 ≤ i.val := Nat.one_le_iff_ne_zero.2 ((ZMod.val_eq_zero i).not.2 hi)
  have h1' : (1 : ℝ) ≤ i.val := by exact_mod_cast h1
  have h5 : (i.val : ℝ) ≤ 5 := by exact_mod_cast (by omega : i.val ≤ 5)
  exact gp_coe_ne_zero (by positivity) (by nlinarith) h

lemma gp_φ6_injective : Function.Injective gp_φ6 :=
  gp_act_injective _ _ gp_e6_ne gp_half_ne

lemma gp_D6_closure_top :
    Subgroup.closure ({DihedralGroup.sr 5, DihedralGroup.r 2, DihedralGroup.sr 0} : Set (DihedralGroup 6)) = ⊤ := by
  refine eq_top_iff.2 (le_of_eq_of_le gp_closure_top.symm (Subgroup.closure_le _ |>.2 ?_))
  rintro x (rfl | rfl)
  · have := Subgroup.mul_mem _ (Subgroup.subset_closure (by simp) :
        DihedralGroup.sr 5 ∈ Subgroup.closure ({DihedralGroup.sr 5, DihedralGroup.r 2, DihedralGroup.sr 0} :
          Set (DihedralGroup 6)))
      (Subgroup.subset_closure (by simp) :
        DihedralGroup.sr 0 ∈ Subgroup.closure ({DihedralGroup.sr 5, DihedralGroup.r 2, DihedralGroup.sr 0} :
          Set (DihedralGroup 6)))
    rwa [DihedralGroup.sr_mul_sr] at this
  · exact Subgroup.subset_closure (by simp)

lemma gp_φ6_range : gp_φ6.range = Subgroup.closure {gp_σ, gp_τ, gp_R} := by
  unfold gp_φ6
  rw [gp_act_range _ _ gp_D6_closure_top]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rw [← gp_φ6, gp_φ6_sr5, gp_φ6_r2, gp_φ6_sr0]

/-- **Row 13.** `⟨σ, τ, R⟩ ≃* D₆`. -/
noncomputable def gp_D6 : Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T)) ≃* DihedralGroup 6 :=
  (MulEquiv.subgroupCongr gp_φ6_range.symm).trans (MonoidHom.ofInjective gp_φ6_injective).symm

/-- **Row 13.** `⟨σ, τ, R⟩` has order 12. -/
theorem gp_D6_card : Nat.card (Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T))) = 12 := by
  rw [Nat.card_congr gp_D6.toEquiv, DihedralGroup.nat_card]

/-- **Row 13.** `⟨σ, τ⟩ ≤ ⟨σ, τ, R⟩`, with index 2. -/
theorem gp_D3_le_D6 :
    Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T)) ≤ Subgroup.closure {gp_σ, gp_τ, gp_R} ∧
      Nat.card (Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T))) =
        2 * Nat.card (Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T))) := by
  refine ⟨Subgroup.closure_mono (by intro x hx; rcases hx with rfl | rfl <;> simp), ?_⟩
  rw [gp_D6_card, gp_D3_card]

/-- The half-turn `w ↦ w + π`. -/
noncomputable def gp_h : Equiv.Perm gp_T := Equiv.addRight ((π : ℝ) : gp_T)

lemma gp_pi_two : ((π : ℝ) : gp_T) + ((π : ℝ) : gp_T) = 0 := by
  rw [← AddCircle.coe_add, show π + π = 2 * π by ring]; exact AddCircle.coe_period (p := 2 * π)

/-- **Row 13, the `ℤ₂`.** The half-turn has order 2, lies in `⟨σ, τ, R⟩`, commutes with all of it, and is not
in `⟨σ, τ⟩`. With the index 2 above, this is `Aut(A₂) = S₃ × ℤ₂`. -/
theorem gp_half_turn :
    orderOf gp_h = 2 ∧ gp_h ∈ Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T)) ∧
      (∀ g ∈ Subgroup.closure ({gp_σ, gp_τ, gp_R} : Set (Equiv.Perm gp_T)), g * gp_h = gp_h * g) ∧
      gp_h ∉ Subgroup.closure ({gp_σ, gp_τ} : Set (Equiv.Perm gp_T)) := by
  have hπ := Real.pi_pos
  have hφ : gp_φ6 (.r 3) = gp_h := by
    ext w
    change w + gp_e 6 _ gp_c6 3 = w + ((π : ℝ) : gp_T)
    rw [gp_e_apply, show (3 : ZMod 6).val = 3 from rfl]; congr 2; push_cast; ring
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← hφ, orderOf_injective gp_φ6 gp_φ6_injective]
    exact DihedralGroup.orderOf_r (n := 6) 3 |>.trans (by decide)
  · rw [← gp_φ6_range, ← hφ]; exact ⟨_, rfl⟩
  · intro g hg
    rw [← gp_φ6_range] at hg
    obtain ⟨x, rfl⟩ := hg
    rw [← hφ, ← map_mul, ← map_mul]
    congr 1
    rcases x with i | i
    · simp [DihedralGroup.r_mul_r, add_comm]
    · simp only [DihedralGroup.sr_mul_r, DihedralGroup.r_mul_sr]; congr 1; decide +revert
  · rw [← gp_φ_range]
    rintro ⟨x, hx⟩
    have h0 := congrArg (fun f : Equiv.Perm gp_T => f 0) hx
    have h1 := congrArg (fun f : Equiv.Perm gp_T => f ((π / 2 : ℝ) : gp_T)) hx
    rcases x with i | i
    · simp only [gp_φ, gp_act_r, zero_add, gp_h, Equiv.coe_addRight] at h0
      rw [gp_e_apply] at h0
      have hv := ZMod.val_lt i
      interval_cases hi : i.val <;> simp only [Nat.cast_zero, Nat.cast_one, Nat.cast_ofNat] at h0
      · simp at h0; exact gp_coe_ne_zero hπ (by linarith) h0.symm
      · have : ((π / 3 : ℝ) : gp_T) = 0 := by
          rw [show π / 3 = π - 1 * (2 * π / 3) by ring, AddCircle.coe_sub, ← h0, sub_self]
        exact gp_coe_ne_zero (by positivity) (by linarith) this
      · have : ((π / 3 : ℝ) : gp_T) = 0 := by
          rw [show π / 3 = 2 * (2 * π / 3) - π by ring, AddCircle.coe_sub, h0, sub_self]
        exact gp_coe_ne_zero (by positivity) (by linarith) this
    · simp only [gp_φ, gp_act_sr, neg_zero, zero_add, gp_h, Equiv.coe_addRight] at h0 h1
      rw [h0] at h1
      have : ((π / 2 : ℝ) : gp_T) + ((π / 2 : ℝ) : gp_T) = 0 := by
        have h2 : -((π / 2 : ℝ) : gp_T) + ((π : ℝ) : gp_T) = ((π / 2 : ℝ) : gp_T) + ((π : ℝ) : gp_T) := h1
        have h3 : -((π / 2 : ℝ) : gp_T) = ((π / 2 : ℝ) : gp_T) := add_right_cancel h2
        exact neg_eq_iff_add_eq_zero.1 h3
      exact gp_half_ne this

/-! ## The morphism group and its completeness (rows 1 and 5) -/

lemma gp_s3_periodic : Function.Periodic (fun x : ℝ => Real.sin (3 * x)) (2 * π) := by
  intro x
  show Real.sin (3 * (x + 2 * π)) = Real.sin (3 * x)
  rw [show 3 * (x + 2 * π) = 3 * x + ((3 : ℕ) : ℝ) * (2 * π) by push_cast; ring, Real.sin_add_nat_mul_two_pi]

/-- `w ↦ sin 3w` on the circle, which reads `2M = (2/3√3) sin 3w`. -/
noncomputable def gp_sin3 : gp_T → ℝ := gp_s3_periodic.lift

@[simp] lemma gp_s3_coe (x : ℝ) : gp_sin3 (x : gp_T) = Real.sin (3 * x) := gp_s3_periodic.lift_coe x

/-- **Row 1.** The within-single-geometry morphisms: continuous bijections `g` of `ℝ/2πℤ` with
`sin 3g(w) = sin 3w`. They form a group; inverses are continuous because the circle is compact. -/
def gp_Mor : Subgroup (Equiv.Perm gp_T) where
  carrier := {g | Continuous g ∧ ∀ w, gp_sin3 (g w) = gp_sin3 w}
  one_mem' := ⟨continuous_id, fun _ => rfl⟩
  mul_mem' := fun {f g} hf hg => ⟨hf.1.comp hg.1, fun w => by
    rw [Equiv.Perm.mul_apply, hf.2, hg.2]⟩
  inv_mem' := fun {g} hg => ⟨(hg.1.homeoOfEquivCompactToT2 (f := g)).symm.continuous, fun w => by
    rw [← hg.2 (g⁻¹ w)]; exact congrArg gp_sin3 (Equiv.apply_symm_apply g w)⟩

lemma gp_σ_mem : gp_σ ∈ gp_Mor := by
  refine ⟨continuous_neg.add continuous_const, fun w => ?_⟩
  induction w using QuotientAddGroup.induction_on with | H x => ?_
  rw [gp_σ_apply, ← AddCircle.coe_neg, ← AddCircle.coe_add, gp_s3_coe, gp_s3_coe,
    show 3 * (-x + π / 3) = π - 3 * x by ring, Real.sin_pi_sub]

lemma gp_τ_mem : gp_τ ∈ gp_Mor := by
  refine ⟨continuous_id.add continuous_const, fun w => ?_⟩
  induction w using QuotientAddGroup.induction_on with | H x => ?_
  rw [gp_τ_apply, ← AddCircle.coe_add, gp_s3_coe, gp_s3_coe,
    show 3 * (x + 2 * π / 3) = 3 * x + ((1 : ℕ) : ℝ) * (2 * π) by push_cast; ring, Real.sin_add_nat_mul_two_pi]

/-- The two branches of `sin 3v = sin 3w`: `3(v − w) = 0` or `3(v + w) = π` on the circle. -/
lemma gp_branch (v w : gp_T) (h : gp_sin3 v = gp_sin3 w) :
    3 • (v - w) = 0 ∨ 3 • (v + w) = ((π : ℝ) : gp_T) := by
  induction v using QuotientAddGroup.induction_on with | H x => ?_
  induction w using QuotientAddGroup.induction_on with | H y => ?_
  change gp_sin3 (x : gp_T) = gp_sin3 (y : gp_T) at h
  rw [gp_s3_coe, gp_s3_coe] at h
  obtain ⟨k, hk | hk⟩ := Real.sin_eq_sin_iff.1 h.symm
  · left
    change 3 • ((x : gp_T) - (y : gp_T)) = 0
    rw [← AddCircle.coe_sub, ← AddCircle.coe_nsmul, nsmul_eq_mul]
    exact (AddCircle.coe_eq_zero_iff (p := 2 * π)).2 ⟨k, by rw [zsmul_eq_mul]; push_cast; linarith⟩
  · right
    change 3 • ((x : gp_T) + (y : gp_T)) = _
    rw [← AddCircle.coe_add, ← AddCircle.coe_nsmul, nsmul_eq_mul,
      show ((3 : ℕ) : ℝ) * (x + y) = π + (k : ℝ) * (2 * π) by push_cast; linarith, gp_coe_add_int]

/-- The 3-torsion of the circle is `{e i}`. -/
lemma gp_tors0 (v : gp_T) (h : 3 • v = 0) : ∃ i : ZMod 3, v = gp_e 3 _ gp_c3 i := by
  induction v using QuotientAddGroup.induction_on with | H x => ?_
  change 3 • (x : gp_T) = 0 at h
  rw [← AddCircle.coe_nsmul, AddCircle.coe_eq_zero_iff] at h
  obtain ⟨m, hm⟩ := h
  rw [zsmul_eq_mul, nsmul_eq_mul] at hm
  obtain ⟨j, hj⟩ := gp_val_lift (x := (m : ZMod 3)) (y := m) rfl
  refine ⟨m, ?_⟩
  rw [gp_e_apply, hj]
  change (x : gp_T) = (((m + 3 * j : ℝ) * (2 * π / 3) : ℝ) : gp_T)
  rw [show ((m : ℝ) + 3 * j) * (2 * π / 3) = x + (j : ℝ) * (2 * π) by push_cast at hm ⊢; linarith,
    gp_coe_add_int]

/-- The solutions of `3v = π` are `{π/3 − e i}`. -/
lemma gp_torsπ (v : gp_T) (h : 3 • v = ((π : ℝ) : gp_T)) :
    ∃ i : ZMod 3, v = ((π / 3 : ℝ) : gp_T) - gp_e 3 _ gp_c3 i := by
  have h3 : 3 • ((π / 3 : ℝ) : gp_T) = ((π : ℝ) : gp_T) := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]; congr 1; push_cast; ring
  obtain ⟨j, hj⟩ := gp_tors0 (v - ((π / 3 : ℝ) : gp_T)) (by rw [nsmul_sub, h, h3, sub_self])
  exact ⟨-j, by rw [map_neg, sub_neg_eq_add, ← hj]; abel⟩

/-- A continuous map with values in a finite set is constant on a preconnected set. -/
lemma gp_const {S : Set ℝ} (hS : IsPreconnected S) {F : ℝ → gp_T} (hF : Continuous F) {T : Set gp_T}
    (hT : T.Finite) (hm : ∀ t ∈ S, F t ∈ T) {s t : ℝ} (hs : s ∈ S) (ht : t ∈ S) : F s = F t := by
  exact hS.constant_of_mapsTo hT.isDiscrete hF.continuousOn hm hs ht

/-- Crossing points are `π/3` apart: if `6s = 6t = π` on the circle and `|s − t| < π/3` then `s = t`. -/
lemma gp_cross_sep {s t : ℝ} (hs : 6 • (s : gp_T) = ((π : ℝ) : gp_T)) (ht : 6 • (t : gp_T) = ((π : ℝ) : gp_T))
    (hst : |s - t| < π / 3) : s = t := by
  have h : ((6 * (s - t) : ℝ) : gp_T) = 0 := by
    rw [show 6 * (s - t) = ((6 : ℕ) : ℝ) * s - ((6 : ℕ) : ℝ) * t by push_cast; ring, AddCircle.coe_sub,
      ← nsmul_eq_mul, ← nsmul_eq_mul, AddCircle.coe_nsmul, AddCircle.coe_nsmul, hs, ht, sub_self]
  obtain ⟨m, hm⟩ := (AddCircle.coe_eq_zero_iff (p := 2 * π)).1 h
  rw [zsmul_eq_mul] at hm
  have hπ := Real.pi_pos
  rw [abs_lt] at hst
  have a : (m : ℝ) < 1 := by nlinarith
  have b : (-1 : ℝ) < m := by nlinarith
  have hm0 : m = 0 := by
    have : m < 1 := by exact_mod_cast a
    have : -1 < m := by exact_mod_cast b
    omega
  subst hm0; simp at hm; linarith

lemma gp_six (G w : gp_T) (ha : 3 • (G - w) = 0) (hb : 3 • (G + w) = ((π : ℝ) : gp_T)) :
    6 • w = ((π : ℝ) : gp_T) := by
  rw [← hb, show (6 : ℕ) = 3 + 3 from rfl, add_nsmul]
  have : 3 • (G + w) = 3 • (G - w) + 3 • w + 3 • w := by rw [nsmul_sub, nsmul_add]; abel
  rw [this, ha, zero_add]

/-- **Row 5, `prop:completeness`.** Every continuous bijection `g` of `ℝ/2πℤ` with `sin 3g(w) = sin 3w` lies in
`⟨σ, τ⟩`: the morphism group is exactly `⟨σ, τ⟩ ≃* D₃ ≃* S₃`. -/
theorem gp_completeness : gp_Mor = Subgroup.closure {gp_σ, gp_τ} := by
  refine le_antisymm ?_ ((Subgroup.closure_le _).2 (by
    rintro x (rfl | rfl); exacts [gp_σ_mem, gp_τ_mem]))
  intro g hg
  rw [← gp_φ_range]
  have hπ := Real.pi_pos
  set G : ℝ → gp_T := fun t => g (t : gp_T) with hGdef
  have hc : Continuous (fun t : ℝ => (t : gp_T)) := continuous_quotient_mk'
  have hG : Continuous G := hg.1.comp hc
  set Sa : Set ℝ := {t | 3 • (G t - t) = 0}
  set Sb : Set ℝ := {t | 3 • (G t + t) = ((π : ℝ) : gp_T)}
  have cA : Continuous fun t => G t - (t : gp_T) := hG.sub hc
  have cB : Continuous fun t => G t + (t : gp_T) := hG.add hc
  have hSa : IsClosed Sa := isClosed_eq ((continuous_nsmul 3).comp cA) continuous_const
  have hSb : IsClosed Sb := isClosed_eq ((continuous_nsmul 3).comp cB) continuous_const
  have hcov : ∀ t, t ∈ Sa ∨ t ∈ Sb := fun t => gp_branch (G t) t (hg.2 t)
  have hTa : (Set.range (gp_e 3 _ gp_c3)).Finite := Set.finite_range _
  have hTb : (Set.range fun i => ((π / 3 : ℝ) : gp_T) - gp_e 3 _ gp_c3 i).Finite := Set.finite_range _
  have constA : ∀ {S : Set ℝ}, IsPreconnected S → S ⊆ Sa → ∀ {s t}, s ∈ S → t ∈ S →
      G s - (s : gp_T) = G t - t := fun {_} hS hSS {_ _} hs ht =>
    gp_const hS cA hTa (fun t ht => by obtain ⟨i, hi⟩ := gp_tors0 _ (hSS ht); exact ⟨i, hi.symm⟩) hs ht
  have constB : ∀ {S : Set ℝ}, IsPreconnected S → S ⊆ Sb → ∀ {s t}, s ∈ S → t ∈ S →
      G s + (s : gp_T) = G t + t := fun {_} hS hSS {_ _} hs ht =>
    gp_const hS cB hTb (fun t ht => by obtain ⟨i, hi⟩ := gp_torsπ _ (hSS ht); exact ⟨i, hi.symm⟩) hs ht
  -- the side intervals lie in one branch
  have side : ∀ {I : Set ℝ}, IsPreconnected I → (∀ s ∈ I, s ∉ Sa ∩ Sb) → I ⊆ Sa ∨ I ⊆ Sb := by
    intro I hI hI'
    exact isPreconnected_iff_subset_of_disjoint_closed.1 hI Sa Sb hSa hSb (fun t _ => hcov t)
      (Set.eq_empty_iff_forall_notMem.2 fun t ⟨htI, ht⟩ => hI' t htI ht)
  have sep : ∀ t₀ ∈ Sa ∩ Sb, ∀ s, |s - t₀| < π / 3 → s ∈ Sa ∩ Sb → s = t₀ := by
    intro t₀ ht₀ s hs hs'
    exact gp_cross_sep (gp_six _ _ hs'.1 hs'.2) (gp_six _ _ ht₀.1 ht₀.2) hs
  -- injectivity forbids a switch at a crossing point
  have inj : ∀ t₀ : ℝ, G (t₀ + π / 12) ≠ G (t₀ - π / 12) := by
    intro t₀ h
    have h' := g.injective h
    have : ((π / 6 : ℝ) : gp_T) = 0 := by
      rw [show π / 6 = (t₀ + π / 12) - (t₀ - π / 12) by ring, AddCircle.coe_sub, h', sub_self]
    exact gp_coe_ne_zero (by positivity) (by linarith) this
  have hcover : ∀ t₀, t₀ ∈ interior Sa ∨ t₀ ∈ interior Sb := by
    intro t₀
    by_cases hb : t₀ ∈ Sb
    · by_cases ha : t₀ ∈ Sa
      · have hR := side (I := Set.Ioo t₀ (t₀ + π / 6)) isPreconnected_Ioo (fun s hs hs' =>
          (ne_of_gt hs.1) (sep t₀ ⟨ha, hb⟩ s (by rw [abs_lt]; constructor <;> linarith [hs.1, hs.2]) hs'))
        have hL := side (I := Set.Ioo (t₀ - π / 6) t₀) isPreconnected_Ioo (fun s hs hs' =>
          (ne_of_lt hs.2) (sep t₀ ⟨ha, hb⟩ s (by rw [abs_lt]; constructor <;> linarith [hs.1, hs.2]) hs'))
        have fullset : ∀ {X : Set ℝ}, t₀ ∈ X → Set.Ioo t₀ (t₀ + π / 6) ⊆ X → Set.Ioo (t₀ - π / 6) t₀ ⊆ X →
            t₀ ∈ interior X := by
          intro X h0 hR hL
          refine mem_interior.2 ⟨Set.Ioo (t₀ - π / 6) (t₀ + π / 6), fun s hs => ?_, isOpen_Ioo,
            ⟨by linarith, by linarith⟩⟩
          rcases lt_trichotomy s t₀ with h | rfl | h
          exacts [hL ⟨hs.1, h⟩, h0, hR ⟨h, hs.2⟩]
        have hp : t₀ + π / 12 ∈ Set.Ioo t₀ (t₀ + π / 6) := ⟨by linarith, by linarith⟩
        have hm : t₀ - π / 12 ∈ Set.Ioo (t₀ - π / 6) t₀ := ⟨by linarith, by linarith⟩
        rcases hR with hR | hR <;> rcases hL with hL | hL
        · exact Or.inl (fullset ha hR hL)
        · -- right in `Sa`, left in `Sb`: the map folds at `t₀`
          exfalso
          have e1 := constA (S := Set.Ico t₀ (t₀ + π / 6)) isPreconnected_Ico
            (fun s hs => by rcases eq_or_lt_of_le hs.1 with rfl | h; exacts [ha, hR ⟨h, hs.2⟩])
            (s := t₀ + π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨le_refl _, by linarith⟩
          have e2 := constB (S := Set.Ioc (t₀ - π / 6) t₀) isPreconnected_Ioc
            (fun s hs => by rcases eq_or_lt_of_le hs.2 with rfl | h; exacts [hb, hL ⟨hs.1, h⟩])
            (s := t₀ - π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨by linarith, le_refl _⟩
          apply inj t₀
          have q1 : G (t₀ + π / 12) = G t₀ + ((π / 12 : ℝ) : gp_T) := by
            rw [sub_eq_iff_eq_add] at e1; rw [e1, AddCircle.coe_add]; abel
          have q2 : G (t₀ - π / 12) = G t₀ + ((π / 12 : ℝ) : gp_T) := by
            rw [← eq_sub_iff_add_eq] at e2; rw [e2, AddCircle.coe_sub]; abel
          rw [q1, q2]
        · -- right in `Sb`, left in `Sa`: the map folds at `t₀`
          exfalso
          have e1 := constB (S := Set.Ico t₀ (t₀ + π / 6)) isPreconnected_Ico
            (fun s hs => by rcases eq_or_lt_of_le hs.1 with rfl | h; exacts [hb, hR ⟨h, hs.2⟩])
            (s := t₀ + π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨le_refl _, by linarith⟩
          have e2 := constA (S := Set.Ioc (t₀ - π / 6) t₀) isPreconnected_Ioc
            (fun s hs => by rcases eq_or_lt_of_le hs.2 with rfl | h; exacts [ha, hL ⟨hs.1, h⟩])
            (s := t₀ - π / 12) ⟨by linarith, by linarith⟩ (t := t₀) ⟨by linarith, le_refl _⟩
          apply inj t₀
          have q1 : G (t₀ + π / 12) = G t₀ - ((π / 12 : ℝ) : gp_T) := by
            rw [← eq_sub_iff_add_eq] at e1; rw [e1, AddCircle.coe_add]; abel
          have q2 : G (t₀ - π / 12) = G t₀ - ((π / 12 : ℝ) : gp_T) := by
            rw [sub_eq_iff_eq_add] at e2; rw [e2, AddCircle.coe_sub]; abel
          rw [q1, q2]
        · exact Or.inr (fullset hb hR hL)
      · exact Or.inr (mem_interior.2 ⟨Saᶜ, fun s hs => (hcov s).resolve_left hs, hSa.isOpen_compl, ha⟩)
    · exact Or.inl (mem_interior.2 ⟨Sbᶜ, fun s hs => (hcov s).resolve_right hs, hSb.isOpen_compl, hb⟩)
  have hdisj : ∀ t, t ∈ interior Sa → t ∉ interior Sb := by
    intro t ha hb
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 ((isOpen_interior.inter isOpen_interior).mem_nhds ⟨ha, hb⟩)
    set δ := min (ε / 2) (π / 6)
    have hδ : 0 < δ := lt_min (by linarith) (by positivity)
    have hδ1 : δ ≤ ε / 2 := min_le_left _ _
    have hδ2 : δ ≤ π / 6 := min_le_right _ _
    have hm : t + δ ∈ interior Sa ∩ interior Sb :=
      hball (by rw [Metric.mem_ball, Real.dist_eq, show t + δ - t = δ by ring, abs_of_pos hδ]; linarith)
    have := sep t ⟨interior_subset ha, interior_subset hb⟩ (t + δ)
      (by rw [show t + δ - t = δ by ring, abs_of_pos hδ]; linarith)
      ⟨interior_subset hm.1, interior_subset hm.2⟩
    linarith
  have hclopen : IsClopen (interior Sa) := by
    refine ⟨?_, isOpen_interior⟩
    have : (interior Sa)ᶜ = interior Sb := Set.ext fun t =>
      ⟨fun h => (hcover t).resolve_left h, fun h h' => hdisj t h' h⟩
    rw [← isOpen_compl_iff, this]; exact isOpen_interior
  have hsurj : ∀ w : gp_T, ∃ t : ℝ, (t : gp_T) = w := fun w => QuotientAddGroup.mk_surjective w
  rcases isClopen_iff.1 hclopen with h | h
  · -- every point on the reflection branch
    have hB : ∀ t, t ∈ Sb := fun t => interior_subset ((hcover t).resolve_left (by rw [h]; exact id))
    obtain ⟨i, hi⟩ := gp_torsπ _ (hB 0)
    refine ⟨.sr i, Equiv.ext fun w => ?_⟩
    obtain ⟨t, rfl⟩ := hsurj w
    have e := constB isPreconnected_univ (fun t _ => hB t) (s := t) (t := 0) trivial trivial
    rw [hi, eq_sub_iff_add_eq] at e
    change -(t : gp_T) + (((π / 3 : ℝ) : gp_T) - gp_e 3 _ gp_c3 i) = G t
    rw [← e]; abel
  · -- every point on the rotation branch
    have hA : ∀ t, t ∈ Sa := fun t => interior_subset (by rw [h]; trivial)
    obtain ⟨i, hi⟩ := gp_tors0 _ (hA 0)
    refine ⟨.r i, Equiv.ext fun w => ?_⟩
    obtain ⟨t, rfl⟩ := hsurj w
    have e := constA isPreconnected_univ (fun t _ => hA t) (s := t) (t := 0) trivial trivial
    rw [hi, sub_eq_iff_eq_add] at e
    change (t : gp_T) + gp_e 3 _ gp_c3 i = G t
    rw [e]; abel

/-- **Rows 1 and 5.** The morphism group is `D₃`: `gp_Mor ≃* DihedralGroup 3`, of order 6, and it is non-trivial
(`σ ∈ gp_Mor`, `σ ≠ 1`). -/
noncomputable def gp_Mor_D3 : gp_Mor ≃* DihedralGroup 3 :=
  (MulEquiv.subgroupCongr gp_completeness).trans gp_D3

theorem gp_Mor_card : Nat.card gp_Mor = 6 ∧ gp_σ ∈ gp_Mor ∧ gp_σ ≠ 1 :=
  ⟨by rw [Nat.card_congr gp_Mor_D3.toEquiv, DihedralGroup.nat_card], gp_σ_mem, gp_σ_sq.2⟩

end ShadowProbe.GroupoidProbe

/-! ## Campaign 129: the monodromy (rows 11, 12)

The section below is campaign `Row18Monodromy.lean` copied verbatim (its namespace and every name kept), so P5's
names stay in one file. -/

section Row18Copy

open Polynomial

namespace ShadowProbe.Row18Monodromy

attribute [local instance] Polynomial.Gal.splits_ℚ_ℂ

/-! ## Route A: the Galois group of the `E = 0`, `M = 1` member `X³ − X + 2` is `S₃`. -/

/-- The family cubic `r³ + (E² − 1) r + 2M` at the rational specialisation `E = 0`, `M = 1`. -/
noncomputable def cubicQ : ℚ[X] := X ^ 3 - X + C 2

lemma cubicQ_natDegree : cubicQ.natDegree = 3 := by
  unfold cubicQ; compute_degree!

lemma cubicQ_ne_zero : cubicQ ≠ 0 := by
  intro h; have := cubicQ_natDegree; rw [h] at this; simp at this

lemma cubicQ_aeval {K : Type*} [Field K] [Algebra ℚ K] (x : K) :
    aeval x cubicQ = x ^ 3 - x + 2 := by
  simp [cubicQ]

/-- No rational root (rational root theorem: a root of the monic integer cubic is an integer). -/
lemma cubicQ_no_root (x : ℚ) : ¬ IsRoot cubicQ x := by
  intro hx
  have hx' : x ^ 3 - x + 2 = 0 := by
    have : eval x cubicQ = x ^ 3 - x + 2 := by simp [cubicQ]
    rw [← this]; exact hx
  let pZ : ℤ[X] := X ^ 3 - X + C 2
  have hmon : pZ.Monic := by unfold pZ; monicity!
  have hr : aeval x pZ = 0 := by
    simp only [pZ, map_add, map_sub, map_pow, aeval_X, map_ofNat]
    exact hx'
  obtain ⟨n, hn⟩ := isInteger_of_is_root_of_monic hmon hr
  have hn' : ((n : ℚ)) ^ 3 - n + 2 = 0 := by rw [← hn] at hx'; simpa using hx'
  have hz : n ^ 3 - n + 2 = 0 := by exact_mod_cast hn'
  have h1 : n ≤ 1 := by nlinarith [sq_nonneg (n - 1), sq_nonneg (n + 1)]
  have h2 : -2 ≤ n := by nlinarith [sq_nonneg (n - 1), sq_nonneg (n + 1)]
  interval_cases n <;> omega

theorem cubicQ_irreducible : Irreducible cubicQ :=
  irreducible_of_degree_le_three_of_not_isRoot (by rw [cubicQ_natDegree]; decide) cubicQ_no_root

/-- The discriminant `−4p³ − 27q²` at `p = −1`, `q = 2` is `−104 = 4((1 − 0²)³ − 27·1²)`: not a square in `ℚ`. -/
theorem cubicQ_disc_not_square :
    (-4 * (-1 : ℚ) ^ 3 - 27 * 2 ^ 2 = 4 * ((1 - 0 ^ 2) ^ 3 - 27 * 1 ^ 2)) ∧
      (-4 * (-1 : ℚ) ^ 3 - 27 * 2 ^ 2 = -104) ∧ ¬ ∃ d : ℚ, d ^ 2 = -104 := by
  refine ⟨by norm_num, by norm_num, ?_⟩
  rintro ⟨d, hd⟩; nlinarith [sq_nonneg d]

lemma cubicQ_card_complex : Fintype.card (cubicQ.rootSet ℂ) = 3 := by
  rw [← cubicQ_natDegree]
  simp_rw [rootSet_def, Finset.coe_sort_coe, Fintype.card_coe]
  rw [Multiset.toFinset_card_of_nodup, ← Splits.natDegree_eq_card_roots, natDegree_map]
  · exact IsAlgClosed.splits _
  · exact nodup_roots ((separable_map (algebraMap ℚ ℂ)).mpr cubicQ_irreducible.separable)

/-- At most one real root: a real root has `r < −1`, and two such cannot both satisfy `a² + ab + b² = 1`. -/
lemma cubicQ_card_real : Fintype.card (cubicQ.rootSet ℝ) ≤ 1 := by
  rw [Fintype.card_le_one_iff_subsingleton]
  constructor
  rintro ⟨a, ha⟩ ⟨b, hb⟩
  rw [mem_rootSet, cubicQ_aeval] at ha hb
  have ha' := ha.2; have hb' := hb.2
  have hneg : ∀ r : ℝ, r ^ 3 - r + 2 = 0 → r < -1 := by
    intro r hr
    by_contra hc; push Not at hc
    nlinarith [sq_nonneg (r - 1), sq_nonneg (r + 1), sq_nonneg r, mul_self_nonneg (r - 1 / 2)]
  have ha1 := hneg a ha'; have hb1 := hneg b hb'
  apply Subtype.ext
  by_contra hne
  have hsub : (a - b) * (a ^ 2 + a * b + b ^ 2 - 1) = 0 := by linear_combination ha' - hb'
  rcases mul_eq_zero.1 hsub with h | h
  · exact hne (by linarith)
  · nlinarith [mul_pos (neg_pos.2 (by linarith : a + 1 < 0)) (neg_pos.2 (by linarith : b + 1 < 0))]

/-- **Route A headline.** The Galois group of `X³ − X + 2` over `ℚ` acts as the full symmetric group on its
three complex roots: `galActionHom` is bijective, so `Gal ≃* S₃` and `|Gal| = 6`. -/
theorem cubicQ_gal_full :
    Function.Bijective (Gal.galActionHom cubicQ ℂ) ∧ Nat.card cubicQ.Gal = 6 := by
  have hb : Function.Bijective (Gal.galActionHom cubicQ ℂ) :=
    Gal.galActionHom_bijective_of_prime_degree' cubicQ_irreducible
      (by rw [cubicQ_natDegree]; norm_num)
      (by rw [cubicQ_card_complex]; have := cubicQ_card_real; omega)
      (by rw [cubicQ_card_complex]; omega)
  refine ⟨hb, ?_⟩
  rw [Nat.card_eq_of_bijective _ hb, Nat.card_perm, Nat.card_eq_fintype_card, cubicQ_card_complex]
  rfl

/-- `Gal(X³ − X + 2 / ℚ) ≃* S₃`. -/
noncomputable def cubicQ_gal_equiv : cubicQ.Gal ≃* Equiv.Perm (Fin 3) :=
  (MulEquiv.ofBijective _ cubicQ_gal_full.1).trans
    (Equiv.permCongrHom (Fintype.equivFinOfCardEq cubicQ_card_complex))

/-! ## Route B: the root cover over the punctured mass line and its monodromy.

At `E = 0` the cubic is `r³ − r + 2M` (the receipt's `2M = r₀ − r₀³`). Its roots over `M` are the fibre of
`massOf r = (r − r³)/2`. The branch locus is `27M² = 1`; `base` is its complement and `Cover` its preimage. -/

open Complex Set unitInterval ComplexConjugate

/-- `M` as a function of a root: `r³ − r + 2M = 0 ↔ M = (r − r³)/2`. -/
noncomputable def massOf (r : ℂ) : ℂ := (r - r ^ 3) / 2

/-- The punctured mass line: the complement of the branch locus `27M² = 1`. -/
def base : Set ℂ := {M | 27 * M ^ 2 ≠ 1}

/-- The total space of the root cover: roots lying over unbranched masses. -/
abbrev Cover : Set ℂ := massOf ⁻¹' base

/-- The root cover: a root `r` maps to its mass `M`. -/
noncomputable def proj : Cover → base := base.restrictPreimage massOf

@[simp] lemma proj_val (z : Cover) : ((proj z : base) : ℂ) = massOf z := rfl

lemma massOf_root_iff (r M : ℂ) : r ^ 3 - r + 2 * M = 0 ↔ massOf r = M := by
  unfold massOf; constructor <;> intro h
  · linear_combination (-1/2 : ℂ) * h
  · linear_combination -2 * h

/-- Over an unbranched mass every root is simple (`3r² ≠ 1`), so the three roots are distinct. -/
lemma simple_root {r : ℂ} (hr : r ∈ Cover) : 1 - 3 * r ^ 2 ≠ 0 := by
  intro h; apply hr
  show 27 * massOf r ^ 2 = 1
  have h3 : r ^ 2 = 1 / 3 := by linear_combination (-1/3 : ℂ) * h
  unfold massOf
  have : (r - r ^ 3) ^ 2 = r ^ 2 * (1 - r ^ 2) ^ 2 := by ring
  rw [div_pow, this, h3]; norm_num

lemma massOf_eq_eval : massOf = fun r => (C (1 / 2 : ℂ) * (X - X ^ 3)).eval r := by
  funext r; simp [massOf]; ring

lemma massOf_isClosedMap : IsClosedMap massOf := by
  rw [massOf_eq_eval]; exact Polynomial.isClosedMap_eval _

lemma massOf_fibre_finite (M : ℂ) : (massOf ⁻¹' {M}).Finite := by
  have hne : (X ^ 3 - X + C (2 * M) : ℂ[X]) ≠ 0 := by
    intro h
    have h2 := congrArg (eval 2) h; have h0 := congrArg (eval 0) h
    simp at h2 h0; rw [h0] at h2; norm_num at h2
  refine (Polynomial.finite_setOfPred_isRoot hne).subset fun r hr => ?_
  simp only [mem_preimage, mem_singleton_iff] at hr
  simp only [mem_ofPred_eq, IsRoot, eval_add, eval_sub, eval_pow, eval_X, eval_C]
  exact (massOf_root_iff r M).2 hr

lemma massOf_hasStrictDerivAt (r : ℂ) : HasStrictDerivAt massOf ((1 - 3 * r ^ 2) / 2) r := by
  have h := ((hasStrictDerivAt_id r).fun_sub (hasStrictDerivAt_pow 3 r)).div_const 2
  convert h using 1
  funext x; simp [massOf]

/-- Inverse function theorem: `massOf` is a local homeomorphism at every point of the cover. -/
lemma massOf_isLocalHomeomorphOn : IsLocalHomeomorphOn massOf Cover := by
  refine IsLocalHomeomorphOn.mk _ _ fun r hr => ?_
  have hd : (1 - 3 * r ^ 2) / 2 ≠ 0 := div_ne_zero (simple_root hr) two_ne_zero
  let i : ℂ ≃L[ℂ] ℂ := .unitsEquivAut ℂ (.mk0 _ hd)
  have hfd : HasStrictFDerivAt massOf i.toContinuousLinearMap r := massOf_hasStrictDerivAt r
  exact ⟨hfd.toOpenPartialHomeomorph massOf, hfd.mem_toOpenPartialHomeomorph_source, fun _ _ => rfl⟩

/-- **The root map is a covering map** over the punctured mass line. -/
theorem proj_isCoveringMap : IsCoveringMap proj :=
  (massOf_isClosedMap.isCoveringMapOn_of_isLocalHomeomorphOn (fun M _ => massOf_fibre_finite M)
    massOf_isLocalHomeomorphOn).isCoveringMap_restrictPreimage

/-! ### The base point `M = 0` and its fibre `{0, 1, −1}` -/

def x₀ : base := ⟨0, by simp [base]⟩

lemma mem_fibre_iff (z : Cover) : z ∈ proj ⁻¹' {x₀} ↔ massOf z = 0 := by
  simp only [mem_preimage, mem_singleton_iff, Subtype.ext_iff, proj_val]; rfl

lemma fibre_massOf (z : proj ⁻¹' {x₀}) : massOf ((z : Cover) : ℂ) = 0 := (mem_fibre_iff _).1 z.2

lemma massOf_zero_cases {w : ℂ} (h : massOf w = 0) : w = 0 ∨ w = 1 ∨ w = -1 := by
  have : w * ((1 - w) * (1 + w)) = 0 := by unfold massOf at h; linear_combination 2 * h
  rcases mul_eq_zero.1 this with h | h
  · exact Or.inl h
  rcases mul_eq_zero.1 h with h | h
  · exact Or.inr (Or.inl (by linear_combination -h))
  · exact Or.inr (Or.inr (by linear_combination h))

lemma fibre_cases (z : proj ⁻¹' {x₀}) :
    ((z : Cover) : ℂ) = 0 ∨ ((z : Cover) : ℂ) = 1 ∨ ((z : Cover) : ℂ) = -1 :=
  massOf_zero_cases (fibre_massOf z)

lemma fibre_ext {z w : proj ⁻¹' {x₀}} (h : ((z : Cover) : ℂ) = ((w : Cover) : ℂ)) : z = w :=
  Subtype.ext (Subtype.ext h)

def e₀ : proj ⁻¹' {x₀} := ⟨⟨0, by simp [Cover, base, massOf]⟩, (mem_fibre_iff _).2 (by simp [massOf])⟩

/-! ### Symmetries: complex conjugation and `r ↦ −r` -/

lemma massOf_conj (r : ℂ) : massOf (conj r) = conj (massOf r) := by
  simp [massOf, map_ofNat]

lemma massOf_neg (r : ℂ) : massOf (-r) = -massOf r := by unfold massOf; ring

lemma conj_mem_base {M : ℂ} (h : M ∈ base) : conj M ∈ base := by
  intro h'; apply h
  have := congrArg conj h'; simpa [map_mul, map_pow, map_ofNat] using this

lemma neg_mem_base {M : ℂ} (h : M ∈ base) : -M ∈ base := by
  intro h'; apply h; simpa [base, neg_sq] using h'

def conjC (z : Cover) : Cover := ⟨conj (z : ℂ), by
  show massOf _ ∈ base; rw [massOf_conj]; exact conj_mem_base z.2⟩

def negC (z : Cover) : Cover := ⟨-(z : ℂ), by
  show massOf _ ∈ base; rw [massOf_neg]; exact neg_mem_base z.2⟩

lemma continuous_conjC : Continuous conjC :=
  continuous_induced_rng.2 (Complex.continuous_conj.comp continuous_subtype_val)

lemma continuous_negC : Continuous negC := continuous_induced_rng.2 continuous_subtype_val.neg

/-! ### The general swap criterion

If a loop `δ` at `M = 0` is conjugation-symmetric (`δ(1 − t) = conj δ(t)`), and its lift from the root `0` is
non-real at `t = 1/2`, then its monodromy is the transposition of `0` with the endpoint of that lift. -/

noncomputable def half : I := ⟨1 / 2, by norm_num, by norm_num⟩

lemma symm_half : σ half = half := Subtype.ext (by simp [half]; norm_num)

section swap

variable (δ : Path x₀ x₀)

/-- The lift of `δ` starting at the root `0`. -/
noncomputable def liftAt0 : C(I, Cover) :=
  proj_isCoveringMap.liftPath δ (e₀ : Cover) (δ.source.trans e₀.2.symm)

lemma liftAt0_massOf (t : I) : massOf (liftAt0 δ t : ℂ) = (δ t : ℂ) := by
  have := congrFun (proj_isCoveringMap.liftPath_lifts δ (e₀ : Cover) (δ.source.trans e₀.2.symm)) t
  exact congrArg Subtype.val this

lemma liftAt0_zero : liftAt0 δ 0 = (e₀ : Cover) := proj_isCoveringMap.liftPath_zero ..

/-- The monodromy of `δ` acting on the fibre over `M = 0`. -/
noncomputable def mono : proj ⁻¹' {x₀} → proj ⁻¹' {x₀} :=
  proj_isCoveringMap.monodromy (Path.Homotopic.Quotient.mk δ)

lemma mono_e₀ : ((mono δ e₀ : Cover) : ℂ) = (liftAt0 δ 1 : ℂ) := by
  rw [mono, proj_isCoveringMap.coe_monodromy_mk]; rfl

theorem mono_swap (hsym : ∀ t, (δ (σ t) : ℂ) = conj (δ t : ℂ)) (hhalf : (liftAt0 δ half : ℂ).im ≠ 0) :
    mono δ e₀ ≠ e₀ ∧ mono δ (mono δ e₀) = e₀ := by
  set Γ := liftAt0 δ
  -- the conjugate-reversed lift
  let Γ' : C(I, Cover) := ⟨fun t => conjC (Γ (σ t)), continuous_conjC.comp (Γ.continuous.comp continuous_symm)⟩
  have hΓ' : proj ∘ Γ' = δ := by
    funext t; apply Subtype.ext
    simp only [Function.comp_apply, proj_val, Γ', ContinuousMap.coe_mk, conjC]
    rw [massOf_conj, liftAt0_massOf, hsym, Complex.conj_conj]
  have hΓ : proj ∘ Γ = δ := proj_isCoveringMap.liftPath_lifts ..
  have hreal : ∀ z : proj ⁻¹' {x₀}, conj ((z : Cover) : ℂ) = ((z : Cover) : ℂ) := fun z => by
    rcases fibre_cases z with h | h | h <;> rw [h] <;> simp
  have hend : (Γ 1 : ℂ) = ((mono δ e₀ : Cover) : ℂ) := (mono_e₀ δ).symm
  have hΓ'0 : Γ' 0 = (mono δ e₀ : Cover) := by
    apply Subtype.ext
    show conj (Γ (σ 0) : ℂ) = _
    rw [symm_zero, hend, hreal]
  have hΓ'1 : (Γ' 1 : ℂ) = 0 := by
    show conj (Γ (σ 1) : ℂ) = 0
    rw [symm_one, liftAt0_zero]; simp [e₀]
  refine ⟨fun heq => hhalf ?_, ?_⟩
  · -- if the lift closed up, uniqueness of lifts would force `Γ' = Γ`, making `Γ(1/2)` real
    have h0 : Γ' 0 = Γ 0 := by rw [hΓ'0, heq, liftAt0_zero]
    have := proj_isCoveringMap.eq_of_comp_eq Γ'.continuous Γ.continuous (hΓ'.trans hΓ.symm) 0 h0
    have hh := congrArg (fun g => ((g half : Cover) : ℂ)) this
    simp only [Γ', ContinuousMap.coe_mk, conjC, symm_half] at hh
    have := congrArg Complex.im hh
    simp at this; linarith
  · apply fibre_ext
    have := proj_isCoveringMap.monodromy_eq_apply_one (γ := δ) (e := mono δ e₀) (Γ := Γ') hΓ' hΓ'0
    show ((proj_isCoveringMap.monodromy (Path.Homotopic.Quotient.mk δ) (mono δ e₀) : Cover) : ℂ) = _
    rw [this, hΓ'1]; rfl

end swap

/-! ### The explicit loop around the branch point `M = +1/√27`

`γ(t) = 4t(1 − t) + i·t(1 − t)(1 − 2t)`: it leaves `0` into the upper half-plane, crosses the real axis at
`M = 1 > 1/√27`, and returns through the lower half-plane. It is conjugation-symmetric. -/

noncomputable def γc (t : ℝ) : ℂ := ((4 * t * (1 - t) : ℝ) : ℂ) + ((t * (1 - t) * (1 - 2 * t) : ℝ) : ℂ) * Complex.I

@[simp] lemma γc_re (t : ℝ) : (γc t).re = 4 * t * (1 - t) := by simp [γc]
@[simp] lemma γc_im (t : ℝ) : (γc t).im = t * (1 - t) * (1 - 2 * t) := by simp [γc]

lemma γc_cont : Continuous γc := by unfold γc; fun_prop

lemma γc_mem (t : ℝ) : γc t ∈ base := by
  intro h
  rw [Complex.ext_iff] at h
  simp only [sq, Complex.mul_re, Complex.mul_im, Complex.re_ofNat, Complex.im_ofNat, γc_re, γc_im,
    Complex.one_re, Complex.one_im] at h
  obtain ⟨h1, h2⟩ := h
  have hab : (4 * t * (1 - t)) * (t * (1 - t) * (1 - 2 * t)) = 0 := by nlinarith
  rcases mul_eq_zero.1 hab with ha | hb
  · rw [ha] at h1; nlinarith [sq_nonneg (t * (1 - t) * (1 - 2 * t))]
  · rw [hb] at h1
    rcases mul_eq_zero.1 hb with hb | hb
    · rcases mul_eq_zero.1 hb with hb | hb
      · rw [hb] at h1; norm_num at h1
      · have : t = 1 := by linarith
        rw [this] at h1; norm_num at h1
    · have : t = 1 / 2 := by linarith
      rw [this] at h1; norm_num at h1

/-- The loop `γ` in the punctured mass line, based at `M = 0`. -/
noncomputable def loopPlus : Path x₀ x₀ where
  toFun t := ⟨γc t, γc_mem t⟩
  continuous_toFun := (γc_cont.comp continuous_subtype_val).subtype_mk _
  source' := Subtype.ext (by simp [γc, x₀])
  target' := Subtype.ext (by simp [γc, x₀])

/-- The mirror loop `−γ`, around the other branch point `M = −1/√27`. -/
noncomputable def loopMinus : Path x₀ x₀ where
  toFun t := ⟨-γc t, neg_mem_base (γc_mem t)⟩
  continuous_toFun := ((γc_cont.comp continuous_subtype_val).neg).subtype_mk _
  source' := Subtype.ext (by simp [γc, x₀])
  target' := Subtype.ext (by simp [γc, x₀])

lemma γc_symm (t : I) : γc (σ t) = conj (γc t) := by
  apply Complex.ext <;> simp [unitInterval.coe_symm_eq] <;> ring

lemma massOf_im (z : ℂ) : (massOf z).im = z.im * (1 - 3 * z.re ^ 2 + z.im ^ 2) / 2 := by
  simp [massOf, pow_succ, Complex.mul_re, Complex.mul_im]; ring

lemma massOf_re (z : ℂ) : (massOf z).re = (z.re - (z.re ^ 3 - 3 * z.re * z.im ^ 2)) / 2 := by
  simp [massOf, pow_succ, Complex.mul_re, Complex.mul_im]; ring

/-- **The half-plane argument.** A continuous lift `g` of `γ` from the root `0` stays in the component
`{Im r > 0, 3(Re r)² − (Im r)² < 1}` of the preimage of the upper half-plane while `γ` is there, so at `t = 1/2`
(where `γ = 1`) it is not real: the real root over `M = 1` lies outside that component's closure. -/
theorem lift_half_nonreal (g : I → ℂ) (hg : Continuous g) (h0 : g 0 = 0)
    (hl : ∀ t : I, massOf (g t) = γc t) : (g half).im ≠ 0 := by
  let h : ℝ → ℂ := g ∘ projIcc (0 : ℝ) 1 zero_le_one
  have hq : Continuous fun z : ℂ => 3 * z.re ^ 2 - z.im ^ 2 :=
    ((continuous_re.pow 2).const_mul 3).sub (continuous_im.pow 2)
  have hc : Continuous h := hg.comp continuous_projIcc
  have hl' : ∀ t ∈ Icc (0 : ℝ) 1, massOf (h t) = γc t := fun t ht => by
    simp only [h, Function.comp_apply, projIcc_of_mem _ ht]; exact hl _
  let U₀ : Set ℂ := {z | 0 < z.im ∧ 3 * z.re ^ 2 - z.im ^ 2 < 1}
  let U₁ : Set ℂ := {z | z.im < 0 ∧ 1 < 3 * z.re ^ 2 - z.im ^ 2}
  have hU₀ : IsOpen U₀ := (isOpen_lt continuous_const continuous_im).inter
    (isOpen_lt hq continuous_const)
  have hU₁ : IsOpen U₁ := (isOpen_lt continuous_im continuous_const).inter
    (isOpen_lt continuous_const hq)
  have hdisj : Disjoint U₀ U₁ := Set.disjoint_left.2 fun z h₀ h₁ => by linarith [h₀.1, h₁.1]
  have hsub : h '' Ioo 0 (1 / 2) ⊆ U₀ ∪ U₁ := by
    rintro _ ⟨t, ht, rfl⟩
    have hpos : 0 < (massOf (h t)).im := by
      rw [hl' t ⟨ht.1.le, by linarith [ht.2]⟩, γc_im]
      exact mul_pos (mul_pos ht.1 (by linarith [ht.2])) (by linarith [ht.2])
    rw [massOf_im] at hpos
    have : 0 < (h t).im * (1 - 3 * (h t).re ^ 2 + (h t).im ^ 2) := by linarith
    rcases pos_and_pos_or_neg_and_neg_of_mul_pos this with ⟨a, b⟩ | ⟨a, b⟩
    · exact Or.inl ⟨a, by linarith⟩
    · exact Or.inr ⟨a, by linarith⟩
  have hne : (h '' Ioo 0 (1 / 2) ∩ U₀).Nonempty := by
    have hW : IsOpen {z : ℂ | 3 * z.re ^ 2 - z.im ^ 2 < 1} := isOpen_lt hq continuous_const
    have h0' : h 0 = 0 := by simpa [h, projIcc_of_mem _ (⟨le_rfl, zero_le_one⟩ : (0:ℝ) ∈ Icc 0 1)] using h0
    have ev1 : ∀ᶠ t in nhdsWithin (0 : ℝ) (Ioi 0), h t ∈ {z : ℂ | 3 * z.re ^ 2 - z.im ^ 2 < 1} :=
      ((hc.tendsto 0).eventually (hW.mem_nhds (by simp [h0']))).filter_mono nhdsWithin_le_nhds
    have ev2 : ∀ᶠ t in nhdsWithin (0 : ℝ) (Ioi 0), t ∈ Ioo (0 : ℝ) (1 / 2) := Ioo_mem_nhdsGT (by norm_num)
    obtain ⟨t, ht1, ht2⟩ := (ev1.and ev2).exists
    refine ⟨h t, ⟨t, ht2, rfl⟩, ?_⟩
    rcases hsub ⟨t, ht2, rfl⟩ with h' | h'
    · exact h'
    · exact absurd h'.2 (by simp only [mem_ofPred_eq] at ht1; linarith)
  have hin : h '' Ioo 0 (1 / 2) ⊆ U₀ :=
    (isPreconnected_Ioo.image h hc.continuousOn).subset_left_of_subset_union hU₀ hU₁ hdisj hsub hne
  -- pass to the closure
  let Cl : Set ℂ := {z | 0 ≤ z.im ∧ 3 * z.re ^ 2 - z.im ^ 2 ≤ 1}
  have hCl : IsClosed (h ⁻¹' Cl) :=
    ((isClosed_le continuous_const continuous_im).inter
      (isClosed_le hq continuous_const)).preimage hc
  have hIoo : Ioo (0 : ℝ) (1 / 2) ⊆ h ⁻¹' Cl := fun t ht =>
    have := hin ⟨t, ht, rfl⟩; ⟨this.1.le, this.2.le⟩
  have hhalf : (1 / 2 : ℝ) ∈ h ⁻¹' Cl := by
    have := hCl.closure_subset_iff.2 hIoo
    rw [closure_Ioo (by norm_num)] at this
    exact this ⟨by norm_num, le_rfl⟩
  have hgh : h (1 / 2) = g half := by
    simp only [h, Function.comp_apply]
    rw [projIcc_of_mem _ (⟨by norm_num, by norm_num⟩ : (1 / 2 : ℝ) ∈ Icc (0 : ℝ) 1)]; rfl
  have hhalf' : g half ∈ Cl := hgh ▸ hhalf
  intro him
  obtain ⟨-, hb⟩ := hhalf'
  have hm := congrArg Complex.re (hl half)
  rw [massOf_re, him, γc_re, show ((half : I) : ℝ) = 1 / 2 from rfl] at hm
  rw [him] at hb
  have hx : (g half).re ^ 2 ≤ 1 / 3 := by linarith
  have e : (g half).re - (g half).re ^ 3 = 2 := by linear_combination 2 * hm
  have h4 : (g half).re ^ 2 * (1 - (g half).re ^ 2) ^ 2 = 4 := by
    linear_combination ((g half).re - (g half).re ^ 3 + 2) * e
  have hq1 : (1 - (g half).re ^ 2) ^ 2 ≤ 1 := by nlinarith [sq_nonneg (g half).re]
  nlinarith [mul_le_mul_of_nonneg_left hq1 (sq_nonneg (g half).re)]

/-! ### The two transpositions -/

lemma liftPlus_half : (liftAt0 loopPlus half : ℂ).im ≠ 0 :=
  lift_half_nonreal (fun t => (liftAt0 loopPlus t : ℂ)) (continuous_subtype_val.comp (liftAt0 loopPlus).continuous)
    (by rw [liftAt0_zero]; rfl) (fun t => by rw [liftAt0_massOf]; rfl)

lemma liftMinus_eq : liftAt0 loopMinus =
    ⟨fun t => negC (liftAt0 loopPlus t), continuous_negC.comp (liftAt0 loopPlus).continuous⟩ := by
  symm
  refine (proj_isCoveringMap.eq_liftPath_iff' _).2 ⟨funext fun t => Subtype.ext ?_, Subtype.ext ?_⟩
  · simp only [Function.comp_apply, proj_val, ContinuousMap.coe_mk, negC]
    rw [massOf_neg, liftAt0_massOf]; rfl
  · simp only [ContinuousMap.coe_mk, negC]; rw [liftAt0_zero]; simp [e₀]

theorem swap_plus : mono loopPlus e₀ ≠ e₀ ∧ mono loopPlus (mono loopPlus e₀) = e₀ :=
  mono_swap loopPlus (fun t => γc_symm t) liftPlus_half

theorem swap_minus : mono loopMinus e₀ ≠ e₀ ∧ mono loopMinus (mono loopMinus e₀) = e₀ := by
  refine mono_swap loopMinus (fun t => ?_) ?_
  · show -γc (σ t) = conj (-γc t); rw [γc_symm, map_neg]
  · rw [liftMinus_eq]; simp only [ContinuousMap.coe_mk, negC, neg_im, ne_eq, neg_eq_zero]
    exact liftPlus_half

lemma mono_minus_val : ((mono loopMinus e₀ : Cover) : ℂ) = -((mono loopPlus e₀ : Cover) : ℂ) := by
  rw [mono_e₀, mono_e₀, liftMinus_eq]; rfl

/-- A permutation of the fibre that swaps `a` and `b` and is a bijection fixes the third point: it is `swap a b`. -/
lemma eq_swap_of (g : Equiv.Perm (proj ⁻¹' {x₀})) (a b : proj ⁻¹' {x₀}) (ha : ((a : Cover) : ℂ) = 0)
    (hab : b ≠ a) (h1 : g a = b) (h2 : g b = a) : g = Equiv.swap a b := by
  ext z : 1
  by_cases hza : z = a
  · subst hza; simp [h1]
  by_cases hzb : z = b
  · subst hzb; simp [h2]
  rw [Equiv.swap_apply_of_ne_of_ne hza hzb]
  have hga : g z ≠ b := fun h => hza (g.injective (h.trans h1.symm))
  have hgb : g z ≠ a := fun h => hzb (g.injective (h.trans h2.symm))
  have va : ∀ w : proj ⁻¹' {x₀}, w ≠ a → ((w : Cover) : ℂ) ≠ 0 := fun w hw h =>
    hw (fibre_ext (h.trans ha.symm))
  have vb : ∀ w : proj ⁻¹' {x₀}, w ≠ b → ((w : Cover) : ℂ) ≠ ((b : Cover) : ℂ) := fun w hw h =>
    hw (fibre_ext h)
  apply fibre_ext
  have hb0 := va b hab
  rcases fibre_cases b with hb | hb | hb
  · exact absurd hb hb0
  all_goals
    rcases fibre_cases z with hz | hz | hz <;> rcases fibre_cases (g z) with hw | hw | hw <;>
    first
    | exact absurd hz (va z hza)
    | exact absurd hw (va _ hgb)
    | exact absurd (hz.trans hb.symm) (vb z hzb)
    | exact absurd (hw.trans hb.symm) (vb _ hga)
    | (rw [hz, hw])

/-! ### Headline: the monodromy group is all of `S₃` -/

/-- The fibre over `M = 0` is `{e₀, b, c}` = `{0, r*, −r*}`, with `b, c` the images of `e₀` under the two loops. -/
lemma fibre_facts :
    e₀ ≠ mono loopPlus e₀ ∧ e₀ ≠ mono loopMinus e₀ ∧ mono loopPlus e₀ ≠ mono loopMinus e₀ ∧
      ∀ z : proj ⁻¹' {x₀}, z = e₀ ∨ z = mono loopPlus e₀ ∨ z = mono loopMinus e₀ := by
  set b := mono loopPlus e₀
  set c := mono loopMinus e₀
  have hb := swap_plus
  have he0 : ((e₀ : Cover) : ℂ) = 0 := rfl
  have hbv : ((b : Cover) : ℂ) ≠ 0 := fun h => hb.1 (fibre_ext (h.trans he0.symm))
  have hcv : ((c : Cover) : ℂ) = -((b : Cover) : ℂ) := mono_minus_val
  refine ⟨fun h => hb.1 h.symm, fun h => hbv ?_, fun h => hbv ?_, fun z => ?_⟩
  · have := congrArg (fun w : proj ⁻¹' {x₀} => ((w : Cover) : ℂ)) h
    simp only [hcv, he0] at this; linear_combination this
  · have := congrArg (fun w : proj ⁻¹' {x₀} => ((w : Cover) : ℂ)) h
    simp only [hcv] at this; linear_combination this / 2
  rcases fibre_cases z with hz | hz | hz
  · exact Or.inl (fibre_ext (hz.trans he0.symm))
  all_goals rcases fibre_cases b with hb' | hb' | hb'
  all_goals first
    | exact absurd hb' hbv
    | exact Or.inr (Or.inl (fibre_ext (hz.trans hb'.symm)))
    | exact Or.inr (Or.inr (fibre_ext (by simp [hz, hcv, hb'])))

/-- The fibre over `M = 0`, enumerated. -/
lemma fibre_enum_bijective : Function.Bijective (![e₀, mono loopPlus e₀, mono loopMinus e₀]) := by
  obtain ⟨h1, h2, h3, hall⟩ := fibre_facts
  refine ⟨fun i j h => ?_, fun z => ?_⟩
  · fin_cases i <;> fin_cases j <;> simp at h ⊢
    all_goals first | exact h1 h | exact h2 h | exact h3 h | exact h1 h.symm | exact h2 h.symm | exact h3 h.symm
  · rcases hall z with h | h | h
    exacts [⟨0, h.symm⟩, ⟨1, h.symm⟩, ⟨2, h.symm⟩]

/-- **The cover is three-sheeted:** the fibre over `M = 0` has exactly three points. -/
theorem fibre_card : Nat.card (proj ⁻¹' {x₀}) = 3 := by
  rw [← Nat.card_eq_of_bijective _ fibre_enum_bijective]; simp

instance : Finite (proj ⁻¹' {x₀}) := Finite.of_surjective _ fibre_enum_bijective.2

/-- **Route B headline.** The monodromy action of the fundamental group of the punctured mass line
`ℂ ∖ {27M² = 1}`, based at `M = 0`, on the three roots `{0, 1, −1}` of `r³ − r` is onto the full
symmetric group of the fibre. -/
theorem monodromy_surjective : Function.Surjective (proj_isCoveringMap.monodromyPerm x₀) := by
  set mp := proj_isCoveringMap.monodromyPerm x₀
  obtain ⟨hab, hac, hbc, hall⟩ := fibre_facts
  set b := mono loopPlus e₀
  set c := mono loopMinus e₀
  have he0 : ((e₀ : Cover) : ℂ) = 0 := rfl
  have h1 : Equiv.swap e₀ b ∈ mp.range :=
    ⟨FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk loopPlus),
      eq_swap_of _ _ _ he0 (Ne.symm hab) rfl swap_plus.2⟩
  have h2 : Equiv.swap e₀ c ∈ mp.range :=
    ⟨FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk loopMinus),
      eq_swap_of _ _ _ he0 (Ne.symm hac) rfl swap_minus.2⟩
  have h3 : Equiv.swap b c ∈ mp.range := by
    have := mp.range.mul_mem (mp.range.mul_mem h1 h2) h1
    rwa [Equiv.swap_comm e₀ c, Equiv.swap_mul_swap_mul_swap hac.symm hbc.symm] at this
  have hrange : mp.range = ⊤ := by
    rw [eq_top_iff, ← Equiv.Perm.closure_isSwap, Subgroup.closure_le]
    rintro τ ⟨x, y, hxy, rfl⟩
    rcases hall x with rfl | rfl | rfl <;> rcases hall y with rfl | rfl | rfl <;>
      first
      | exact absurd rfl hxy
      | assumption
      | rwa [Equiv.swap_comm]
  exact MonoidHom.range_eq_top.1 hrange

/-- **The ROW object.** The monodromy group of the root cover (image of `π₁(ℂ ∖ {27M² = 1}, 0)` in the
permutations of the fibre) is `S₃`. -/
noncomputable def monodromyGroup_equiv_S3 :
    (proj_isCoveringMap.monodromyPerm x₀).range ≃* Equiv.Perm (Fin 3) :=
  ((MulEquiv.subgroupCongr (MonoidHom.range_eq_top.2 monodromy_surjective)).trans Subgroup.topEquiv).trans
    (Equiv.permCongrHom (Equiv.ofBijective _ fibre_enum_bijective).symm)

/-- The topological monodromy group and the Galois group of the `M = 1` member are abstractly isomorphic
(both `≃* S₃`). This is NOT the canonical identification (Riemann existence); see the report. -/
noncomputable def monodromy_equiv_gal :
    (proj_isCoveringMap.monodromyPerm x₀).range ≃* cubicQ.Gal :=
  monodromyGroup_equiv_S3.trans cubicQ_gal_equiv.symm

end ShadowProbe.Row18Monodromy

end Row18Copy

namespace ShadowProbe.GroupoidProbe

open ShadowProbe.Row18Monodromy

/-- **Row 11a.** The Nariai values `2M = ±2/(3√3)` are simple zeros of `Δ = 4 − 27(2M)²`: `Δ` vanishes there and
`dΔ/d(2M) = −54(2M) ≠ 0`. They are the points `27M² = 1` the cover's base omits. -/
theorem gp_nariai_simple :
    4 - 27 * (2 / (3 * Real.sqrt 3)) ^ 2 = 0 ∧ 4 - 27 * (-(2 / (3 * Real.sqrt 3))) ^ 2 = 0 ∧
      -54 * (2 / (3 * Real.sqrt 3)) ≠ 0 ∧ -54 * (-(2 / (3 * Real.sqrt 3))) ≠ 0 ∧
      (∀ m : ℝ, HasDerivAt (fun m => 4 - 27 * m ^ 2) (-54 * m) m) ∧
      27 * ((1 / (3 * Real.sqrt 3) : ℝ) : ℂ) ^ 2 = 1 := by
  have hs : 0 < Real.sqrt 3 := by positivity
  refine ⟨?_, ?_, by positivity, by simp, fun m => ?_, ?_⟩
  · field_simp; rw [gp_s3]; norm_num
  · field_simp; rw [gp_s3]; norm_num
  · exact (((hasDerivAt_pow 2 m).const_mul 27).const_sub 4).congr_deriv (by ring)
  · have : 27 * (1 / (3 * Real.sqrt 3)) ^ 2 = (1 : ℝ) := by field_simp; rw [gp_s3]; norm_num
    exact_mod_cast this

/-- **Row 11b.** The monodromy of each Nariai loop is a transposition, and the two transpose different pairs:
`loopPlus ↦ swap e₀ b`, `loopMinus ↦ swap e₀ c`, `b ≠ c` (`rem:monodromy-group`). -/
theorem gp_monodromy_swaps :
    proj_isCoveringMap.monodromyPerm x₀ (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk loopPlus)) =
        Equiv.swap e₀ (mono loopPlus e₀) ∧
      proj_isCoveringMap.monodromyPerm x₀ (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk loopMinus)) =
        Equiv.swap e₀ (mono loopMinus e₀) ∧
      e₀ ≠ mono loopPlus e₀ ∧ e₀ ≠ mono loopMinus e₀ ∧ mono loopPlus e₀ ≠ mono loopMinus e₀ := by
  obtain ⟨hab, hac, hbc, -⟩ := fibre_facts
  have he0 : ((e₀ : Cover) : ℂ) = 0 := rfl
  exact ⟨eq_swap_of _ _ _ he0 (Ne.symm hab) rfl swap_plus.2,
    eq_swap_of _ _ _ he0 (Ne.symm hac) rfl swap_minus.2, hab, hac, hbc⟩

/-- **Row 12b, the deck group.** A permutation of the fibre that commutes with every monodromy permutation is the
identity: the centraliser of the monodromy group is trivial. -/
theorem gp_deck_trivial (g : Equiv.Perm (proj ⁻¹' {x₀}))
    (hg : ∀ γ, g * proj_isCoveringMap.monodromyPerm x₀ γ = proj_isCoveringMap.monodromyPerm x₀ γ * g) :
    g = 1 := by
  obtain ⟨hab, hac, hbc, hall⟩ := fibre_facts
  by_contra hne
  obtain ⟨z, hz⟩ : ∃ z, g z ≠ z := by
    by_contra h; simp only [not_exists, ne_eq, not_not] at h; exact hne (Equiv.ext h)
  obtain ⟨w, hw1, hw2⟩ : ∃ w, w ≠ z ∧ w ≠ g z := by
    by_contra h
    simp only [not_exists, not_and, ne_eq, not_not] at h
    have h0 := h e₀; have h1 := h (mono loopPlus e₀); have h2 := h (mono loopMinus e₀)
    by_cases a0 : e₀ = z <;> by_cases a1 : mono loopPlus e₀ = z <;> by_cases a2 : mono loopMinus e₀ = z
    all_goals first
      | exact hab (a0.trans a1.symm) | exact hac (a0.trans a2.symm) | exact hbc (a1.trans a2.symm)
      | exact hab ((h0 a0).trans (h1 a1).symm) | exact hac ((h0 a0).trans (h2 a2).symm)
      | exact hbc ((h1 a1).trans (h2 a2).symm)
  obtain ⟨γ, hγ⟩ := monodromy_surjective (Equiv.swap z w)
  have := congrArg (fun f : Equiv.Perm (proj ⁻¹' {x₀}) => f z) (hg γ)
  simp only [Equiv.Perm.mul_apply, hγ, Equiv.swap_apply_left] at this
  rw [Equiv.swap_apply_of_ne_of_ne hz hw2.symm] at this
  exact hw1 (g.injective this)

/-- **Row 12b, not normal.** The monodromy group has order 6 on a fibre of 3 points, and it fixes `e₀` by a
non-identity element (`swap b c`), so it does not act regularly: the degree-3 cover is not normal. -/
theorem gp_not_normal :
    Nat.card (proj_isCoveringMap.monodromyPerm x₀).range = 6 ∧ Nat.card (proj ⁻¹' {x₀}) = 3 ∧
      ∃ h ∈ (proj_isCoveringMap.monodromyPerm x₀).range, h ≠ 1 ∧ h e₀ = e₀ := by
  obtain ⟨hab, hac, hbc, -⟩ := fibre_facts
  refine ⟨by rw [Nat.card_congr monodromyGroup_equiv_S3.toEquiv, Nat.card_perm]; simp [Nat.factorial], fibre_card,
    Equiv.swap (mono loopPlus e₀) (mono loopMinus e₀), monodromy_surjective _, ?_, ?_⟩
  · intro h
    have := congrArg (fun f : Equiv.Perm (proj ⁻¹' {x₀}) => f (mono loopPlus e₀)) h
    simp at this; exact hbc this.symm
  · exact Equiv.swap_apply_of_ne_of_ne hab hac

end ShadowProbe.GroupoidProbe

