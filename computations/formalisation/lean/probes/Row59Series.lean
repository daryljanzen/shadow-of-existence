/-- ⛭ **(E1) THE SERIES.** For any three derivations with `D_a u = u L_a`, the frame-Koszul scalar curvature of
`exp(εH4(u))` has coefficients `6, 0, R₂, R₃, R₄`, polynomials in `u` alone. -/
theorem frame_series (hu : ∀ a j, F.D a (u j) = ∑ k, u k * Lm a k j) :
    Scal F u 0 = (6) ∧ Scal F u 1 = 0 ∧ Scal F u 2 = (-10 * u 0 ^ 2 - 10 * u 1 ^ 2 - 4 * u 2 ^ 2) ∧
      Scal F u 3 = (-(4/3) * u 0 ^ 3 + 4 * u 0 * u 1 ^ 2) ∧ Scal F u 4 = (-5 * u 0 ^ 4 - 5 * u 1 ^ 4 - 10 * u 0 ^ 2 * u 1 ^ 2 - 2 * u 0 ^ 2 * u 2 ^ 2 - 2 * u 1 ^ 2 * u 2 ^ 2) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;>
    simp [Scal, Finset.sum_range_succ, Gik_0, Gik_1, Gik_2, Gik_3, Gik_4, Ric_0 F u hu, Ric_1 F u hu, Ric_2 F u hu, Ric_3 F u hu, Ric_4 F u hu, gikT0, ricT0, gikT1, ricT1, gikT2, ricT2, gikT3, ricT3, gikT4, ricT4, Fin.sum_univ_three] <;> ring


/-! ### (E2) the chart link -/

/-- `Rad`'s first row on the Euler chart (campaign 24's `Rad ψ θ φ 0 ·`) -/
noncomputable def uR (ψ θ φ : ℝ) : Fin 3 → ℝ :=
  ![cos φ * cos ψ - sin φ * sin ψ * cos θ, -(sin φ * cos ψ * cos θ) - sin ψ * cos φ, sin φ * sin θ]

/-- the left-invariant coframe `e = σ/2` (campaign 24's `eL`) -/
noncomputable def eL (ψ θ : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![0, cos ψ / 2, sin ψ * sin θ / 2; 0, -sin ψ / 2, cos ψ * sin θ / 2; 1 / 2, 0, cos θ / 2]

/-- the frame value `Σ_a (u L_a)_j σ^a` along coordinate `k` -/
noncomputable def frameD (ψ θ φ : ℝ) (k j : Fin 3) : ℝ :=
  ∑ a, (∑ m, uR ψ θ φ m * Lm a m j) * eL ψ θ a k

set_option linter.unusedSimpArgs false in
/-- ⛭ **(E2) THE CHART LINK.** On the Euler chart, `du_j = Σ_a (u L_a)_j σ^a` with real derivatives: the relation
(E1) assumes of its derivations is what the actual frame fields do to `Rad`'s first row. -/
theorem rad_row_frame (ψ θ φ : ℝ) (j : Fin 3) :
    HasDerivAt (fun x => uR x θ φ j) (frameD ψ θ φ 0 j) ψ ∧
      HasDerivAt (fun x => uR ψ x φ j) (frameD ψ θ φ 1 j) θ ∧
      HasDerivAt (fun x => uR ψ θ x j) (frameD ψ θ φ 2 j) φ := by
  have cψ := hasDerivAt_cos ψ; have sψ := hasDerivAt_sin ψ
  have cθ := hasDerivAt_cos θ; have sθ := hasDerivAt_sin θ
  have cφ := hasDerivAt_cos φ; have sφ := hasDerivAt_sin φ
  fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> refine ⟨?_, ?_, ?_⟩
  · convert (cψ.const_mul (cos φ)).sub ((sψ.const_mul (sin φ)).mul_const (cos θ)) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert (hasDerivAt_const θ (cos φ * cos ψ)).sub (cθ.const_mul (sin φ * sin ψ)) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert (cφ.mul_const (cos ψ)).sub ((sφ.mul_const (sin ψ)).mul_const (cos θ)) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert ((cψ.const_mul (sin φ)).mul_const (cos θ)).neg.sub (sψ.mul_const (cos φ)) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert (cθ.const_mul (sin φ * cos ψ)).neg.sub (hasDerivAt_const θ (sin ψ * cos φ)) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert ((sφ.mul_const (cos ψ)).mul_const (cos θ)).neg.sub (cφ.const_mul (sin ψ)) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert hasDerivAt_const ψ (sin φ * sin θ) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert sθ.const_mul (sin φ) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)
  · convert sφ.mul_const (sin θ) using 1 <;>
    first
      | (funext x; simp only [uR, Pi.sub_apply, Pi.neg_apply, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring1)
      | (simp [frameD, uR, Lm, eL, Fin.sum_univ_three] <;> ring_nf <;> simp only [Real.sin_sq] <;> ring1)

/-! ### (E3) the integrals -/

/-- the box integral with the round volume `sin θ / 8`, over `[0, 2π] × [0, π] × [0, 4π]` -/
noncomputable def box (P : (Fin 3 → ℝ) → ℝ) : ℝ :=
  ∫ ψ in (0 : ℝ)..2 * π, ∫ θ in (0 : ℝ)..π, ∫ φ in (0 : ℝ)..4 * π, P (uR ψ θ φ) * (sin θ / 8)

theorem sin_four_pi : sin (4 * π) = 0 := by
  rw [show (4 : ℝ) * π = ((4 : ℕ) : ℝ) * π by norm_num]; exact sin_nat_mul_pi 4

theorem i_phi (A B C : ℝ) :
    ∫ φ in (0 : ℝ)..4 * π, (A + B * sin φ ^ 2 + C * sin φ ^ 4) = 4 * π * A + 2 * π * B + 3 * π / 2 * C := by
  have h2 : ∫ φ in (0 : ℝ)..4 * π, sin φ ^ 2 = 2 * π := by
    rw [integral_sin_sq, sin_four_pi]; simp; ring
  have h4 : ∫ φ in (0 : ℝ)..4 * π, sin φ ^ 4 = 3 * π / 2 := by
    have := @integral_sin_pow 0 (4 * π) 2
    norm_num at this; rw [this, sin_four_pi]; ring
  rw [integral_add, integral_add, integral_const_mul, integral_const_mul, h2, h4]
  all_goals first | (simp; ring1) | (apply Continuous.intervalIntegrable; fun_prop)

theorem i_theta (A B C : ℝ) :
    ∫ θ in (0 : ℝ)..π, (A * sin θ + B * sin θ ^ 3 + C * sin θ ^ 5) = 2 * A + 4 / 3 * B + 16 / 15 * C := by
  have h1 : ∫ θ in (0 : ℝ)..π, sin θ = 2 := by rw [integral_sin]; norm_num
  have h3 : ∫ θ in (0 : ℝ)..π, sin θ ^ 3 = 4 / 3 := by
    have := @integral_sin_pow 0 π 1; norm_num at this ⊢
  have h5 : ∫ θ in (0 : ℝ)..π, sin θ ^ 5 = 16 / 15 := by
    have := @integral_sin_pow 0 π 3; norm_num at this ⊢; exact this
  rw [integral_add, integral_add, integral_const_mul, integral_const_mul, integral_const_mul, h1, h3, h5]
  all_goals first | ring1 | (apply Continuous.intervalIntegrable; fun_prop)

/-- an odd trigonometric polynomial integrates to zero over two periods -/
theorem odd_zero (f : ℝ → ℝ) (hp : Function.Periodic f (2 * π)) (ho : ∀ x, f (x + π) = -f x) :
    ∫ x in (0 : ℝ)..4 * π, f x = 0 := by
  have hp4 : Function.Periodic f (4 * π) := fun x => by
    rw [show 4 * π = 2 * π + 2 * π by ring, ← add_assoc, hp, hp]
  have e1 := Function.Periodic.intervalIntegral_add_eq hp4 0 π
  have e2 : ∫ x in π..π + 4 * π, f x = ∫ x in (0 : ℝ)..4 * π, f (x + π) := by
    rw [intervalIntegral.integral_comp_add_right]; simp [add_comm]
  simp only [zero_add] at e1
  rw [e2] at e1
  simp only [ho, intervalIntegral.integral_neg] at e1
  linarith

theorem row_unit (ψ θ φ : ℝ) : uR ψ θ φ 0 ^ 2 + uR ψ θ φ 1 ^ 2 = 1 - sin φ ^ 2 * sin θ ^ 2 := by
  simp [uR]
  linear_combination (cos φ ^ 2 + sin φ ^ 2 * cos θ ^ 2) * sin_sq_add_cos_sq ψ + sin φ ^ 2 * sin_sq_add_cos_sq θ
    + sin_sq_add_cos_sq φ

/-- ⛭ **(E3) THE INTEGRALS.** The five coefficients of (E1), at `u = Rad`'s first row, over the Euler box with the
round volume: `12π², 0, −16π², 0, −(88/15)π²`, the receipt's section E exactly. -/
theorem section_e_integrals :
    box (fun _ => 6) = 12 * π ^ 2 ∧ box (fun _ => 0) = 0 ∧
      box (fun u => -10 * u 0 ^ 2 - 10 * u 1 ^ 2 - 4 * u 2 ^ 2) = -16 * π ^ 2 ∧
      box (fun u => -(4/3) * u 0 ^ 3 + 4 * u 0 * u 1 ^ 2) = 0 ∧
      box (fun u => -5 * u 0 ^ 4 - 5 * u 1 ^ 4 - 10 * u 0 ^ 2 * u 1 ^ 2 - 2 * u 0 ^ 2 * u 2 ^ 2
        - 2 * u 1 ^ 2 * u 2 ^ 2) = -(88/15) * π ^ 2 := by
  refine ⟨?_, by simp [box], ?_, ?_, ?_⟩
  · simp [box, integral_sin]; ring
  · have hp : ∀ ψ θ φ : ℝ, (-10 * uR ψ θ φ 0 ^ 2 - 10 * uR ψ θ φ 1 ^ 2 - 4 * uR ψ θ φ 2 ^ 2) * (sin θ / 8)
        = (-(5 / 4) * sin θ + 3 / 4 * sin θ ^ 3 * sin φ ^ 2 + 0 * sin φ ^ 4) := fun ψ θ φ => by
      have := row_unit ψ θ φ; simp only [uR] at this ⊢; simp at this ⊢
      linear_combination (-10 / 8 * sin θ) * this
    simp only [box, hp, i_phi]
    have hq : ∀ θ : ℝ, 4 * π * (-(5 / 4) * sin θ) + 2 * π * (3 / 4 * sin θ ^ 3) + 3 * π / 2 * 0
        = (-5 * π) * sin θ + (3 / 2 * π) * sin θ ^ 3 + 0 * sin θ ^ 5 := fun θ => by ring
    simp only [hq, i_theta, integral_const]; simp; ring
  · have hz : ∀ ψ θ : ℝ, ∫ φ in (0 : ℝ)..4 * π,
        (-(4/3) * uR ψ θ φ 0 ^ 3 + 4 * uR ψ θ φ 0 * uR ψ θ φ 1 ^ 2) * (sin θ / 8) = 0 := by
      intro ψ θ
      apply odd_zero
      · intro x; simp [uR, sin_add_two_pi, cos_add_two_pi]
      · intro x; simp [uR, sin_add_pi, cos_add_pi]; ring
    simp only [box, hz, intervalIntegral.integral_zero]
  · have hp : ∀ ψ θ φ : ℝ, (-5 * uR ψ θ φ 0 ^ 4 - 5 * uR ψ θ φ 1 ^ 4 - 10 * uR ψ θ φ 0 ^ 2 * uR ψ θ φ 1 ^ 2
          - 2 * uR ψ θ φ 0 ^ 2 * uR ψ θ φ 2 ^ 2 - 2 * uR ψ θ φ 1 ^ 2 * uR ψ θ φ 2 ^ 2) * (sin θ / 8)
        = (-(5 / 8) * sin θ + sin θ ^ 3 * sin φ ^ 2 + (-(3 / 8) * sin θ ^ 5) * sin φ ^ 4) := fun ψ θ φ => by
      have h := row_unit ψ θ φ
      have e2 : uR ψ θ φ 2 = sin φ * sin θ := by simp [uR]
      rw [e2]
      set s := uR ψ θ φ 0 ^ 2 + uR ψ θ φ 1 ^ 2 with hs
      linear_combination (sin θ / 8) * (-5 * (s + 1 - sin φ ^ 2 * sin θ ^ 2) - 2 * (sin φ * sin θ) ^ 2) * h
    simp only [box, hp, i_phi]
    have hq : ∀ θ : ℝ, 4 * π * (-(5 / 8) * sin θ) + 2 * π * sin θ ^ 3 + 3 * π / 2 * (-(3 / 8) * sin θ ^ 5)
        = (-(5 / 2) * π) * sin θ + (2 * π) * sin θ ^ 3 + (-(9 / 16) * π) * sin θ ^ 5 := fun θ => by ring
    simp only [hq, i_theta, integral_const]; simp; ring


/-- `p₂ = tr H²` and `p₄ = tr H⁴` for the receipt's `H4`, in `u` -/
theorem h4_traces {K : Type*} [Field K] (u : Fin 3 → K) :
    Matrix.trace (Hm u ^ 2) = 2 * u 0 ^ 2 + 2 * u 1 ^ 2 ∧
      Matrix.trace (Hm u ^ 4) = 2 * (u 0 ^ 2 + u 1 ^ 2) ^ 2 := by
  constructor <;> simp [Hm, pow_succ, Matrix.trace, Fin.sum_univ_three, Matrix.mul_apply] <;> ring

/-- ⌗ **Beyond the registration: the algebraic-only prediction at the same level**, the receipt's `C` closed form
`6 − 2p₂ε² − (10/3)p₃ε³ − (7/6)p₄ε⁴` integrated: `−(16/3)π²` at order 2 and `−(112/45)π²` at order 4. Against
(E3)'s `−16π²` and `−(88/15)π²`, the derivative sector's value at this level is `−(32/3)π²` and `−(152/45)π²`, the
receipt's two numbers. -/
theorem algebraic_prediction :
    box (fun u => -2 * (2 * u 0 ^ 2 + 2 * u 1 ^ 2)) = -(16 / 3) * π ^ 2 ∧
      box (fun u => -(7 / 6) * (2 * (u 0 ^ 2 + u 1 ^ 2) ^ 2)) = -(112 / 45) * π ^ 2 ∧
      -16 * π ^ 2 - (-(16 / 3) * π ^ 2) = -(32 / 3) * π ^ 2 ∧
      -(88 / 15) * π ^ 2 - (-(112 / 45) * π ^ 2) = -(152 / 45) * π ^ 2 := by
  refine ⟨?_, ?_, by ring, by ring⟩
  · have hp : ∀ ψ θ φ : ℝ, (-2 * (2 * uR ψ θ φ 0 ^ 2 + 2 * uR ψ θ φ 1 ^ 2)) * (sin θ / 8)
        = (-(1 / 2) * sin θ + 1 / 2 * sin θ ^ 3 * sin φ ^ 2 + 0 * sin φ ^ 4) := fun ψ θ φ => by
      have h := row_unit ψ θ φ
      linear_combination (-(1 / 2) * sin θ) * h
    simp only [box, hp, i_phi]
    have hq : ∀ θ : ℝ, 4 * π * (-(1 / 2) * sin θ) + 2 * π * (1 / 2 * sin θ ^ 3) + 3 * π / 2 * 0
        = (-2 * π) * sin θ + π * sin θ ^ 3 + 0 * sin θ ^ 5 := fun θ => by ring
    simp only [hq, i_theta, integral_const]; simp; ring
  · have hp : ∀ ψ θ φ : ℝ, (-(7 / 6) * (2 * (uR ψ θ φ 0 ^ 2 + uR ψ θ φ 1 ^ 2) ^ 2)) * (sin θ / 8)
        = (-(7 / 24) * sin θ + 7 / 12 * sin θ ^ 3 * sin φ ^ 2 + (-(7 / 24) * sin θ ^ 5) * sin φ ^ 4) :=
      fun ψ θ φ => by
      have h := row_unit ψ θ φ
      set s := uR ψ θ φ 0 ^ 2 + uR ψ θ φ 1 ^ 2 with hs
      linear_combination (-(7 / 24) * sin θ * (s + 1 - sin φ ^ 2 * sin θ ^ 2)) * h
    simp only [box, hp, i_phi]
    have hq : ∀ θ : ℝ, 4 * π * (-(7 / 24) * sin θ) + 2 * π * (7 / 12 * sin θ ^ 3)
          + 3 * π / 2 * (-(7 / 24) * sin θ ^ 5)
        = (-(7 / 6) * π) * sin θ + (7 / 6 * π) * sin θ ^ 3 + (-(7 / 16) * π) * sin θ ^ 5 := fun θ => by ring
    simp only [hq, i_theta, integral_const]; simp; ring

end R59Series

