the `u` of a jet -/
def constJet (H : List ℚ) : Jet :=
  ⟨H, r3.flatMap fun c => r3.flatMap fun a => r3.map fun b =>
      -(sum3 fun x => eps c a x * H.getD (3 * x + b) 0 + eps c b x * H.getD (3 * a + x) 0), []⟩

