theorem full_isUnit : IsUnit ((Mx 17 12 tFULL).submatrix (Fin.castLE (show 12 ≤ 17 by norm_num)) id) :=
  isUnit_cert tFULL SFULL TFULL _ _ rfl (by decide +kernel) (by decide +kernel) (by decide +kernel)

/-- ⛭ **SEVEN OF THE EIGHT, WITH THE FIVE DIVERGENCES, SPAN ALL TWELVE POINTWISE DIRECTIONS.** `FULL` has rank `12`,
the rank of `[A | B]` and of `[A | B | D]`. The minor on the twelve solving rows is invertible (`full_isUnit`), so the
split into an integrated part and a total derivative is unique (`identity_unique`). -/
theorem seven_plus_five_span :
    (Mx 17 12 tFULL).rank = 12 ∧ (Mx 17 12 tFULL).rank = (Mx 17 1044 tAB).rank ∧
      (Mx 17 12 tFULL).rank = (Mx 17 1989 tABD).rank := by
  have h : (Mx 17 12 tFULL).rank = 12 :=
    le_antisymm (Matrix.rank_le_width _)
      (rank_ge_cert tFULL (List.range 12) (List.range 12) SFULL TFULL rfl (by decide +kernel) (by decide +kernel)
        (by decide +kernel) (by decide +kernel) (by decide +kernel))
  exact ⟨h, by rw [h, rank_AB], by rw [h, rank_ABD]⟩

/-- the twelve solved coefficients: seven integrated (on `A7`), then five divergence (on `pD`) -/
def coef : List ℚ := [-5/48, 1/8, 1/24, 19/192, 7/48, -53/192, 1/8, 0, 5/192, 0, 11/192, -9/64]
def coefv : Fin 12 → ℚ := fun j => coef.getD j 0

theorem identity_rows : ∀ i < 17, (lcomb (tFULL.getD i []) (coef.map fun c => [c])).getD 0 0 = LHS.getD i 0 := by
  decide +kernel

/-- ⛭ **THE IDENTITY HOLDS POINTWISE ON ALL SEVENTEEN JETS**, the five held-out jets `12 … 16` included. The left side
is the Lean-computed `ε⁴` coefficient of the frame Koszul scalar (`eps4_values`). -/
theorem identity_pointwise : ∀ i : Fin 17, (Mx 17 12 tFULL *ᵥ coefv) i = eps4 (jets.getD i default) := by
  intro i
  unfold coefv
  rw [mulVec_cert (m := 17) (n := 12) tFULL coef rfl (by decide +kernel), identity_rows i i.2, eps4_values i i.2]

/-- ⛭ **THE SOLVE IS UNIQUE**: any twelve coefficients satisfying the identity on the twelve solving jets alone are
the receipt's. -/
theorem identity_unique (x : Fin 12 → ℚ)
    (hx : ∀ k : Fin 12, (Mx 17 12 tFULL *ᵥ x) (Fin.castLE (show 12 ≤ 17 by norm_num) k) = eps4 (jets.getD k default)) :
    x = coefv := by
  apply Matrix.mulVec_injective_iff_isUnit.2 full_isUnit
  have e : ∀ y : Fin 12 → ℚ, ∀ k : Fin 12,
      ((Mx 17 12 tFULL).submatrix (Fin.castLE (show 12 ≤ 17 by norm_num)) id *ᵥ y) k = (Mx 17 12 tFULL *ᵥ y) (Fin.castLE (show 12 ≤ 17 by norm_num) k) := by
    intro y k; simp only [Matrix.mulVec, dotProduct, Matrix.submatrix_apply, id]
  funext k
  rw [e, e, hx k, identity_pointwise]
  rfl

/-- ⛭ **THE SEVEN INTEGRATED COEFFICIENTS ARE EXACT RATIONALS SHARING THE DENOMINATOR `192`, AND NOT ALL EQUAL.** -/
theorem coefficients_192 :
    coef.take 7 = [-5/48, 1/8, 1/24, 19/192, 7/48, -53/192, 1/8] ∧
      (∀ k < 7, ((192 : ℚ) * coef.getD k 0).den = 1) ∧ coef.getD 0 0 ≠ coef.getD 1 0 := by
  decide +kernel

