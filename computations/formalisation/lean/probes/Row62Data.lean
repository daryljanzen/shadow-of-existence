noncomputable def dtR (x : ℕ → ℕ → ℝ) (i j : ℕ) : ℝ := x i 1 * x j 1 + x i 2 * x j 2 + x i 3 * x j 3

/-- `E[Π (αᵢ + βᵢ·n)]` over the round sphere, `αᵢ = xᵢ₀`, `βᵢ = (xᵢ₁, xᵢ₂, xᵢ₃)` -/
noncomputable def mom4R (x : ℕ → ℕ → ℝ) : ℝ := x 0 0 * x 1 0 * x 2 0 * x 3 0 +
  (1/3) * (dtR x 0 1 * x 2 0 * x 3 0 + dtR x 0 2 * x 1 0 * x 3 0 + dtR x 0 3 * x 1 0 * x 2 0 + dtR x 1 2 * x 0 0 * x 3 0
    + dtR x 1 3 * x 0 0 * x 2 0 + dtR x 2 3 * x 0 0 * x 1 0)
  + (1/15) * (dtR x 0 1 * dtR x 2 3 + dtR x 0 2 * dtR x 1 3 + dtR x 0 3 * dtR x 1 2)

/-- an affine function of `n` -/
noncomputable def aff (x : ℕ → ℕ → ℝ) (i : ℕ) (n : Fin 3 → ℝ) : ℝ := x i 0 + x i 1 * n 0 + x i 2 * n 1 + x i 3 * n 2
theorem expC_eval (x : ℕ → ℕ → ℝ) (n : Fin 3 → ℝ) (s : ℝ) :
    aff x 0 n * (aff x 1 n * (aff x 2 n * (aff x 3 n * 1))) * s =
      ((expC x).map fun ce => ce.1 * (n 0 ^ ce.2.1 * (n 1 ^ ce.2.2.1 * (n 2 ^ ce.2.2.2 * s)))).sum := by
  simp only [expC, aff, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]; ring
theorem expC_mu (x : ℕ → ℕ → ℝ) : ((expC x).map fun ce => ce.1 * (mu ce.2 : ℝ)).sum = mom4R x := by
  simp only [expC, mu, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, mom4R, dtR]; push_cast; ring
theorem expC_deg (x : ℕ → ℕ → ℝ) : ∀ ce ∈ expC x, ce.2.1 + ce.2.2.1 + ce.2.2.2 ≤ 4 := by
  intro ce hce; simp only [expC, List.mem_cons, List.not_mem_nil, or_false] at hce
  rcases hce with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h |
    h | h | h | h | h | h | h | h | h | h <;> subst h <;> norm_num

/-- ⛭ **FOUR AFFINE FACTORS.** `∫ Π (αᵢ + βᵢ·n) · sin θ / 8 = 2π² · mom4R`, for `n` either row, and all real coefficients. -/
theorem moment4 (r : ℕ) (hr : r = 0 ∨ r = 2) (x : ℕ → ℕ → ℝ) :
    boxI (fun ψ θ φ => aff x 0 (nrow r ψ θ φ) * (aff x 1 (nrow r ψ θ φ) * (aff x 2 (nrow r ψ θ φ) *
      (aff x 3 (nrow r ψ θ φ) * 1))) * (sin θ / 8)) = 2 * π ^ 2 * mom4R x := by
  simp only [expC_eval]
  rw [← expC_mu]
  exact box_lsum r hr _ (expC_deg x)


/-! ### The configurations, their fields, and the integrals -/

/-- `(L_a)_kj = −2 ε_akj`: `X_a n_j = Σ_k n_k (L_a)_kj` for every row `n` of `Rad` -/
def Lq (a k j : ℕ) : ℚ := -2 * eps a k j

/-- the connection term of `∇_c H_ab = X_c H_ab − ε_cax H_xb − ε_cbx H_ax` (the receipt's `Dframe`) -/
def conn (H : List ℚ) (c a b : ℕ) : ℚ :=
  -(sum3 fun x => eps c a x * H.getD (3 * x + b) 0 + eps c b x * H.getD (3 * a + x) 0)

/-- a configuration `H = H⁰ + Σ_j n_j Hʲ⁺¹` (`Hs = [H⁰, H¹, H², H³]`, each row-major) has `∇H = D⁰ + Σ_k n_k Dᵏ⁺¹`, with
`Dᵐ_cab = [m ≥ 1] Σ_j (L_c)_{m−1,j} Hʲ⁺¹_ab + conn(Hᵐ)_cab`. Component `m` as a jet: `h = Hᵐ`, `u = Dᵐ`. -/
def cfgJet (Hs : List (List ℚ)) (m : ℕ) : Jet :=
  ⟨Hs.getD m [], r3.flatMap fun c => r3.flatMap fun a => r3.map fun b =>
    (if m = 0 then 0 else sum3 fun j => Lq c (m - 1) j * (Hs.getD (j + 1) []).getD (3 * a + b) 0) +
      conn (Hs.getD m []) c a b, []⟩

/-- the field `H_ab` at a point where `Rad`'s row is `n` -/
noncomputable def fieldH (Hs : List (List ℚ)) (n : Fin 3 → ℝ) (a b : ℕ) : ℝ :=
  aff (fun _ m => ((cfgJet Hs m).H a b : ℝ)) 0 n
/-- its covariant derivative `∇_c H_ab` -/
noncomputable def fieldU (Hs : List (List ℚ)) (n : Fin 3 → ℝ) (c a b : ℕ) : ℝ :=
  aff (fun _ m => ((cfgJet Hs m).U c a b : ℝ)) 0 n
def Fac.valR (Hf : ℕ → ℕ → ℝ) (Uf : ℕ → ℕ → ℕ → ℝ) (e : ℕ → ℕ) : Fac → ℝ
  | .h a b => Hf (e a) (e b)
  | .u c a b => Uf (e c) (e a) (e b)
  | .w _ _ _ _ => 0
def prodR : List ℝ → ℝ
  | [] => 1
  | x :: l => x * prodR l

/-- the contraction of real fields: the receipt's `invariants` sum `Σ_asg DH·DH·H·H` -/
noncomputable def evR (fs : List Fac) (p : List (ℕ × ℕ)) (Hf : ℕ → ℕ → ℝ) (Uf : ℕ → ℕ → ℕ → ℝ) : ℝ :=
  ((asgs p.length).map fun a => prodR (fs.map (Fac.valR Hf Uf (slotv p a)))).sum
def dtQ (x : ℕ → ℕ → ℚ) (i j : ℕ) : ℚ := x i 1 * x j 1 + x i 2 * x j 2 + x i 3 * x j 3
def mom4Q (x : ℕ → ℕ → ℚ) : ℚ := x 0 0 * x 1 0 * x 2 0 * x 3 0 +
  (1/3) * (dtQ x 0 1 * x 2 0 * x 3 0 + dtQ x 0 2 * x 1 0 * x 3 0 + dtQ x 0 3 * x 1 0 * x 2 0 + dtQ x 1 2 * x 0 0 * x 3 0
    + dtQ x 1 3 * x 0 0 * x 2 0 + dtQ x 2 3 * x 0 0 * x 1 0)
  + (1/15) * (dtQ x 0 1 * dtQ x 2 3 + dtQ x 0 2 * dtQ x 1 3 + dtQ x 0 3 * dtQ x 1 2)
theorem mom4Q_cast (x : ℕ → ℕ → ℚ) : (mom4Q x : ℝ) = mom4R fun i m => (x i m : ℝ) := by
  simp only [mom4Q, mom4R, dtQ, dtR]; push_cast; ring

/-- the four factors of sector A, by position -/
def facA (i : ℕ) : Fac := FA.getD i (.h 0 0)

/-- the entry, as Lean computes it: `Σ_asg mom4` of the four factors' affine coefficients -/
def entM (Hs : List (List ℚ)) (p : List (ℕ × ℕ)) : ℚ :=
  ((asgs p.length).map fun a => mom4Q fun i m => Fac.val (cfgJet Hs m) (slotv p a) (facA i)).sum
theorem valR_aff (Hs : List (List ℚ)) (n : Fin 3 → ℝ) (e : ℕ → ℕ) (f : Fac) (x : ℕ → ℕ → ℝ) (i : ℕ)
    (hx : ∀ m, x i m = (Fac.val (cfgJet Hs m) e f : ℝ)) :
    Fac.valR (fieldH Hs n) (fieldU Hs n) e f = aff x i n := by
  cases f <;> simp [Fac.valR, fieldH, fieldU, aff, hx, Fac.val, Jet.W, cfgJet]

/-- ⛭ **THE INTEGRAL OF A CONTRACTION OF A CONFIGURATION**, over the Euler box with the round volume: `2π²` times the
Lean-computed `entM`. -/
theorem box_evR (r : ℕ) (hr : r = 0 ∨ r = 2) (Hs : List (List ℚ)) (p : List (ℕ × ℕ)) :
    boxI (fun ψ θ φ => evR FA p (fieldH Hs (nrow r ψ θ φ)) (fieldU Hs (nrow r ψ θ φ)) * (sin θ / 8)) =
      2 * π ^ 2 * (entM Hs p : ℝ) := by
  set xa : List ℕ → ℕ → ℕ → ℝ := fun a i m => (Fac.val (cfgJet Hs m) (slotv p a) (facA i) : ℝ)
  have pt : (fun ψ θ φ => evR FA p (fieldH Hs (nrow r ψ θ φ)) (fieldU Hs (nrow r ψ θ φ)) * (sin θ / 8)) =
      fun ψ θ φ => (((asgs p.length).flatMap fun a => expC (xa a)).map fun ce => ce.1 * monoS r ce.2 ψ θ φ).sum := by
    funext ψ θ φ
    unfold evR
    rw [← List.sum_map_mul_right, map_sum_flatMap]
    congr 1; apply List.map_congr_left; intro a _
    simp only [FA, List.map_cons, List.map_nil, prodR]
    rw [valR_aff Hs _ _ (.u 0 1 2) (xa a) 0 (fun m => rfl), valR_aff Hs _ _ (.u 3 4 5) (xa a) 1 (fun m => rfl),
      valR_aff Hs _ _ (.h 6 7) (xa a) 2 (fun m => rfl), valR_aff Hs _ _ (.h 8 9) (xa a) 3 (fun m => rfl), expC_eval]
    rfl
  rw [pt, box_lsum r hr _ (by
    intro ce hce; rw [List.mem_flatMap] at hce; obtain ⟨a, _, ha⟩ := hce; exact expC_deg _ ce ha)]
  rw [map_sum_flatMap]
  congr 1
  unfold entM
  rw [Rat.cast_list_sum, List.map_map]
  congr 1; apply List.map_congr_left; intro a _
  rw [expC_mu, Function.comp_apply, mom4Q_cast]

/-- the left-invariant coframe `e = σ/2` on the chart (campaign 24's `eL`) -/
noncomputable def eL (ψ θ : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![0, cos ψ / 2, sin ψ * sin θ / 2; 0, -sin ψ / 2, cos ψ * sin θ / 2; 1 / 2, 0, cos θ / 2]
noncomputable def LmR (a k j : Fin 3) : ℝ := -2 * (eps a k j : ℝ)

/-- the coframe value `Σ_a (n L_a)_j σ^a` along coordinate `k` -/
noncomputable def frameD (r : ℕ) (ψ θ φ : ℝ) (k j : Fin 3) : ℝ :=
  ∑ a, (∑ m, nrow r ψ θ φ m * LmR a m j) * eL ψ θ a k
theorem rad_row0_frame (ψ θ φ : ℝ) (j : Fin 3) :
    HasDerivAt (fun x => nrow 0 x θ φ j) (frameD 0 ψ θ φ 0 j) ψ ∧
      HasDerivAt (fun x => nrow 0 ψ x φ j) (frameD 0 ψ θ φ 1 j) θ ∧
      HasDerivAt (fun x => nrow 0 ψ θ x j) (frameD 0 ψ θ φ 2 j) φ := by
  have cψ := hasDerivAt_cos ψ; have sψ := hasDerivAt_sin ψ
  have cθ := hasDerivAt_cos θ; have sθ := hasDerivAt_sin θ
  have cφ := hasDerivAt_cos φ; have sφ := hasDerivAt_sin φ
  fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> refine ⟨?_, ?_, ?_⟩
  · convert (cψ.const_mul (cos φ)).sub ((sψ.const_mul (sin φ)).mul_const (cos θ)) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert (hasDerivAt_const θ (cos φ * cos ψ)).sub (cθ.const_mul (sin φ * sin ψ)) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert (cφ.mul_const (cos ψ)).sub ((sφ.mul_const (sin ψ)).mul_const (cos θ)) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert ((cψ.const_mul (sin φ)).mul_const (cos θ)).neg.sub (sψ.mul_const (cos φ)) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert (cθ.const_mul (sin φ * cos ψ)).neg.sub (hasDerivAt_const θ (sin ψ * cos φ)) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert ((sφ.mul_const (cos ψ)).mul_const (cos θ)).neg.sub (cφ.const_mul (sin ψ)) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert hasDerivAt_const ψ (sin φ * sin θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert sθ.const_mul (sin φ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert sφ.mul_const (sin θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
theorem rad_row2_frame (ψ θ φ : ℝ) (j : Fin 3) :
    HasDerivAt (fun x => nrow 2 x θ φ j) (frameD 2 ψ θ φ 0 j) ψ ∧
      HasDerivAt (fun x => nrow 2 ψ x φ j) (frameD 2 ψ θ φ 1 j) θ ∧
      HasDerivAt (fun x => nrow 2 ψ θ x j) (frameD 2 ψ θ φ 2 j) φ := by
  have cψ := hasDerivAt_cos ψ; have sψ := hasDerivAt_sin ψ
  have cθ := hasDerivAt_cos θ; have sθ := hasDerivAt_sin θ
  have cφ := hasDerivAt_cos φ; have sφ := hasDerivAt_sin φ
  fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> refine ⟨?_, ?_, ?_⟩
  · convert sψ.mul_const (sin θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert sθ.const_mul (sin ψ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert hasDerivAt_const φ (sin ψ * sin θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert cψ.mul_const (sin θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert sθ.const_mul (cos ψ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert hasDerivAt_const φ (cos ψ * sin θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert hasDerivAt_const ψ (cos θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert cθ using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)
  · convert hasDerivAt_const φ (cos θ) using 1 <;> first | (funext x; simp [nrow] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three] <;> ring1) | (simp [frameD, nrow, LmR, eps, eL, Fin.sum_univ_three]; ring_nf; simp only [Real.sin_sq]; ring1)

/-- ⛭ **THE FRAME RULE ON THE CHART.** For `Rad`'s rows `0` and `2`, `dn_j = Σ_a (n L_a)_j σ^a` with real derivatives:
`X_a n_j = (n L_a)_j`, the rule `cfgJet` uses for the covariant derivative of each configuration. -/
theorem rad_rows_frame (r : ℕ) (hr : r = 0 ∨ r = 2) (ψ θ φ : ℝ) (j : Fin 3) :
    HasDerivAt (fun x => nrow r x θ φ j) (frameD r ψ θ φ 0 j) ψ ∧
      HasDerivAt (fun x => nrow r ψ x φ j) (frameD r ψ θ φ 1 j) θ ∧
      HasDerivAt (fun x => nrow r ψ θ x j) (frameD r ψ θ φ 2 j) φ := by
  rcases hr with rfl | rfl
  · exact rad_row0_frame ψ θ φ j
  · exact rad_row2_frame ψ θ φ j

/-! ### The six configurations -/

def Z9 : List ℚ := [0, 0, 0, 0, 0, 0, 0, 0, 0]
/-- `adjH(c)`'s two components: `H = n₀ A1 + n₁ A2` with `n = Rad_c·` -/
def A1 : List ℚ := [-1, 0, 0, 0, 1, 0, 0, 0, 0]
def A2 : List ℚ := [0, 1, 0, 1, 0, 0, 0, 0, 0]
/-- the receipt's `floor_1` and `floor_3` -/
def F1 : List ℚ := [1, 0, 0, 0, -1, 0, 0, 0, 0]
def F3 : List ℚ := [1, 0, 0, 0, 1, 0, 0, 0, -2]
/-- `H₀ + s · adjH` -/
def cfgOf (H0 : List ℚ) (s : ℚ) : List (List ℚ) := [H0, A1.map (s * ·), A2.map (s * ·), Z9]
/-- the receipt's six: `n4_c0 = adjH(0)`, `floor_1`, `floor_3`, `n4_c2 = adjH(2)`, `mix_d = floor_1 + 3 adjH(2)`,
`mix_b = floor_3 + 2 adjH(0)` -/
def cfgHs : ℕ → List (List ℚ)
  | 0 => cfgOf Z9 1
  | 1 => cfgOf F1 0
  | 2 => cfgOf F3 0
  | 3 => cfgOf Z9 1
  | 4 => cfgOf F1 3
  | _ => cfgOf F3 2
/-- the row of `Rad` each one uses (immaterial for the two constant ones) -/
def cfgRow : ℕ → ℕ
  | 3 => 2
  | 4 => 2
  | _ => 0

/-- every component of every configuration is traceless and transverse (the receipt's `assert ... is not TT`) -/
theorem configurations_TT : ∀ k < 6, ∀ m < 4,
    (cfgJet (cfgHs k) m).H 0 0 + (cfgJet (cfgHs k) m).H 1 1 + (cfgJet (cfgHs k) m).H 2 2 = 0 ∧
      UTransverse (cfgJet (cfgHs k) m) := by decide +kernel

/-- the integrand of configuration `k`, column `c` of the eight: the receipt's `tot · sq` -/
noncomputable def integrand (k c : ℕ) (ψ θ φ : ℝ) : ℝ :=
  evR FA (ADM_A.getD (SEL8.getD c 0) []) (fieldH (cfgHs k) (nrow (cfgRow k) ψ θ φ))
    (fieldU (cfgHs k) (nrow (cfgRow k) ψ θ φ)) * (sin θ / 8)
theorem m6_0_0 : ((SEL8.map fun c => 2 * entM (cfgHs 0) (ADM_A.getD c [])).drop (4 * 0)).take 4 = ((tM6.getD 0 []).drop (4 * 0)).take 4 := by decide +kernel
theorem m6_0_1 : ((SEL8.map fun c => 2 * entM (cfgHs 0) (ADM_A.getD c [])).drop (4 * 1)).take 4 = ((tM6.getD 0 []).drop (4 * 1)).take 4 := by decide +kernel
theorem m6_0 : SEL8.map (fun c => 2 * entM (cfgHs 0) (ADM_A.getD c [])) = tM6.getD 0 [] :=
  eq_of_chunks 4 2 _ _ (by intro k hk; interval_cases k; exacts [m6_0_0, m6_0_1]) (by decide +kernel) (by decide +kernel)
theorem m6_1_0 : ((SEL8.map fun c => 2 * entM (cfgHs 1) (ADM_A.getD c [])).drop (4 * 0)).take 4 = ((tM6.getD 1 []).drop (4 * 0)).take 4 := by decide +kernel
theorem m6_1_1 : ((SEL8.map fun c => 2 * entM (cfgHs 1) (ADM_A.getD c [])).drop (4 * 1)).take 4 = ((tM6.getD 1 []).drop (4 * 1)).take 4 := by decide +kernel
theorem m6_1 : SEL8.map (fun c => 2 * entM (cfgHs 1) (ADM_A.getD c [])) = tM6.getD 1 [] :=
  eq_of_chunks 4 2 _ _ (by intro k hk; interval_cases k; exacts [m6_1_0, m6_1_1]) (by decide +kernel) (by decide +kernel)
theorem m6_2_0 : ((SEL8.map fun c => 2 * entM (cfgHs 2) (ADM_A.getD c [])).drop (4 * 0)).take 4 = ((tM6.getD 2 []).drop (4 * 0)).take 4 := by decide +kernel
theorem m6_2_1 : ((SEL8.map fun c => 2 * entM (cfgHs 2) (ADM_A.getD c [])).drop (4 * 1)).take 4 = ((tM6.getD 2 []).drop (4 * 1)).take 4 := by decide +kernel
theorem m6_2 : SEL8.map (fun c => 2 * entM (cfgHs 2) (ADM_A.getD c [])) = tM6.getD 2 [] :=
  eq_of_chunks 4 2 _ _ (by intro k hk; interval_cases k; exacts [m6_2_0, m6_2_1]) (by decide +kernel) (by decide +kernel)
theorem m6_3_0 : ((SEL8.map fun c => 2 * entM (cfgHs 3) (ADM_A.getD c [])).drop (4 * 0)).take 4 = ((tM6.getD 3 []).drop (4 * 0)).take 4 := by decide +kernel
theorem m6_3_1 : ((SEL8.map fun c => 2 * entM (cfgHs 3) (ADM_A.getD c [])).drop (4 * 1)).take 4 = ((tM6.getD 3 []).drop (4 * 1)).take 4 := by decide +kernel
theorem m6_3 : SEL8.map (fun c => 2 * entM (cfgHs 3) (ADM_A.getD c [])) = tM6.getD 3 [] :=
  eq_of_chunks 4 2 _ _ (by intro k hk; interval_cases k; exacts [m6_3_0, m6_3_1]) (by decide +kernel) (by decide +kernel)
theorem m6_4_0 : ((SEL8.map fun c => 2 * entM (cfgHs 4) (ADM_A.getD c [])).drop (4 * 0)).take 4 = ((tM6.getD 4 []).drop (4 * 0)).take 4 := by decide +kernel
theorem m6_4_1 : ((SEL8.map fun c => 2 * entM (cfgHs 4) (ADM_A.getD c [])).drop (4 * 1)).take 4 = ((tM6.getD 4 []).drop (4 * 1)).take 4 := by decide +kernel
theorem m6_4 : SEL8.map (fun c => 2 * entM (cfgHs 4) (ADM_A.getD c [])) = tM6.getD 4 [] :=
  eq_of_chunks 4 2 _ _ (by intro k hk; interval_cases k; exacts [m6_4_0, m6_4_1]) (by decide +kernel) (by decide +kernel)
theorem m6_5_0 : ((SEL8.map fun c => 2 * entM (cfgHs 5) (ADM_A.getD c [])).drop (4 * 0)).take 4 = ((tM6.getD 5 []).drop (4 * 0)).take 4 := by decide +kernel
theorem m6_5_1 : ((SEL8.map fun c => 2 * entM (cfgHs 5) (ADM_A.getD c [])).drop (4 * 1)).take 4 = ((tM6.getD 5 []).drop (4 * 1)).take 4 := by decide +kernel
theorem m6_5 : SEL8.map (fun c => 2 * entM (cfgHs 5) (ADM_A.getD c [])) = tM6.getD 5 [] :=
  eq_of_chunks 4 2 _ _ (by intro k hk; interval_cases k; exacts [m6_5_0, m6_5_1]) (by decide +kernel) (by decide +kernel)

/-- ⛭ **THE SIX CONFIGURATIONS' INTEGRALS, COMPUTED.** Every entry of the receipt's `M6` is `1/π²` times the integral over
the Euler box, with the round volume, of the contraction of configuration `k`'s field and its covariant derivative:
`∫ integrand k c = M6[k][c] · π²`. -/
theorem six_configurations_integrals : ∀ k < 6, ∀ c < 8, boxI (integrand k c) = ((tM6.getD k []).getD c 0 : ℝ) * π ^ 2 := by
  intro k hk c hc
  have hr : cfgRow k = 0 ∨ cfgRow k = 2 := by interval_cases k <;> simp [cfgRow]
  have hrow : SEL8.map (fun c => 2 * entM (cfgHs k) (ADM_A.getD c [])) = tM6.getD k [] := by
    interval_cases k
    exacts [m6_0, m6_1, m6_2, m6_3, m6_4, m6_5]
  have he : 2 * entM (cfgHs k) (ADM_A.getD (SEL8.getD c 0) []) = (tM6.getD k []).getD c 0 := by
    rw [← hrow, getD_map_lt _ _ _ 0 _ (by simpa [SEL8] using hc)]
  unfold integrand
  rw [box_evR _ hr, ← he]; push_cast; ring

/-! ## 11. The headline theorems, on Lean-computed data -/

def tABe : List (List ℚ) := (List.range 17).map fun i => tAe.getD i [] ++ tBe.getD i []
def tABQe : List (List ℚ) := (List.range 17).map fun i => tAe.getD i [] ++ tBe.getD i [] ++ tQe.getD i []
def tABDe : List (List ℚ) := (List.range 17).map fun i => tAe.getD i [] ++ tBe.getD i [] ++ tDe.getD i []
def tS8e : List (List ℚ) := (List.range 17).map fun i => SEL8.map fun c => (tAe.getD i []).getD c 0
def tFULLe : List (List ℚ) :=
  (List.range 17).map fun i => (A7.map fun c => (tAe.getD i []).getD c 0) ++ (pD.map fun c => (tDe.getD i []).getD c 0)
theorem tAB_eq : tAB = tABe := by unfold tAB tABe; rw [tA_eq, tB_eq]
theorem tABQ_eq : tABQ = tABQe := by unfold tABQ tABQe; rw [tA_eq, tB_eq, tQ_eq]
theorem tABD_eq : tABD = tABDe := by unfold tABD tABDe; rw [tA_eq, tB_eq, tD_eq]
theorem tS8_eq : tS8 = tS8e := by unfold tS8 tS8e; rw [tA_eq]
theorem tFULL_eq : tFULL = tFULLe := by unfold tFULL tFULLe; rw [tA_eq, tD_eq]

/-- ⛭ **THE SECTOR RANKS (claim 2), ON THE LEAN CONTRACTIONS.** The matrices are `evF` and `evDiv` at the receipt's
seventeen transverse-traceless jets: A rank `8`, B rank `4`, Q rank `1`, `[A | B]` rank `12`, Q and the `945`
divergences (rank `5`) inside it, integrated dimension `7`. -/
theorem sector_ranks_computed :
    (Mx 17 372 tAe).rank = 8 ∧ (Mx 17 672 tBe).rank = 4 ∧ (Mx 17 60 tQe).rank = 1 ∧ (Mx 17 1044 tABe).rank = 12 ∧
      (Mx 17 1104 tABQe).rank = (Mx 17 1044 tABe).rank ∧ (Mx 17 945 tDe).rank = 5 ∧
      (Mx 17 1989 tABDe).rank = (Mx 17 1044 tABe).rank ∧ (Mx 17 1044 tABe).rank - (Mx 17 945 tDe).rank = 7 := by
  rw [← tA_eq, ← tB_eq, ← tQ_eq, ← tD_eq, ← tAB_eq, ← tABQ_eq, ← tABD_eq]; exact sector_ranks

/-- ⛭ **THE CONTROL, ON THE LEAN CONTRACTIONS.** -/
theorem control_raises_A_computed : (Mx 12 372 tCe).rank = 11 ∧ (Mx 17 372 tAe).rank < (Mx 12 372 tCe).rank := by
  rw [← tC_eq, ← tA_eq]; exact control_raises_A
theorem sel8_independent_computed : (Mx 17 8 tS8e).rank = 8 := by rw [← tS8_eq]; exact sel8_independent
theorem seven_plus_five_span_computed :
    (Mx 17 12 tFULLe).rank = 12 ∧ (Mx 17 12 tFULLe).rank = (Mx 17 1044 tABe).rank ∧
      (Mx 17 12 tFULLe).rank = (Mx 17 1989 tABDe).rank := by
  rw [← tFULL_eq, ← tAB_eq, ← tABD_eq]; exact seven_plus_five_span

/-- ⛭ **THE IDENTITY HOLDS POINTWISE ON ALL SEVENTEEN JETS**, both sides Lean-computed: the twelve contraction columns
are `evF` / `evDiv`, the right side is the frame Koszul `ε⁴` coefficient. -/
theorem identity_pointwise_computed : ∀ i : Fin 17, (Mx 17 12 tFULLe *ᵥ coefv) i = eps4 (jets.getD i default) := by
  rw [← tFULL_eq]; exact identity_pointwise
theorem identity_unique_computed (x : Fin 12 → ℚ)
    (hx : ∀ k : Fin 12, (Mx 17 12 tFULLe *ᵥ x) (Fin.castLE (show 12 ≤ 17 by norm_num) k) = eps4 (jets.getD k default)) :
    x = coefv := by
  rw [← tFULL_eq] at hx; exact identity_unique x hx

/-- ⛭ **THE MEASUREMENT ROUTES, COMPUTED.** The six configurations' rows are their `S³` integrals
(`six_configurations_integrals`), and they reach measurement rank `4` against seven unknowns. -/
theorem six_configurations_computed :
    (∀ k < 6, ∀ c < 8, boxI (integrand k c) = ((tM6.getD k []).getD c 0 : ℝ) * π ^ 2) ∧
      (Mx 6 8 tM6).rank = 4 ∧ (Mx 6 8 tM6).rank < 7 :=
  ⟨six_configurations_integrals, six_configurations_rank_four⟩

/-- ⛭ **THE IDENTITY FAILS ON ALL SIX NON-TRANSVERSE JETS**, both sides Lean-computed. -/
theorem identity_fails_off_transversality_computed :
    ∀ k < 6, (lcomb (falsRowsE.getD k []) (coef.map fun c => [c])).getD 0 0 ≠ eps4 (falsJets.getD k default) := by
  rw [← falsRows_eq]; exact identity_fails_off_transversality

