def gA (J : Jet) (ds : List S4) : ℚ := fast4 (.u 0 1 2) (.u 3 4 5) (.h 6 7) (.h 8 9) J.toZ ds
def gB (J : Jet) (ds : List S4) : ℚ := fast4 (.w 0 1 2 3) (.h 4 5) (.h 6 7) (.h 8 9) J.toZ ds
def gQ (J : Jet) (ds : List S4) : ℚ := fast4 (.h 0 1) (.h 2 3) (.h 4 5) (.h 6 7) J.toZ ds
def gD (J : Jet) (ds : List Sx8) : ℚ := fastD J.toZ ds
theorem getD_map_lt {α β : Type} (l : List α) (f : α → β) (j : ℕ) (d : α) (d' : β) (h : j < l.length) :
    (l.map f).getD j d' = f (l.getD j d) := by
  rw [List.getD_eq_getElem _ _ (by simpa using h), List.getD_eq_getElem _ _ h, List.getElem_map]
theorem evA_fast (J : Jet) (hJ : intJet J) (j : ℕ) (hj : j < 372) : evF FA (ADM_A.getD j []) J = gA J (stA.getD j []) := by
  rw [gA, SA_eq, getD_map_lt _ _ _ [] _ (by rw [enumeration.1]; exact hj)]
  exact fast4_correct _ _ _ _ _ J (goodA j hj).1 (goodA j hj).2 hJ
theorem evB_fast (J : Jet) (hJ : intJet J) (j : ℕ) (hj : j < 672) : evF FB (ADM_B.getD j []) J = gB J (stB.getD j []) := by
  rw [gB, SB_eq, getD_map_lt _ _ _ [] _ (by rw [enumeration.2.1]; exact hj)]
  exact fast4_correct _ _ _ _ _ J (goodBB j hj).1 (goodBB j hj).2 hJ
theorem evQ_fast (J : Jet) (hJ : intJet J) (j : ℕ) (hj : j < 60) : evF FQ (ADM_Q.getD j []) J = gQ J (stQ.getD j []) := by
  rw [gQ, SQ_eq, getD_map_lt _ _ _ [] _ (by rw [enumeration.2.2.1]; exact hj)]
  exact fast4_correct _ _ _ _ _ J (goodQ j hj).1 (goodQ j hj).2 hJ
theorem evD_fast (J : Jet) (hJ : intJet J) (j : ℕ) (hj : j < 945) : evDiv (PV.getD j (0, [])) J = gD J (stD.getD j []) := by
  rw [gD, SD_eq, getD_map_lt _ _ _ (0, []) _ (by rw [enumeration.2.2.2]; exact hj)]
  exact fastD_correct _ J (goodD j hj).1 (goodD j hj).2 hJ
theorem eq_of_chunks (s : ℕ) : ∀ (n : ℕ) (L T : List ℚ), (∀ k < n, (L.drop (s * k)).take s = (T.drop (s * k)).take s) →
    L.length ≤ s * n → T.length ≤ s * n → L = T
  | 0, L, T, _, hL, hT => by
      have h1 : L.length = 0 := by simpa using hL
      have h2 : T.length = 0 := by simpa using hT
      rw [List.length_eq_zero_iff] at h1 h2; rw [h1, h2]
  | n + 1, L, T, h, hL, hT => by
      rw [← List.take_append_drop s L, ← List.take_append_drop s T]
      congr 1
      · simpa using h 0 (by omega)
      · apply eq_of_chunks s n
        · intro k hk
          have := h (k + 1) (by omega)
          rwa [List.drop_drop, List.drop_drop, show s + s * k = s * (k + 1) by ring]
        · simp; rw [Nat.mul_succ] at hL; omega
        · simp; rw [Nat.mul_succ] at hT; omega
theorem rows_eq (t : List (List ℚ)) (m : ℕ) (g : ℕ → List ℚ) (ht : t.length = m) (h : ∀ i < m, t.getD i [] = g i) :
    t = (List.range m).map g := by
  apply List.ext_getElem (by simp [ht]); intro i h1 h2
  rw [List.getElem_map, List.getElem_range, ← h i (by omega), List.getD_eq_getElem _ _ h1]
theorem map_eq_range {β : Type} (S : List β) (G : β → ℚ) (n : ℕ) (F : ℕ → ℚ) (d : β) (hS : S.length = n)
    (h : ∀ j < n, G (S.getD j d) = F j) : S.map G = (List.range n).map F := by
  apply List.ext_getElem (by simp [hS]); intro j h1 h2
  rw [List.getElem_map, List.getElem_map, List.getElem_range, ← h j (by simpa [hS] using h1),
    List.getD_eq_getElem _ _ (by simpa using h1)]
theorem SA_len : stA.length = 372 := by rw [SA_eq, List.length_map, enumeration.1]
