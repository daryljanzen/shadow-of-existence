theorem fals_3 : (lcomb (falsRows.getD 3 []) (coef.map fun c => [c])).getD 0 0 ≠ eps4 (falsJets.getD 3 default) := by
  decide +kernel
theorem fals_4 : (lcomb (falsRows.getD 4 []) (coef.map fun c => [c])).getD 0 0 ≠ eps4 (falsJets.getD 4 default) := by
  decide +kernel
theorem fals_5 : (lcomb (falsRows.getD 5 []) (coef.map fun c => [c])).getD 0 0 ≠ eps4 (falsJets.getD 5 default) := by
  decide +kernel

/-- ⛭ **THE IDENTITY FAILS ON EVERY ONE OF THE SIX TRACELESS, NON-TRANSVERSE JETS** (`fals_jets`), so transversality
does work in it. The `ε⁴` side is computed here; the contraction side is proved equal to `evF` in §9. -/
theorem identity_fails_off_transversality :
    ∀ k < 6, (lcomb (falsRows.getD k []) (coef.map fun c => [c])).getD 0 0 ≠ eps4 (falsJets.getD k default) := by
  intro k hk; interval_cases k
  exacts [fals_0, fals_1, fals_2, fals_3, fals_4, fals_5]


/-! ## 9. Every contraction entry, computed in the kernel

The contraction `evF` sums `3⁵` products of jet entries, and the kernel evaluates it at about a second per entry. The
tables here have about `40 000` entries, so a second evaluator is defined and proved equal to `evF`.

- **Integers, packed.** Every jet entry is an integer (`intJet`). Each of a jet's three tensors is packed into one
  natural number, `64` bits per entry, holding the entry modulo `2⁶⁴` (`packL`). A lookup is a shift and a mask (`lkm`).
  The kernel does `Nat` arithmetic on literals with GMP, so a lookup is a constant number of steps.
- **Strides.** A pattern `p` is compiled once to the per-pair strides of each factor (`strides4`). The sum over the
  `3⁵` assignments is then a nested loop over the pairs that only adds offsets (`nest`).
- **Exactness.** The loop returns the sum modulo `2⁶⁴`. The true value is bounded by `3⁵ · 4 · 100⁴ < 2⁶³`, because every
  jet entry is at most `100` in size, so the residue determines it (`dec`).

`fast4_correct` and `fastD_correct` prove the evaluator equal to `evF` and `evDiv`, for every pattern with distinct
slots (`goodB`) and every integer jet with entries of size at most `100`. Each table row is then checked against the
evaluator by `decide +kernel`. -/

/-- `2⁶⁴` -/
def M64 : ℕ := 18446744073709551616

/-- an integer, as a residue in `[0, 2⁶⁴)` -/
def enc (x : ℤ) : ℕ := (x % (M64 : ℤ)).toNat

/-- the `64`-bit field at bit offset `o` -/
def lkm (T o : ℕ) : ℕ := Nat.land (Nat.shiftRight T o) 18446744073709551615

/-- a list of integers, packed `64` bits per entry -/
def packL : List ℤ → ℕ
  | [] => 0
  | x :: l => Nat.add (enc x) (Nat.mul M64 (packL l))

/-- the residue read back as an integer in `[−2⁶³, 2⁶³)` -/
def dec (r : ℕ) : ℤ :=
  cond (Nat.blt (Nat.mod r M64) 9223372036854775808) (Int.ofNat (Nat.mod r M64)) (Int.subNatNat (Nat.mod r M64) M64)
theorem M64_eq : M64 = 2 ^ 64 := by norm_num [M64]
theorem enc_cast (x : ℤ) : (enc x : ℤ) = x % M64 :=
  Int.toNat_of_nonneg (Int.emod_nonneg _ (by norm_num [M64]))
theorem enc_lt (x : ℤ) : enc x < M64 := by
  have h := enc_cast x
  have h2 := Int.emod_lt_of_pos x (show (0 : ℤ) < M64 by norm_num [M64])
  omega
theorem lkm_eq (T o : ℕ) : lkm T o = T / 2 ^ o % M64 := by
  show (T >>> o) &&& 18446744073709551615 = _
  rw [show (18446744073709551615 : ℕ) = 2 ^ 64 - 1 by norm_num, Nat.and_two_pow_sub_one_eq_mod,
    Nat.shiftRight_eq_div_pow, M64_eq]
theorem lkm_packL : ∀ (l : List ℤ) (k : ℕ), lkm (packL l) (64 * k) = enc (l.getD k 0)
  | [], k => by simp [packL, lkm_eq, enc]
  | x :: l, 0 => by
      simp only [packL, lkm_eq, Nat.add_eq, Nat.mul_eq, mul_zero, pow_zero, Nat.div_one, List.getD_cons_zero]
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (enc_lt x)]
  | x :: l, k + 1 => by
      have ih := lkm_packL l k
      rw [lkm_eq] at ih ⊢
      simp only [packL, Nat.add_eq, Nat.mul_eq, List.getD_cons_succ]
      rw [show 64 * (k + 1) = 64 + 64 * k by ring, pow_add, ← Nat.div_div_eq_div_mul, ← M64_eq,
        Nat.add_mul_div_left _ _ (by norm_num [M64]), Nat.div_eq_of_lt (enc_lt x), zero_add, ih]
theorem dec_eq (r : ℕ) (x : ℤ) (h : (r : ℤ) % M64 = x % M64) (hb : |x| < 2 ^ 63) : dec r = x := by
  rw [abs_lt] at hb
  have hm : ((r % M64 : ℕ) : ℤ) = x % M64 := by push_cast; exact h
  show cond (Nat.blt (r % M64) 9223372036854775808) (Int.ofNat (r % M64)) (Int.subNatNat (r % M64) M64) = x
  rw [M64] at hm ⊢
  cases hc : Nat.blt (r % 18446744073709551616) 9223372036854775808
  · have hc' : ¬ (r % 18446744073709551616 < 9223372036854775808) := by
      rw [← Nat.blt_eq]; simp [hc]
    simp only [Bool.cond_false, Int.subNatNat_eq_coe]
    omega
  · rw [Nat.blt_eq] at hc
    simp only [Bool.cond_true, Int.ofNat_eq_natCast]
    omega

/-! ### The nested loop -/

/-- the sum over `v₁, …, vₙ ∈ {0, 1, 2}` of `leaf (o + Σ vₖ dₖ)`, as a loop over the strides `d` -/
def nest {S : Type} (step : S → S → S) (leaf : S → ℕ) : List S → S → ℕ
  | [], o => leaf o
  | d :: ds, o => Nat.add (nest step leaf ds o)
      (Nat.add (nest step leaf ds (step o d)) (nest step leaf ds (step (step o d) d)))

/-- `Σ vₖ dₖ` -/
def dotS {S : Type} [AddCommMonoid S] : List S → List ℕ → S
  | d :: ds, v :: a => v • d + dotS ds a
  | _, _ => 0
theorem sum_flatMap3 {M : Type} [AddCommMonoid M] (G : List ℕ → M) : ∀ l : List (List ℕ),
    ((l.flatMap fun a => [0 :: a, 1 :: a, 2 :: a]).map G).sum =
      (l.map fun a => G (0 :: a)).sum + (l.map fun a => G (1 :: a)).sum + (l.map fun a => G (2 :: a)).sum
  | [] => by simp
  | a :: l => by
      rw [List.flatMap_cons, List.map_append, List.sum_append, sum_flatMap3 G l]
      simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
      abel
theorem nest_eq {S : Type} [AddCommMonoid S] (step : S → S → S) (hs : ∀ o d, step o d = o + d) (leaf : S → ℕ) :
    ∀ (ds : List S) (o : S), nest step leaf ds o = ((asgs ds.length).map fun a => leaf (o + dotS ds a)).sum
  | [], o => by simp [nest, asgs, dotS]
  | d :: ds, o => by
      rw [nest, List.length_cons, asgs, sum_flatMap3, nest_eq step hs leaf ds, nest_eq step hs leaf ds,
        nest_eq step hs leaf ds]
      simp only [dotS, hs, zero_smul, one_smul, zero_add, Nat.add_eq, two_nsmul, add_assoc]
theorem length_flatMap3 : ∀ l : List (List ℕ), (l.flatMap fun a => [0 :: a, 1 :: a, 2 :: a]).length = 3 * l.length
  | [] => rfl
  | a :: l => by rw [List.flatMap_cons, List.length_append, length_flatMap3 l]; simp; ring
theorem length_asgs : ∀ n, (asgs n).length = 3 ^ n
  | 0 => rfl
  | n + 1 => by rw [asgs, length_flatMap3, length_asgs n, pow_succ]; ring

/-! ### Patterns as linear index maps -/

def ind (x s : ℕ) : ℕ := if x = s then 1 else 0

/-- the flat index of a factor's entry, under the slot values `e` -/
def Fac.idx (e : ℕ → ℕ) : Fac → ℕ
  | .h a b => 3 * e a + e b
  | .u c a b => 9 * e c + 3 * e a + e b
  | .w c d a b => 27 * e c + 9 * e d + 3 * e a + e b

/-- the stride of the pair `(x, y)` in a factor's flat index -/
def Fac.dk (x y : ℕ) (f : Fac) : ℕ := f.idx fun s => ind x s + ind y s

/-- the slot values of a matching and an assignment, written linearly -/
def slotw : List (ℕ × ℕ) → List ℕ → ℕ → ℕ
  | (x, y) :: p, v :: a, s => v * (ind x s + ind y s) + slotw p a s
  | _, _, _ => 0

/-- `Σ vₖ · stride_f(pair k)` -/
def lin : List (ℕ × ℕ) → List ℕ → Fac → ℕ
  | (x, y) :: p, v :: a, f => v * Fac.dk x y f + lin p a f
  | _, _, _ => 0
theorem idx_slotw (f : Fac) : ∀ (p : List (ℕ × ℕ)) (a : List ℕ), f.idx (slotw p a) = lin p a f
  | [], a => by cases f <;> simp [Fac.idx, slotw, lin]
  | (x, y) :: p, [] => by cases f <;> simp [Fac.idx, slotw, lin]
  | (x, y) :: p, v :: a => by
      have ih := idx_slotw f p a
      cases f <;> simp only [Fac.idx, slotw, lin, Fac.dk] at ih ⊢ <;> rw [← ih] <;> ring

/-- a matching with distinct slots: no pair is a loop, and no slot is in two pairs -/
def goodB : List (ℕ × ℕ) → Bool
  | [] => true
  | (x, y) :: p => (x != y) && p.all (fun q => q.1 != x && q.1 != y && q.2 != x && q.2 != y) && goodB p
theorem slotw_zero (s : ℕ) : ∀ (p : List (ℕ × ℕ)) (a : List ℕ), (p.all fun q => q.1 != s && q.2 != s) = true →
    slotw p a s = 0
  | [], a, _ => by simp [slotw]
  | (x, y) :: p, [], _ => by simp [slotw]
  | (x, y) :: p, v :: a, h => by
      simp only [List.all_cons, Bool.and_eq_true, bne_iff_ne, ne_eq] at h
      simp [slotw, ind, h.1.1, h.1.2, slotw_zero s p a h.2]
theorem slotv_eq : ∀ (p : List (ℕ × ℕ)) (a : List ℕ) (s : ℕ), goodB p = true → slotv p a s = slotw p a s
  | [], a, s, _ => by simp [slotv, slotw]
  | (x, y) :: p, [], s, _ => by simp [slotv, slotw]
  | (x, y) :: p, v :: a, s, h => by
      simp only [goodB, Bool.and_eq_true, bne_iff_ne, ne_eq] at h
      obtain ⟨⟨hxy, hall⟩, hp⟩ := h
      have ih := slotv_eq p a s hp
      have e : slotv ((x, y) :: p) (v :: a) s = if x = s ∨ y = s then v else slotv p a s := by
        simp [slotv, List.zip_cons_cons, List.foldr_cons]
      rw [e]
      by_cases hx : x = s
      · subst hx
        have hyx : ¬ y = x := fun h => hxy h.symm
        have h0 : slotw p a x = 0 := slotw_zero x p a (by
          rw [List.all_eq_true] at hall ⊢
          intro q hq; have := hall q hq; simp only [Bool.and_eq_true, bne_iff_ne, ne_eq] at this ⊢
          exact ⟨this.1.1.1, this.1.2⟩)
        simp [slotw, ind, hyx, h0]
      · by_cases hy : y = s
        · subst hy
          have h0 : slotw p a y = 0 := slotw_zero y p a (by
            rw [List.all_eq_true] at hall ⊢
            intro q hq; have := hall q hq; simp only [Bool.and_eq_true, bne_iff_ne, ne_eq] at this ⊢
            exact ⟨this.1.1.2, this.2⟩)
          simp [slotw, ind, hx, h0]
        · simp [slotw, ind, hx, hy, ih]

/-! ### Integer jets -/

structure ZJet where
  h : List ℤ
  u : List ℤ
  w : List ℤ
def ZJet.toJet (Z : ZJet) : Jet := ⟨Z.h.map Int.cast, Z.u.map Int.cast, Z.w.map Int.cast⟩
def Jet.toZ (J : Jet) : ZJet := ⟨J.h.map Rat.num, J.u.map Rat.num, J.w.map Rat.num⟩

/-- every entry of the jet is an integer of size at most `100` -/
def intJet (J : Jet) : Prop :=
  J.h.map (fun q => ((q.num : ℤ) : ℚ)) = J.h ∧ J.u.map (fun q => ((q.num : ℤ) : ℚ)) = J.u ∧
    J.w.map (fun q => ((q.num : ℤ) : ℚ)) = J.w ∧
    ((J.h ++ J.u ++ J.w).all fun q => decide (|q.num| ≤ 100)) = true
instance (J : Jet) : Decidable (intJet J) := by unfold intJet; infer_instance
theorem intJet_toJet (J : Jet) (h : intJet J) : J.toZ.toJet = J := by
  obtain ⟨h1, h2, h3, _⟩ := h
  cases J
  simp only [Jet.toZ, ZJet.toJet, List.map_map, Function.comp_def] at h1 h2 h3 ⊢
  rw [h1, h2, h3]
def Fac.tabZ (Z : ZJet) : Fac → List ℤ
  | .h _ _ => Z.h
  | .u _ _ _ => Z.u
  | .w _ _ _ _ => Z.w
theorem getD_cast : ∀ (l : List ℤ) (k : ℕ), (l.map (Int.cast : ℤ → ℚ)).getD k 0 = ((l.getD k 0 : ℤ) : ℚ)
  | [], k => by simp
  | a :: l, 0 => by simp
  | a :: l, k + 1 => by rw [List.map_cons, List.getD_cons_succ, List.getD_cons_succ, getD_cast l k]
theorem val_toJet (Z : ZJet) (e : ℕ → ℕ) (f : Fac) :
    Fac.val Z.toJet e f = (((f.tabZ Z).getD (f.idx e) 0 : ℤ) : ℚ) := by
  cases f <;> simp only [Fac.val, Jet.H, Jet.U, Jet.W, ZJet.toJet, Fac.tabZ, Fac.idx] <;> rw [getD_cast]
theorem bound_getD (l : List ℤ) (k : ℕ) (hl : (l.all fun q => decide (|q| ≤ 100)) = true) : |l.getD k 0| ≤ 100 := by
  rw [List.getD_eq_getElem?_getD]
  cases hk : l[k]? with
  | none => simp
  | some x =>
      have hx : x ∈ l := List.mem_of_getElem? hk
      rw [List.all_eq_true] at hl
      simpa using hl x hx
theorem bound_tab (J : Jet) (h : intJet J) (f : Fac) (k : ℕ) : |(f.tabZ J.toZ).getD k 0| ≤ 100 := by
  obtain ⟨_, _, _, hb⟩ := h
  apply bound_getD
  rw [List.all_eq_true] at hb ⊢
  intro q hq
  cases f <;> simp only [Fac.tabZ, Jet.toZ, List.mem_map] at hq <;> obtain ⟨r, hr, rfl⟩ := hq <;>
    exact hb r (by simp [hr])
theorem evF_sum (fs : List Fac) (p : List (ℕ × ℕ)) (J : Jet) :
    evF fs p J = ((asgs p.length).map fun a => prodL (fs.map (Fac.val J (slotv p a)))).sum := by
  unfold evF
  induction asgs p.length with
  | nil => rfl
  | cons a l ih => rw [List.foldr_cons, ih, List.map_cons, List.sum_cons]

/-- a sum of `n` terms each at most `c` in size -/
theorem abs_sum_le (l : List (List ℕ)) (g : List ℕ → ℤ) (c : ℤ) (h : ∀ a, |g a| ≤ c) :
    |(l.map g).sum| ≤ l.length * c := by
  induction l with
  | nil => simp
  | cons a l ih =>
      rw [List.map_cons, List.sum_cons, List.length_cons]
      calc |g a + (l.map g).sum| ≤ |g a| + |(l.map g).sum| := abs_add_le _ _
        _ ≤ c + l.length * c := add_le_add (h a) ih
        _ = ((l.length + 1 : ℕ) : ℤ) * c := by push_cast; ring
theorem enc_zmod (x : ℤ) : ((enc x : ℕ) : ZMod M64) = (x : ZMod M64) := by
  rw [← Int.cast_natCast, enc_cast, ZMod.intCast_mod]
theorem mod_of_zmod (N : ℕ) (X : ℤ) (h : ((N : ℕ) : ZMod M64) = (X : ZMod M64)) : (N : ℤ) % M64 = X % M64 := by
  rw [← ZMod.intCast_eq_intCast_iff', Int.cast_natCast, h]
theorem zmod_sum (l : List (List ℕ)) (g : List ℕ → ℕ) (G : List ℕ → ℤ)
    (h : ∀ a, ((g a : ℕ) : ZMod M64) = (G a : ZMod M64)) :
    (((l.map g).sum : ℕ) : ZMod M64) = (((l.map G).sum : ℤ) : ZMod M64) := by
  induction l with
  | nil => simp
  | cons a l ih =>
      rw [List.map_cons, List.sum_cons, List.map_cons, List.sum_cons, Nat.cast_add, Int.cast_add, h a, ih]

/-! ### Four factors -/

abbrev S4 := ℕ × ℕ × ℕ × ℕ
def add4 (o d : S4) : S4 :=
  (Nat.add o.1 d.1, Nat.add o.2.1 d.2.1, Nat.add o.2.2.1 d.2.2.1, Nat.add o.2.2.2 d.2.2.2)
theorem add4_eq (o d : S4) : add4 o d = o + d := rfl
def leaf4 (T1 T2 T3 T4 : ℕ) (o : S4) : ℕ :=
  Nat.mul (Nat.mul (lkm T1 o.1) (lkm T2 o.2.1)) (Nat.mul (lkm T3 o.2.2.1) (lkm T4 o.2.2.2))

/-- a pattern compiled to the bit strides of four factors -/
def strides4 (f1 f2 f3 f4 : Fac) (p : List (ℕ × ℕ)) : List S4 :=
  p.map fun q => (64 * Fac.dk q.1 q.2 f1, 64 * Fac.dk q.1 q.2 f2, 64 * Fac.dk q.1 q.2 f3, 64 * Fac.dk q.1 q.2 f4)
theorem dotS_strides4 (f1 f2 f3 f4 : Fac) : ∀ (p : List (ℕ × ℕ)) (a : List ℕ),
    dotS (strides4 f1 f2 f3 f4 p) a = (64 * lin p a f1, 64 * lin p a f2, 64 * lin p a f3, 64 * lin p a f4)
  | [], a => by cases a <;> rfl
  | (x, y) :: p, [] => rfl
  | (x, y) :: p, v :: a => by
      have ih := dotS_strides4 f1 f2 f3 f4 p a
      simp only [strides4, List.map_cons] at ih ⊢
      rw [dotS, ih]
      simp only [lin, Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul]
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_)) <;> simp only <;> ring

/-- **the fast evaluator**: four factors, a compiled pattern, an integer jet -/
def fast4 (f1 f2 f3 f4 : Fac) (Z : ZJet) (ds : List S4) : ℤ :=
  dec (nest add4 (leaf4 (packL (f1.tabZ Z)) (packL (f2.tabZ Z)) (packL (f3.tabZ Z)) (packL (f4.tabZ Z))) ds (0, 0, 0, 0))
theorem fast4_correct (f1 f2 f3 f4 : Fac) (p : List (ℕ × ℕ)) (J : Jet) (hp : goodB p = true) (hl : p.length ≤ 5)
    (hJ : intJet J) : evF [f1, f2, f3, f4] p J = (fast4 f1 f2 f3 f4 J.toZ (strides4 f1 f2 f3 f4 p) : ℚ) := by
  set Z := J.toZ
  have hZ : Z.toJet = J := intJet_toJet J hJ
  set z : Fac → List ℕ → ℤ := fun f a => (f.tabZ Z).getD (f.idx (slotv p a)) 0 with hz
  have hev : evF [f1, f2, f3, f4] p J = ((((asgs p.length).map fun a => z f1 a * (z f2 a * (z f3 a * z f4 a))).sum : ℤ) : ℚ) := by
    rw [← hZ, evF_sum, Int.cast_list_sum, List.map_map]
    congr 1
    apply List.map_congr_left
    intro a _
    simp [prodL, val_toJet, hz]
  rw [hev]
  congr 1
  unfold fast4
  have hlen : (strides4 f1 f2 f3 f4 p).length = p.length := List.length_map ..
  rw [nest_eq add4 add4_eq, hlen]
  symm
  apply dec_eq
  · apply mod_of_zmod
    apply zmod_sum
    intro a
    rw [show ((0, 0, 0, 0) : S4) = 0 from rfl, zero_add, dotS_strides4]
    have hs : slotw p a = slotv p a := funext fun s => (slotv_eq p a s hp).symm
    simp only [leaf4, Nat.mul_eq, ← idx_slotw, hs, lkm_packL]
    push_cast [enc_zmod]
    simp only [hz]; ring
  · have hb : ∀ a, |z f1 a * (z f2 a * (z f3 a * z f4 a))| ≤ 100 ^ 4 := fun a => by
      rw [abs_mul, abs_mul, abs_mul]
      have b1 := bound_tab J hJ f1 (f1.idx (slotv p a)); have b2 := bound_tab J hJ f2 (f2.idx (slotv p a))
      have b3 := bound_tab J hJ f3 (f3.idx (slotv p a)); have b4 := bound_tab J hJ f4 (f4.idx (slotv p a))
      have := mul_le_mul b3 b4 (abs_nonneg _) (by norm_num)
      have := mul_le_mul b2 this (by positivity) (by norm_num)
      have := mul_le_mul b1 this (by positivity) (by norm_num)
      simpa [hz] using this.trans (by norm_num)
    have h1 := abs_sum_le (asgs p.length) _ _ hb
    rw [length_asgs] at h1
    have h2 : (3 : ℤ) ^ p.length ≤ 3 ^ 5 := pow_le_pow_right₀ (by norm_num) hl
    have h3 : ((3 ^ p.length : ℕ) : ℤ) = 3 ^ p.length := by push_cast; rfl
    rw [h3] at h1
    calc _ ≤ _ := h1
      _ ≤ (3 : ℤ) ^ 5 * 100 ^ 4 := by gcongr
      _ < 2 ^ 63 := by norm_num

/-! ### The divergences: four terms on one pattern, eight factor slots -/

abbrev Sx8 := S4 × S4
def add8 (o d : Sx8) : Sx8 := (add4 o.1 d.1, add4 o.2 d.2)
theorem add8_eq (o d : Sx8) : add8 o d = o + d := rfl

/-- `∇w·h·h·h + u·(∇u·h·h + h·∇u·h + h·h·∇u)`, the Leibniz expansion of `∇(u h h h)`, read from three packed tensors -/
def leafD (TW TH TU : ℕ) (o : Sx8) : ℕ :=
  Nat.add (Nat.mul (Nat.mul (lkm TW o.1.1) (lkm TH o.1.2.1)) (Nat.mul (lkm TH o.1.2.2.1) (lkm TH o.1.2.2.2)))
    (Nat.mul (lkm TU o.2.1)
      (Nat.add (Nat.mul (lkm TU o.2.2.1) (Nat.mul (lkm TH o.1.2.2.1) (lkm TH o.1.2.2.2)))
        (Nat.add (Nat.mul (lkm TH o.1.2.1) (Nat.mul (lkm TU o.2.2.2.1) (lkm TH o.1.2.2.2)))
          (Nat.mul (lkm TH o.1.2.1) (Nat.mul (lkm TH o.1.2.2.1) (lkm TU o.2.2.2.2))))))

/-- the eight factor slots of `evDiv`'s four terms -/
def gD1 : Fac := .w 9 0 1 2
def gD2 : Fac := .h 3 4
def gD3 : Fac := .h 5 6
def gD4 : Fac := .h 7 8
def gD5 : Fac := .u 0 1 2
def gD6 : Fac := .u 9 3 4
def gD7 : Fac := .u 9 5 6
def gD8 : Fac := .u 9 7 8
def strides8 (p : List (ℕ × ℕ)) : List Sx8 := (strides4 gD1 gD2 gD3 gD4 p).zip (strides4 gD5 gD6 gD7 gD8 p)
theorem dotS_zip : ∀ (ds es : List S4) (a : List ℕ), ds.length = es.length →
    dotS (ds.zip es) a = (dotS ds a, dotS es a)
  | [], [], a, _ => by cases a <;> rfl
  | d :: ds, e :: es, [], _ => rfl
  | d :: ds, e :: es, v :: a, h => by
      rw [List.zip_cons_cons, dotS, dotS, dotS, dotS_zip ds es a (by simpa using h)]; rfl
  | [], _ :: _, _, h => by simp at h
  | _ :: _, [], _, h => by simp at h

/-- **the fast evaluator for a divergence** -/
def fastD (Z : ZJet) (ds : List Sx8) : ℤ :=
  dec (nest add8 (leafD (packL Z.w) (packL Z.h) (packL Z.u)) ds ((0, 0, 0, 0), (0, 0, 0, 0)))
theorem fastD_correct (v : ℕ × List (ℕ × ℕ)) (J : Jet) (hp : goodB (v.2 ++ [(9, v.1)]) = true)
    (hl : (v.2 ++ [(9, v.1)]).length ≤ 5) (hJ : intJet J) :
    evDiv v J = (fastD J.toZ (strides8 (v.2 ++ [(9, v.1)])) : ℚ) := by
  set p := v.2 ++ [(9, v.1)] with hpdef
  set Z := J.toZ
  have hZ : Z.toJet = J := intJet_toJet J hJ
  set z : Fac → List ℕ → ℤ := fun f a => (f.tabZ Z).getD (f.idx (slotv p a)) 0 with hz
  have hev : evDiv v J = ((((asgs p.length).map fun a =>
      z gD1 a * (z gD2 a * (z gD3 a * z gD4 a)) + z gD5 a * (z gD6 a * (z gD3 a * z gD4 a)) +
        z gD5 a * (z gD2 a * (z gD7 a * z gD4 a)) + z gD5 a * (z gD2 a * (z gD3 a * z gD8 a))).sum : ℤ) : ℚ) := by
    unfold evDiv
    simp only [← hpdef]
    rw [← hZ, evF_sum, evF_sum, evF_sum, evF_sum, Int.cast_list_sum, List.map_map, ← List.sum_map_add,
      ← List.sum_map_add, ← List.sum_map_add]
    congr 1
    apply List.map_congr_left
    intro a _
    simp [prodL, val_toJet, hz, gD1, gD2, gD3, gD4, gD5, gD6, gD7, gD8]
  rw [hev]
  congr 1
  unfold fastD
  have hlen : (strides8 p).length = p.length := by simp [strides8, strides4]
  rw [nest_eq add8 add8_eq, hlen]
  symm
  apply dec_eq
  · apply mod_of_zmod
    apply zmod_sum
    intro a
    rw [show (((0, 0, 0, 0), (0, 0, 0, 0)) : Sx8) = 0 from rfl, zero_add, strides8,
      dotS_zip _ _ _ (by simp [strides4]), dotS_strides4, dotS_strides4]
    have hs : slotw p a = slotv p a := funext fun s => (slotv_eq p a s hp).symm
    have t1 : packL Z.w = packL (gD1.tabZ Z) := rfl
    have t2 : packL Z.h = packL (gD2.tabZ Z) := rfl
    have t3 : packL Z.u = packL (gD5.tabZ Z) := rfl
    simp only [leafD, Nat.mul_eq, Nat.add_eq]
    rw [t1, t2, t3]
    simp only [← idx_slotw, hs, lkm_packL]
    push_cast [enc_zmod]
    simp only [hz, gD1, gD2, gD3, gD4, gD5, gD6, gD7, gD8, Fac.tabZ]; ring
  · have hb : ∀ a, |z gD1 a * (z gD2 a * (z gD3 a * z gD4 a)) + z gD5 a * (z gD6 a * (z gD3 a * z gD4 a)) +
        z gD5 a * (z gD2 a * (z gD7 a * z gD4 a)) + z gD5 a * (z gD2 a * (z gD3 a * z gD8 a))| ≤ 4 * 100 ^ 4 := by
      intro a
      have b : ∀ f, |z f a| ≤ 100 := fun f => bound_tab J hJ f (f.idx (slotv p a))
      have m4 : ∀ f1 f2 f3 f4, |z f1 a * (z f2 a * (z f3 a * z f4 a))| ≤ 100 ^ 4 := fun f1 f2 f3 f4 => by
        rw [abs_mul, abs_mul, abs_mul]
        have := mul_le_mul (b f3) (b f4) (abs_nonneg _) (by norm_num)
        have := mul_le_mul (b f2) this (by positivity) (by norm_num)
        have := mul_le_mul (b f1) this (by positivity) (by norm_num)
        exact this.trans (by norm_num)
      have e1 := abs_add_le (z gD1 a * (z gD2 a * (z gD3 a * z gD4 a)) + z gD5 a * (z gD6 a * (z gD3 a * z gD4 a)) +
        z gD5 a * (z gD2 a * (z gD7 a * z gD4 a))) (z gD5 a * (z gD2 a * (z gD3 a * z gD8 a)))
      have e2 := abs_add_le (z gD1 a * (z gD2 a * (z gD3 a * z gD4 a)) + z gD5 a * (z gD6 a * (z gD3 a * z gD4 a)))
        (z gD5 a * (z gD2 a * (z gD7 a * z gD4 a)))
      have e3 := abs_add_le (z gD1 a * (z gD2 a * (z gD3 a * z gD4 a))) (z gD5 a * (z gD6 a * (z gD3 a * z gD4 a)))
      linarith [m4 gD1 gD2 gD3 gD4, m4 gD5 gD6 gD3 gD4, m4 gD5 gD2 gD7 gD4, m4 gD5 gD2 gD3 gD8]
    have h1 := abs_sum_le (asgs p.length) _ _ hb
    rw [length_asgs] at h1
    have h2 : (3 : ℤ) ^ p.length ≤ 3 ^ 5 := pow_le_pow_right₀ (by norm_num) hl
    have h3 : ((3 ^ p.length : ℕ) : ℤ) = 3 ^ p.length := by push_cast; rfl
    rw [h3] at h1
    calc _ ≤ _ := h1
      _ ≤ (3 : ℤ) ^ 5 * (4 * 100 ^ 4) := by gcongr
      _ < 2 ^ 63 := by norm_num

