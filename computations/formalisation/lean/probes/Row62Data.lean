def δ (a b : ℕ) : ℚ := if a = b then 1 else 0

/-- **transverse-traceless, with the curvature commutator imposed** (the receipt's `solve_jet` equations): `h`
symmetric traceless; `∇_c h_ab` symmetric, traceless and transverse; `∇_c ∇_d h_ab` symmetric, traceless,
transverse in `(c, a)`, and `[∇_c, ∇_d] h_ab = −(δ_ad h_cb − δ_ac h_db + δ_bd h_ac − δ_bc h_ad)`, the unit-sphere
curvature commutator -/
abbrev IsTT (J : Jet) : Prop :=
  (∀ a b : Fin 3, J.H a b = J.H b a) ∧ J.H 0 0 + J.H 1 1 + J.H 2 2 = 0 ∧
  (∀ c a b : Fin 3, J.U c a b = J.U c b a) ∧ (∀ c : Fin 3, J.U c 0 0 + J.U c 1 1 + J.U c 2 2 = 0) ∧
  (∀ b : Fin 3, J.U 0 0 b + J.U 1 1 b + J.U 2 2 b = 0) ∧
  (∀ c d a b : Fin 3, J.W c d a b = J.W c d b a) ∧ (∀ c d : Fin 3, J.W c d 0 0 + J.W c d 1 1 + J.W c d 2 2 = 0) ∧
  (∀ c b : Fin 3, J.W c 0 0 b + J.W c 1 1 b + J.W c 2 2 b = 0) ∧
  (∀ c d a b : Fin 3, J.W c d a b - J.W d c a b =
    -(δ a d * J.H c b - δ a c * J.H d b + δ b d * J.H a c - δ b c * J.H a d))

/-- the same without transversality (the receipt's `transverse=False`) -/
abbrev IsTraceless (J : Jet) : Prop :=
  (∀ a b : Fin 3, J.H a b = J.H b a) ∧ J.H 0 0 + J.H 1 1 + J.H 2 2 = 0 ∧
  (∀ c a b : Fin 3, J.U c a b = J.U c b a) ∧ (∀ c : Fin 3, J.U c 0 0 + J.U c 1 1 + J.U c 2 2 = 0) ∧
  (∀ c d a b : Fin 3, J.W c d a b = J.W c d b a) ∧ (∀ c d : Fin 3, J.W c d 0 0 + J.W c d 1 1 + J.W c d 2 2 = 0) ∧
  (∀ c d a b : Fin 3, J.W c d a b - J.W d c a b =
    -(δ a d * J.H c b - δ a c * J.H d b + δ b d * J.H a c - δ b c * J.H a d))

/-- `u`'s transversality, `∇^a h_ab = 0` -/
abbrev UTransverse (J : Jet) : Prop := ∀ b : Fin 3, J.U 0 0 b + J.U 1 1 b + J.U 2 2 b = 0

/-- the frame commutator `e_c e_d H − e_d e_c H = C^f_cd e_f H = 2 ε_cdf e_f H` -/
abbrev FrameComm (F : FJet) : Prop :=
  ∀ c d : Fin 3, ∀ n : Fin 9, (F.DD.getD (3 * c + d) m0).getD n 0 - (F.DD.getD (3 * d + c) m0).getD n 0 =
    2 * (eps c d 0 * (F.D.getD 0 m0).getD n 0 + eps c d 1 * (F.D.getD 1 m0).getD n 0 + eps c d 2 * (F.D.getD 2 m0).getD n 0)

theorem jets_length : jets.length = 17 ∧ ctrlJets.length = 12 ∧ falsJets.length = 6 := by decide +kernel

/-- ⛭ **THE SEVENTEEN JETS ARE TRANSVERSE-TRACELESS WITH THE CURVATURE COMMUTATOR IMPOSED**, and the commutator turns
into the frame commutator `C^c_ab` on every one of them. -/
theorem jets_TT : ∀ k < 17, IsTT (jets.getD k default) := by decide +kernel

theorem jets_frame_commutator : ∀ k < 17, FrameComm (toFrame (jets.getD k default)) := by decide +kernel

/-- the control jets are traceless with the commutator imposed, and NOT transverse -/
theorem ctrl_jets : ∀ k < 12, IsTraceless (ctrlJets.getD k default) ∧ ¬ UTransverse (ctrlJets.getD k default) := by
  decide +kernel

theorem fals_jets : ∀ k < 6, IsTraceless (falsJets.getD k default) ∧ ¬ UTransverse (falsJets.getD k default) := by
  decide +kernel

