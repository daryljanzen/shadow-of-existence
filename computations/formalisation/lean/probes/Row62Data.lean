open Matrix

/-! ## 0. Rank certificates over `ℚ`

A matrix is stored as a list of rows. `Mx m n t` reads it as a `Matrix (Fin m) (Fin n) ℚ`.
- **Upper bound** (`rank_le_cert`): every row is `lcomb` of `r` stated rows, so `M = L * B` with `L` of width `r`.
- **Lower bound** (`rank_ge_cert`): an `r × r` submatrix `S` and a matrix `T` with `S * T = 1`. `S` is then
  invertible, a nonzero square minor, and `r ≤ rank M`.
The list identities are checked by `decide +kernel`; the two lemmas turn them into `Matrix.rank` facts. -/

/-- padded `zipWith` (structural in the first list, so the kernel reduces it) -/
def zw (f : ℚ → ℚ → ℚ) : List ℚ → List ℚ → List ℚ
  | a :: x, b :: y => f a b :: zw f x y
  | a :: x, [] => (a :: x).map fun c => f c 0
  | [], y => y.map fun c => f 0 c

theorem getD_map0 (g : ℚ → ℚ) (hg : g 0 = 0) : ∀ (l : List ℚ) (j : ℕ), (l.map g).getD j 0 = g (l.getD j 0)
  | [], j => by simp [hg]
  | a :: l, 0 => by simp
  | a :: l, j + 1 => by rw [List.map_cons, List.getD_cons_succ, List.getD_cons_succ, getD_map0 g hg l j]

theorem zw_getD (f : ℚ → ℚ → ℚ) (hf : f 0 0 = 0) :
    ∀ (x y : List ℚ) (j : ℕ), (zw f x y).getD j 0 = f (x.getD j 0) (y.getD j 0)
  | a :: x, b :: y, 0 => by simp [zw]
  | a :: x, b :: y, j + 1 => by
      rw [zw, List.getD_cons_succ, List.getD_cons_succ, List.getD_cons_succ, zw_getD f hf x y j]
  | a :: x, [], j => by rw [zw, getD_map0 (fun c => f c 0) hf]; simp
  | [], y, j => by rw [zw, getD_map0 (fun c => f 0 c) hf]; simp

/-- `Σ_k c_k · r_k`, a linear combination of rows -/
def lcomb : List ℚ → List (List ℚ) → List ℚ
  | c :: cs, r :: rs => zw (fun a b => c * a + b) r (lcomb cs rs)
  | _, _ => []

theorem lcomb_getD : ∀ (cs : List ℚ) (rs : List (List ℚ)) (j : ℕ), rs.length = cs.length →
    (lcomb cs rs).getD j 0 = ∑ k ∈ Finset.range cs.length, cs.getD k 0 * (rs.getD k []).getD j 0
  | [], rs, j, _ => by simp [lcomb]
  | c :: cs, [], j, h => by simp at h
  | c :: cs, r :: rs, j, h => by
      rw [lcomb, zw_getD _ (by simp), lcomb_getD cs rs j (by simpa using h), List.length_cons,
        Finset.sum_range_succ']
      simp [add_comm]

/-- a list of rows, read as a matrix -/
def Mx (m n : ℕ) (t : List (List ℚ)) : Matrix (Fin m) (Fin n) ℚ := Matrix.of fun i j => (t.getD i []).getD j 0

/-- **rank ≤ r**: every row of `t` is the stated combination `L_i` of the `r` rows `B` -/
theorem rank_le_cert {m n r : ℕ} (t L B : List (List ℚ)) (hB : B.length = r)
    (hL : ∀ i < m, (L.getD i []).length = r) (h : ∀ i < m, t.getD i [] = lcomb (L.getD i []) B) :
    (Mx m n t).rank ≤ r := by
  have e : Mx m n t = Mx m r L * Mx r n B := by
    ext i j
    simp only [Mx, Matrix.mul_apply, Matrix.of_apply]
    rw [h i i.2, lcomb_getD _ _ _ (by rw [hB, hL i i.2]), hL i i.2, Finset.sum_range]
  rw [e]; exact (Matrix.rank_mul_le_left _ _).trans (Matrix.rank_le_width _)

/-- **an invertible minor**: the `r × r` submatrix on rows `ρ` and columns `γ` (stated as `S`, and checked entry by
entry against `t`) has the right inverse `T` -/
theorem isUnit_cert {m n r : ℕ} (t S T : List (List ℚ)) (ρ : Fin r → Fin m) (γ : Fin r → Fin n)
    (hT : T.length = r) (hSl : ∀ i < r, (S.getD i []).length = r)
    (hS : ∀ i j : Fin r, (S.getD i []).getD j 0 = (t.getD (ρ i) []).getD (γ j) 0)
    (h : ∀ i < r, lcomb (S.getD i []) T = (List.range r).map fun j => if i = j then (1 : ℚ) else 0) :
    IsUnit ((Mx m n t).submatrix ρ γ) := by
  have hST : (Mx m n t).submatrix ρ γ * Mx r r T = 1 := by
    refine Matrix.ext fun i j => ?_
    have hij : (lcomb (S.getD i []) T).getD j 0 =
        ((List.range r).map fun j => if (i : ℕ) = j then (1 : ℚ) else 0).getD j 0 := by rw [h i i.2]
    rw [lcomb_getD _ _ _ (by rw [hT, hSl i i.2]), hSl i i.2, Finset.sum_range] at hij
    rw [Matrix.mul_apply, Matrix.one_apply]
    have e1 : ((List.range r).map fun j => if (i : ℕ) = j then (1 : ℚ) else 0).getD j 0 =
        if i = j then 1 else 0 := by
      simp [List.getD_eq_getElem?_getD, Fin.val_inj]
    rw [e1] at hij
    rw [← hij]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [Matrix.submatrix_apply, Mx, Matrix.of_apply]
    rw [hS i k]
  exact (Matrix.isUnit_iff_isUnit_det _).2 (Matrix.isUnit_det_of_right_inverse hST)

theorem rank_ge_of_isUnit {m n r : ℕ} (M : Matrix (Fin m) (Fin n) ℚ) (ρ : Fin r → Fin m) (γ : Fin r → Fin n)
    (hu : IsUnit (M.submatrix ρ γ)) : r ≤ M.rank := by
  have := Matrix.rank_submatrix_le M ρ γ
  rw [Matrix.rank_of_isUnit _ hu, Fintype.card_fin] at this
  exact this

/-- **r ≤ rank**: the minor on the listed rows `rs` and columns `cs` is invertible -/
theorem rank_ge_cert {m n r : ℕ} (t : List (List ℚ)) (rs cs : List ℕ) (S T : List (List ℚ))
    (hT : T.length = r) (hSl : ∀ i < r, (S.getD i []).length = r)
    (hrm : ∀ k < r, rs.getD k 0 < m) (hcn : ∀ k < r, cs.getD k 0 < n)
    (hS : ∀ i < r, ∀ j < r, (S.getD i []).getD j 0 = (t.getD (rs.getD i 0) []).getD (cs.getD j 0) 0)
    (h : ∀ i < r, lcomb (S.getD i []) T = (List.range r).map fun j => if i = j then (1 : ℚ) else 0) :
    r ≤ (Mx m n t).rank :=
  rank_ge_of_isUnit _ (fun k : Fin r => (⟨rs.getD k 0, hrm k k.2⟩ : Fin m))
    (fun k : Fin r => (⟨cs.getD k 0, hcn k k.2⟩ : Fin n))
    (isUnit_cert t S T _ _ hT hSl (fun i j => hS i i.2 j j.2) h)

/-- a matrix-vector product, read off a list computation -/
theorem mulVec_cert {m n : ℕ} (t : List (List ℚ)) (v : List ℚ) (hv : v.length = n)
    (ht : ∀ i < m, (t.getD i []).length = n) (i : Fin m) :
    (Mx m n t *ᵥ fun j => v.getD j 0) i = (lcomb (t.getD i []) (v.map fun c => [c])).getD 0 0 := by
  rw [lcomb_getD _ _ _ (by rw [List.length_map, hv, ht i i.2]), ht i i.2, Finset.sum_range]
  simp only [Matrix.mulVec, dotProduct, Mx, Matrix.of_apply]
  refine Finset.sum_congr rfl fun k _ => ?_
  have hk : (k : ℕ) < v.length := hv ▸ k.2
  simp [List.getD_eq_getElem?_getD, hk]


/-! ## 1. The enumeration of admissible contractions -/

/-- the receipt's `matchings`: perfect matchings of a list of slots, in its order -/
def matchings : ℕ → List ℕ → List (List (ℕ × ℕ))
  | 0, _ => [[]]
  | _ + 1, [] => [[]]
  | f + 1, p :: rest => (List.range rest.length).flatMap fun t =>
      (matchings f (rest.eraseIdx t)).map fun m => (p, rest.getD t 0) :: m

/-- a matching is admissible when no pair lies inside one factor (`g` gives each slot's factor) -/
def admissible (g : List ℕ) (p : List (ℕ × ℕ)) : Bool := p.all fun (x, y) => g.getD x 0 != g.getD y 0

/-- the factor of each slot in `(∇h)(∇h)hh`, `(∇∇h)hhh`, `hhhh` -/
def GA : List ℕ := [0, 0, 0, 1, 1, 1, 2, 2, 3, 3]
def GB : List ℕ := [0, 1, 2, 3, 4, 4, 5, 5, 6, 6]
def GQ : List ℕ := [0, 0, 1, 1, 2, 2, 3, 3]

def ADM_A : List (List (ℕ × ℕ)) := (matchings 10 (List.range 10)).filter (admissible GA)
def ADM_B : List (List (ℕ × ℕ)) := (matchings 10 (List.range 10)).filter (admissible GB)
def ADM_Q : List (List (ℕ × ℕ)) := (matchings 8 (List.range 8)).filter (admissible GQ)
/-- the divergences `∇_n (∇h hhh)`: the free slot `f` of `(∇h)hhh` paired with the new derivative `n`, and a matching of the
other eight -/
def PV : List (ℕ × List (ℕ × ℕ)) :=
  (List.range 9).flatMap fun f => (matchings 9 ((List.range 9).erase f)).map fun m => (f, m)

/-- ⛭ **THE ENUMERATION IS `372 / 672 / 60 / 945`.** -/
theorem enumeration : ADM_A.length = 372 ∧ ADM_B.length = 672 ∧ ADM_Q.length = 60 ∧ PV.length = 945 := by
  decide +kernel

/-! ## 2. The jets, the contractions, and the frame Koszul formula -/

/-- a jet at a point: `h_ab` (index `3a+b`), `u = ∇_c h_ab` (index `9c+3a+b`), `w = ∇_c ∇_d h_ab` (index `27c+9d+3a+b`) -/
structure Jet where
  h : List ℚ
  u : List ℚ
  w : List ℚ
deriving Inhabited

def Jet.H (J : Jet) (a b : ℕ) : ℚ := J.h.getD (3 * a + b) 0
def Jet.U (J : Jet) (c a b : ℕ) : ℚ := J.u.getD (9 * c + 3 * a + b) 0
def Jet.W (J : Jet) (c d a b : ℕ) : ℚ := J.w.getD (27 * c + 9 * d + 3 * a + b) 0

/-- a factor of a contraction, by its slots -/
inductive Fac
  | h (a b : ℕ)
  | u (c a b : ℕ)
  | w (c d a b : ℕ)

def Fac.val (J : Jet) (ix : ℕ → ℕ) : Fac → ℚ
  | .h a b => J.H (ix a) (ix b)
  | .u c a b => J.U (ix c) (ix a) (ix b)
  | .w c d a b => J.W (ix c) (ix d) (ix a) (ix b)

/-- all assignments of `n` index values in `{0,1,2}` -/
def asgs : ℕ → List (List ℕ)
  | 0 => [[]]
  | n + 1 => (asgs n).flatMap fun a => [0 :: a, 1 :: a, 2 :: a]

/-- the index value of slot `s` under a matching `p` and an assignment `a` of its pairs -/
def slotv (p : List (ℕ × ℕ)) (a : List ℕ) (s : ℕ) : ℕ :=
  (p.zip a).foldr (fun ((x, y), v) acc => if x = s ∨ y = s then v else acc) 0

def prodL : List ℚ → ℚ
  | [] => 1
  | x :: l => x * prodL l

/-- the receipt's `ev`: the full contraction of the factors `fs` along the matching `p`, at the jet `J` -/
def evF (fs : List Fac) (p : List (ℕ × ℕ)) (J : Jet) : ℚ :=
  (asgs p.length).foldr (fun a acc => prodL (fs.map (Fac.val J (slotv p a))) + acc) 0

def FA : List Fac := [.u 0 1 2, .u 3 4 5, .h 6 7, .h 8 9]
def FB : List Fac := [.w 0 1 2 3, .h 4 5, .h 6 7, .h 8 9]
def FQ : List Fac := [.h 0 1, .h 2 3, .h 4 5, .h 6 7]
/-- the receipt's `div_terms`: `∇_n` of `(∇h)hhh` by Leibniz, the new slot `n` being `9` -/
def evDiv (v : ℕ × List (ℕ × ℕ)) (J : Jet) : ℚ :=
  let p := v.2 ++ [(9, v.1)]
  evF [.w 9 0 1 2, .h 3 4, .h 5 6, .h 7 8] p J + evF [.u 0 1 2, .u 9 3 4, .h 5 6, .h 7 8] p J
    + evF [.u 0 1 2, .h 3 4, .u 9 5 6, .h 7 8] p J + evF [.u 0 1 2, .h 3 4, .h 5 6, .u 9 7 8] p J

/-- `ε_abc` -/
def eps (a b c : ℕ) : ℚ :=
  if a = 0 ∧ b = 1 ∧ c = 2 ∨ a = 1 ∧ b = 2 ∧ c = 0 ∨ a = 2 ∧ b = 0 ∧ c = 1 then 1
  else if a = 0 ∧ b = 2 ∧ c = 1 ∨ a = 2 ∧ b = 1 ∧ c = 0 ∨ a = 1 ∧ b = 0 ∧ c = 2 then -1 else 0

def r3 : List ℕ := [0, 1, 2]
def sum3 {α : Type} [Add α] (f : ℕ → α) : α := f 0 + f 1 + f 2

/-- a `3 × 3` matrix, row-major -/
abbrev M3 := List ℚ

/-- a jet in the background frame: `H`, `e_c H` (three matrices) and `e_c e_d H` (index `3c+d`) -/
structure FJet where
  H : M3
  D : List M3
  DD : List M3

/-- the receipt's `to_frame`: `∇_c T_ab = e_c T_ab − ε_cad T_db − ε_cbd T_ad`, read for `e_c` -/
def toFrame (J : Jet) : FJet :=
  let eH : ℕ → ℕ → ℕ → ℚ := fun c a b => J.U c a b + sum3 fun x => eps c a x * J.H x b + eps c b x * J.H a x
  let ecu : ℕ → ℕ → ℕ → ℕ → ℚ := fun c d a b => J.W c d a b +
    sum3 fun x => eps c d x * J.U x a b + eps c a x * J.U d x b + eps c b x * J.U d a x
  let eeH : ℕ → ℕ → ℕ → ℕ → ℚ := fun c d a b => ecu c d a b + sum3 fun x => eps d a x * eH c x b + eps d b x * eH c a x
  ⟨J.h, r3.map fun c => r3.flatMap fun a => r3.map fun b => eH c a b,
    r3.flatMap fun c => r3.map fun d => r3.flatMap fun a => r3.map fun b => eeH c d a b⟩

/-! ### The frame Koszul formula on truncated `ε`-series: the receipt's `curvature_series` -/

/-- a truncated `ε`-series: the coefficients of `ε⁰ … ε⁴` (the receipt's `NORD = 5`) -/
abbrev Ser := List ℚ

def sadd (x y : Ser) : Ser := List.zipWith (· + ·) x y
def ssub (x y : Ser) : Ser := List.zipWith (· - ·) x y
def ssc (q : ℚ) (x : Ser) : Ser := x.map (q * ·)
def s0 : Ser := [0, 0, 0, 0, 0]
/-- the product, truncated at `ε⁵` -/
def smul : Ser → Ser → Ser
  | [x0, x1, x2, x3, x4], [y0, y1, y2, y3, y4] =>
      [x0 * y0, x0 * y1 + x1 * y0, x0 * y2 + x1 * y1 + x2 * y0,
       x0 * y3 + x1 * y2 + x2 * y1 + x3 * y0, x0 * y4 + x1 * y3 + x2 * y2 + x3 * y1 + x4 * y0]
  | _, _ => s0
def ssum (l : List Ser) : Ser := l.foldr sadd s0
def ssum3 (f : ℕ → Ser) : Ser := sadd (f 0) (sadd (f 1) (f 2))

/-- `C^x_ab = 2 ε_abx` -/
def C (x a b : ℕ) : ℚ := 2 * eps a b x

def g2 (t : List Ser) (a b : ℕ) : Ser := t.getD (3 * a + b) s0
def g3 (t : List Ser) (a b c : ℕ) : Ser := t.getD (9 * a + 3 * b + c) s0
def g4 (t : List Ser) (a b c d : ℕ) : Ser := t.getD (27 * a + 9 * b + 3 * c + d) s0
def tab2 (f : ℕ → ℕ → Ser) : List Ser := r3.flatMap fun a => r3.map fun b => f a b
def tab3 (f : ℕ → ℕ → ℕ → Ser) : List Ser := r3.flatMap fun a => r3.flatMap fun b => r3.map fun c => f a b c
def tab4 (f : ℕ → ℕ → ℕ → ℕ → Ser) : List Ser :=
  r3.flatMap fun a => r3.flatMap fun b => r3.flatMap fun c => r3.map fun d => f a b c d

/-- the receipt's `scalar`: the Koszul connection `Γ_abc`, `Γ^x_ab`, its frame derivative, the Riemann tensor
`R^x_cab = e_a Γ^x_bc − e_b Γ^x_ac + Γ^x_az Γ^z_bc − Γ^x_bz Γ^z_ac − C^z_ab Γ^x_zc`, the Ricci tensor and the scalar,
for a metric `γ` given in the frame with inverse `γ⁻¹`, first derivatives `dγ` (index `9a+3b+c` for `e_a γ_bc`) and
second derivatives `ddγ` (index `27y+9a+3b+c` for `e_y e_a γ_bc`) -/
def scalarS (gam gaminv dgam ddgam : List Ser) : Ser :=
  let G3 := tab3 fun a b c => ssc (1/2) (ssum [g3 dgam a b c, g3 dgam b a c, ssc (-1) (g3 dgam c a b),
      ssum3 fun x => ssum [ssc (C x a b) (g2 gam x c), ssc (-C x b c) (g2 gam x a), ssc (C x c a) (g2 gam x b)]])
  let GU := tab3 fun x a b => ssum3 fun c => smul (g2 gaminv x c) (g3 G3 a b c)
  let dginv := tab3 fun a i j => ssc (-1) (ssum3 fun p => ssum3 fun q =>
      smul (g2 gaminv i p) (smul (g3 dgam a p q) (g2 gaminv q j)))
  let dG3 := tab4 fun y a b c => ssc (1/2) (ssum [g4 ddgam y a b c, g4 ddgam y b a c, ssc (-1) (g4 ddgam y c a b),
      ssum3 fun x => ssum [ssc (C x a b) (g3 dgam y x c), ssc (-C x b c) (g3 dgam y x a), ssc (C x c a) (g3 dgam y x b)]])
  let dGU := tab4 fun y x a b => ssum3 fun c =>
      sadd (smul (g3 dginv y x c) (g3 G3 a b c)) (smul (g2 gaminv x c) (g4 dG3 y a b c))
  let Rie := fun x c a b => ssum [g4 dGU a x b c, ssc (-1) (g4 dGU b x a c),
      ssum3 fun z => ssub (smul (g3 GU x a z) (g3 GU z b c)) (smul (g3 GU x b z) (g3 GU z a c)),
      ssc (-1) (ssum3 fun z => ssc (C z a b) (g3 GU x z c))]
  let Ric := tab2 fun b c => ssum3 fun a => Rie a c a b
  ssum3 fun b => ssum3 fun c => smul (g2 gaminv b c) (g2 Ric b c)

/-- letters of a word in the series of `exp(εH)` and its derivatives: `H`, `e_c H`, `e_c e_d H` -/
inductive Let
  | H
  | D (c : ℕ)
  | DD (c d : ℕ)

/-- the receipt's `DERL`: `e_c` of a letter -/
def Let.der (c : ℕ) : Let → Let
  | .H => .D c
  | .D d => .DD c d
  | .DD _ _ => .H

/-- the receipt's `dser`, on one word: Leibniz over its letters -/
def wder (c : ℕ) (w : List Let) : List (List Let) :=
  (List.range w.length).map fun i => w.modify i (Let.der c)

def mmul (x y : M3) : M3 :=
  r3.flatMap fun a => r3.map fun b => x.getD (3 * a) 0 * y.getD b 0 + x.getD (3 * a + 1) 0 * y.getD (3 + b) 0
    + x.getD (3 * a + 2) 0 * y.getD (6 + b) 0
def mid : M3 := [1, 0, 0, 0, 1, 0, 0, 0, 1]
def madd (x y : M3) : M3 := List.zipWith (· + ·) x y
def m0 : M3 := [0, 0, 0, 0, 0, 0, 0, 0, 0]

def Let.ev (J : FJet) : Let → M3
  | .H => J.H
  | .D c => J.D.getD c m0
  | .DD c d => J.DD.getD (3 * c + d) m0
def wev (J : FJet) (w : List Let) : M3 := w.foldl (fun P l => mmul P (l.ev J)) mid
def wsum (J : FJet) (ws : List (List Let)) : M3 := ws.foldr (fun w acc => madd (wev J w) acc) m0

def fact : ℕ → ℚ
  | 0 => 1
  | n + 1 => (n + 1) * fact n

/-- the receipt's `ser_poly` of `Σ_k sgᵏ/k! · (words)`: a table of nine entry series -/
def serTab (sg : ℚ) (f : ℕ → M3) : List Ser :=
  let ms := (List.range 5).map fun k => (f k).map ((sg ^ k / fact k) * ·)
  (List.range 9).map fun n => ms.map fun m => m.getD n 0

def Hk (k : ℕ) : List Let := List.replicate k .H

/-- the receipt's `curvature_series`: the scalar curvature of `γ = exp(εH)` in the frame, through `ε⁴` -/
def curvS (J : FJet) : Ser :=
  let gam := serTab 1 fun k => wsum J [Hk k]
  let gaminv := serTab (-1) fun k => wsum J [Hk k]
  let dgam := r3.flatMap fun c => serTab 1 fun k => wsum J (wder c (Hk k))
  let ddgam := r3.flatMap fun c => r3.flatMap fun d => serTab 1 fun k => wsum J ((wder d (Hk k)).flatMap (wder c))
  scalarS gam gaminv dgam ddgam

/-- **the `ε⁴` coefficient of `R[exp(εH)]` at a jet** -/
def eps4 (J : Jet) : ℚ := (curvS (toFrame J)).getD 4 0

/-- sanity: the background scalar of the frame metric `δ` is `6` -/
theorem background_six : curvS ⟨m0, [m0, m0, m0], List.replicate 9 m0⟩ = [6, 0, 0, 0, 0] := by decide +kernel

def tr3 (x : M3) : ℚ := x.getD 0 0 + x.getD 4 0 + x.getD 8 0

/-- sanity, against `Row62Jet.frame_constant_closed_form`: at a frame-constant `H` (the first jet's `h`, held
constant) the series is `6, 0, −2p₂, −(10/3)p₃, −(7/12)p₂²` -/
theorem frame_constant_series :
    curvS ⟨[0, -3, 1, -3, 5, -5, 1, -5, -5], [m0, m0, m0], List.replicate 9 m0⟩ =
      [6, 0, -2 * tr3 (mmul [0, -3, 1, -3, 5, -5, 1, -5, -5] [0, -3, 1, -3, 5, -5, 1, -5, -5]),
        -(10/3) * tr3 (mmul (mmul [0, -3, 1, -3, 5, -5, 1, -5, -5] [0, -3, 1, -3, 5, -5, 1, -5, -5])
          [0, -3, 1, -3, 5, -5, 1, -5, -5]),
        -(7/12) * tr3 (mmul [0, -3, 1, -3, 5, -5, 1, -5, -5] [0, -3, 1, -3, 5, -5, 1, -5, -5]) ^ (2:ℕ)] := by
  decide +kernel

